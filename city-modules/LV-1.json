{
  "version": 1,
  "proposalId": "LV-1",
  "title": "VLAD TENEV PORTRAIT",
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>VLAD TENEV // Ceremonial Signal</title>\n<style>\n  :root {\n    --void: #090a08;\n    --black: #11130f;\n    --rust: #a33b22;\n    --rust-dark: #572014;\n    --green: #8cff00;\n    --green-dim: #4e8f16;\n    --bone: #d9d0b8;\n  }\n\n  * { box-sizing: border-box; }\n\n  html, body {\n    min-height: 100%;\n    margin: 0;\n    background:\n      repeating-linear-gradient(0deg, rgba(140,255,0,.025) 0 1px, transparent 1px 5px),\n      radial-gradient(circle at 50% 15%, #24291b 0, var(--void) 48%, #050605 100%);\n    color: var(--bone);\n    font-family: \"Courier New\", Courier, monospace;\n  }\n\n  body {\n    display: grid;\n    place-items: center;\n    padding: clamp(16px, 4vw, 48px);\n    overflow-x: hidden;\n  }\n\n  .module {\n    width: min(100%, 760px);\n    position: relative;\n    padding: clamp(16px, 3vw, 28px);\n    border: 2px solid var(--rust);\n    background: rgba(10, 12, 9, .94);\n    box-shadow: 8px 8px 0 var(--rust-dark), 0 0 34px rgba(140,255,0,.12);\n  }\n\n  .module::before,\n  .module::after {\n    content: \"\";\n    position: absolute;\n    pointer-events: none;\n  }\n\n  .module::before {\n    inset: 7px;\n    border: 1px dashed rgba(140,255,0,.35);\n  }\n\n  .module::after {\n    width: 52px;\n    height: 8px;\n    right: -8px;\n    top: 24px;\n    background: var(--green);\n    box-shadow: -18px 15px 0 var(--rust), 7px 31px 0 var(--green-dim);\n  }\n\n  .eyebrow {\n    margin: 0 0 5px;\n    color: var(--green);\n    font-size: .75rem;\n    letter-spacing: .18em;\n    text-transform: uppercase;\n  }\n\n  h1 {\n    margin: 0;\n    color: var(--bone);\n    font-size: clamp(1.45rem, 6vw, 3.2rem);\n    line-height: .95;\n    text-transform: uppercase;\n    text-shadow: 3px 0 var(--rust), -2px 0 rgba(140,255,0,.6);\n  }\n\n  .subtitle {\n    margin: 10px 0 18px;\n    color: #9ca08f;\n    font-size: clamp(.72rem, 2vw, .9rem);\n  }\n\n  .portrait-trigger {\n    display: block;\n    width: min(100%, 480px);\n    margin: 0 auto;\n    padding: 0;\n    position: relative;\n    border: 2px solid var(--green);\n    background: var(--black);\n    color: inherit;\n    cursor: zoom-in;\n    box-shadow: -7px 7px 0 var(--rust), 0 0 22px rgba(140,255,0,.2);\n    appearance: none;\n  }\n\n  .portrait-trigger:hover {\n    transform: translate(2px, -2px);\n    box-shadow: -9px 9px 0 var(--rust), 0 0 30px rgba(140,255,0,.33);\n  }\n\n  .portrait-trigger:focus-visible,\n  .close:focus-visible {\n    outline: 3px solid var(--bone);\n    outline-offset: 4px;\n  }\n\n  .portrait-trigger svg {\n    display: block;\n    width: 100%;\n    height: auto;\n  }\n\n  .click-strip {\n    display: flex;\n    justify-content: space-between;\n    gap: 12px;\n    padding: 9px 11px;\n    border-top: 2px solid var(--green);\n    color: var(--green);\n    background: #0a0c08;\n    font-size: clamp(.66rem, 2vw, .8rem);\n    font-weight: bold;\n    letter-spacing: .08em;\n    text-transform: uppercase;\n  }\n\n  .status {\n    margin: 18px 0 0;\n    color: #858b78;\n    text-align: center;\n    font-size: .72rem;\n    letter-spacing: .08em;\n  }\n\n  .modal {\n    position: fixed;\n    z-index: 50;\n    inset: 0;\n    display: grid;\n    place-items: center;\n    padding: clamp(12px, 4vw, 40px);\n    background: rgba(2, 3, 2, .94);\n    opacity: 0;\n    visibility: hidden;\n    transition: opacity .16s ease, visibility .16s ease;\n  }\n\n  .modal.open {\n    opacity: 1;\n    visibility: visible;\n  }\n\n  .modal-card {\n    width: min(92vw, 760px);\n    max-height: 92vh;\n    position: relative;\n    border: 2px solid var(--green);\n    background: #090b08;\n    box-shadow: -10px 10px 0 var(--rust), 0 0 60px rgba(140,255,0,.25);\n    transform: scale(.92) rotate(-.35deg);\n    transition: transform .16s ease;\n  }\n\n  .modal.open .modal-card { transform: scale(1) rotate(0); }\n\n  .modal-card svg {\n    display: block;\n    width: 100%;\n    max-height: calc(92vh - 44px);\n  }\n\n  .close {\n    position: absolute;\n    z-index: 3;\n    top: 10px;\n    right: 10px;\n    min-width: 44px;\n    min-height: 44px;\n    border: 2px solid var(--green);\n    background: var(--rust-dark);\n    color: var(--green);\n    font: bold 1.4rem/1 \"Courier New\", monospace;\n    cursor: pointer;\n    box-shadow: 4px 4px 0 #000;\n  }\n\n  .close:hover { background: var(--rust); color: #fff; }\n\n  .modal-label {\n    position: absolute;\n    left: 10px;\n    bottom: 10px;\n    padding: 6px 9px;\n    background: #070807;\n    border: 1px solid var(--rust);\n    color: var(--green);\n    font-size: clamp(.65rem, 2vw, .82rem);\n    letter-spacing: .1em;\n  }\n\n  .glitch-a { animation: shiftA 2.6s steps(1) infinite; }\n  .glitch-b { animation: shiftB 3.4s steps(1) infinite; }\n  .signal { animation: pulse 1.8s ease-in-out infinite; }\n\n  @keyframes shiftA {\n    0%, 91%, 100% { transform: translate(0); opacity: .7; }\n    92% { transform: translate(10px, -2px); opacity: 1; }\n    95% { transform: translate(-7px, 2px); }\n  }\n\n  @keyframes shiftB {\n    0%, 86%, 100% { transform: translate(0); }\n    88% { transform: translate(-13px, 0); }\n    90% { transform: translate(8px, 3px); }\n  }\n\n  @keyframes pulse {\n    50% { opacity: .35; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    *, *::before, *::after { animation: none !important; transition: none !important; }\n  }\n</style>\n</head>\n<body>\n<main class=\"module\" aria-labelledby=\"title\">\n  <p class=\"eyebrow\">Landville Civic Relic // Signal 01</p>\n  <h1 id=\"title\">Vlad Tenev Portrait</h1>\n  <p class=\"subtitle\">GLITCHY CEREMONIAL NONSENSE, locally rendered in the town void.</p>\n\n  <button class=\"portrait-trigger\" id=\"portraitButton\" type=\"button\" aria-label=\"Open enlarged stylized portrait of Vlad Tenev\" aria-haspopup=\"dialog\">\n    <svg viewBox=\"0 0 600 680\" role=\"img\" aria-labelledby=\"portraitTitle portraitDesc\">\n      <title id=\"portraitTitle\">Stylized glitch portrait of Vlad Tenev</title>\n      <desc id=\"portraitDesc\">A graphic ceremonial bust with dark hair, a suit, neon green accents, rust-colored halos, and digital glitch marks.</desc>\n      <rect width=\"600\" height=\"680\" fill=\"#090b08\"/>\n      <path d=\"M0 90H600M0 170H600M0 250H600M0 330H600M0 410H600M0 490H600M0 570H600\" stroke=\"#8cff00\" stroke-opacity=\".08\"/>\n      <path d=\"M60 0V680M140 0V680M220 0V680M300 0V680M380 0V680M460 0V680M540 0V680\" stroke=\"#a33b22\" stroke-opacity=\".09\"/>\n\n      <circle cx=\"300\" cy=\"269\" r=\"218\" fill=\"none\" stroke=\"#572014\" stroke-width=\"34\"/>\n      <circle cx=\"300\" cy=\"269\" r=\"186\" fill=\"none\" stroke=\"#8cff00\" stroke-width=\"3\" stroke-dasharray=\"9 15\" class=\"signal\"/>\n      <path d=\"M300 22l18 40-18 39-18-39zM548 269l-40 18-39-18 39-18zM300 516l-18-40 18-39 18 39zM52 269l40-18 39 18-39 18z\" fill=\"#8cff00\"/>\n      <path d=\"M113 113l52 16-36 37zM487 113l-16 52-37-36zM487 425l-52-16 36-37zM113 425l16-52 37 36z\" fill=\"#a33b22\"/>\n\n      <g class=\"glitch-a\" opacity=\".65\">\n        <path d=\"M183 213c4-96 61-145 123-145 85 0 130 66 124 151l-31 50-197-8z\" fill=\"#8cff00\"/>\n        <path d=\"M173 302h113v13H173zM337 171h132v11H337zM138 366h168v9H138z\" fill=\"#8cff00\"/>\n      </g>\n\n      <path d=\"M171 618c13-104 58-159 129-159s118 55 131 159l-43 62H212z\" fill=\"#171a14\" stroke=\"#8cff00\" stroke-width=\"4\"/>\n      <path d=\"M244 476l56 70 57-70 39 35-37 169H239l-36-169z\" fill=\"#20251b\"/>\n      <path d=\"M277 535l23 11 24-11 18 145h-84z\" fill=\"#a33b22\"/>\n      <path d=\"M300 546v134\" stroke=\"#8cff00\" stroke-width=\"3\"/>\n\n      <path d=\"M207 230c0-92 38-147 99-147 66 0 99 57 94 149l-8 132c-5 76-47 119-92 119-49 0-90-47-94-119z\" fill=\"#c9b99d\" stroke=\"#11130f\" stroke-width=\"7\"/>\n      <path d=\"M203 246c-7-109 40-181 108-181 67 0 105 58 94 176l-26-80-31 18-46-51-35 42-43 9z\" fill=\"#11130f\"/>\n      <path d=\"M212 163c18-90 111-121 169-49l27 55-65-37-74 13-39 67z\" fill=\"#171a14\"/>\n      <path d=\"M230 274q35-25 66 0M319 274q34-25 67 0\" fill=\"none\" stroke=\"#171a14\" stroke-width=\"10\"/>\n      <path d=\"M253 283h18M343 283h18\" stroke=\"#8cff00\" stroke-width=\"7\"/>\n      <path d=\"M305 285l-12 71 31 4\" fill=\"none\" stroke=\"#6f6251\" stroke-width=\"6\"/>\n      <path d=\"M263 401q39 27 79 0\" fill=\"none\" stroke=\"#572014\" stroke-width=\"8\"/>\n      <path d=\"M266 417q35 19 69 0\" fill=\"none\" stroke=\"#8a7760\" stroke-width=\"3\"/>\n      <path d=\"M205 303l-22-22 7 95 25 31M396 303l21-22-7 95-25 31\" fill=\"#b29f83\" stroke=\"#11130f\" stroke-width=\"6\"/>\n\n      <g class=\"glitch-b\">\n        <rect x=\"148\" y=\"322\" width=\"122\" height=\"14\" fill=\"#a33b22\" opacity=\".9\"/>\n        <rect x=\"353\" y=\"342\" width=\"103\" height=\"11\" fill=\"#8cff00\" opacity=\".8\"/>\n        <rect x=\"197\" y=\"377\" width=\"61\" height=\"8\" fill=\"#8cff00\"/>\n        <rect x=\"324\" y=\"222\" width=\"119\" height=\"7\" fill=\"#a33b22\"/>\n      </g>\n\n      <path d=\"M39 41h101v7H46v92h-7zM561 41H460v7h94v92h7zM39 639h101v-7H46v-92h-7zM561 639H460v-7h94v-92h7z\" fill=\"#8cff00\"/>\n      <text x=\"54\" y=\"654\" fill=\"#8cff00\" font-family=\"monospace\" font-size=\"17\">TENEV // CEREMONIAL_FEED</text>\n      <text x=\"425\" y=\"68\" fill=\"#a33b22\" font-family=\"monospace\" font-size=\"15\">LV-01</text>\n    </svg>\n    <span class=\"click-strip\"><span>Click to enlarge</span><span aria-hidden=\"true\">[ + ]</span></span>\n  </button>\n\n  <p class=\"status\">NO NETWORK // NO ALTAR TAX // PORTRAIT SIGNAL STABLE</p>\n</main>\n\n<div class=\"modal\" id=\"portraitModal\" role=\"dialog\" aria-modal=\"true\" aria-label=\"Enlarged Vlad Tenev portrait\" aria-hidden=\"true\">\n  <div class=\"modal-card\">\n    <button class=\"close\" id=\"closeButton\" type=\"button\" aria-label=\"Close enlarged portrait\">×</button>\n    <svg viewBox=\"0 0 600 680\" role=\"img\" aria-label=\"Enlarged stylized glitch portrait of Vlad Tenev\">\n      <rect width=\"600\" height=\"680\" fill=\"#090b08\"/>\n      <path d=\"M0 90H600M0 170H600M0 250H600M0 330H600M0 410H600M0 490H600M0 570H600\" stroke=\"#8cff00\" stroke-opacity=\".08\"/>\n      <circle cx=\"300\" cy=\"269\" r=\"218\" fill=\"none\" stroke=\"#572014\" stroke-width=\"34\"/>\n      <circle cx=\"300\" cy=\"269\" r=\"186\" fill=\"none\" stroke=\"#8cff00\" stroke-width=\"3\" stroke-dasharray=\"9 15\" class=\"signal\"/>\n      <path d=\"M300 22l18 40-18 39-18-39zM548 269l-40 18-39-18 39-18zM300 516l-18-40 18-39 18 39zM52 269l40-18 39 18-39 18z\" fill=\"#8cff00\"/>\n      <g class=\"glitch-a\" opacity=\".65\"><path d=\"M183 213c4-96 61-145 123-145 85 0 130 66 124 151l-31 50-197-8z\" fill=\"#8cff00\"/><path d=\"M173 302h113v13H173zM337 171h132v11H337zM138 366h168v9H138z\" fill=\"#8cff00\"/></g>\n      <path d=\"M171 618c13-104 58-159 129-159s118 55 131 159l-43 62H212z\" fill=\"#171a14\" stroke=\"#8cff00\" stroke-width=\"4\"/>\n      <path d=\"M244 476l56 70 57-70 39 35-37 169H239l-36-169z\" fill=\"#20251b\"/>\n      <path d=\"M277 535l23 11 24-11 18 145h-84z\" fill=\"#a33b22\"/><path d=\"M300 546v134\" stroke=\"#8cff00\" stroke-width=\"3\"/>\n      <path d=\"M207 230c0-92 38-147 99-147 66 0 99 57 94 149l-8 132c-5 76-47 119-92 119-49 0-90-47-94-119z\" fill=\"#c9b99d\" stroke=\"#11130f\" stroke-width=\"7\"/>\n      <path d=\"M203 246c-7-109 40-181 108-181 67 0 105 58 94 176l-26-80-31 18-46-51-35 42-43 9z\" fill=\"#11130f\"/><path d=\"M212 163c18-90 111-121 169-49l27 55-65-37-74 13-39 67z\" fill=\"#171a14\"/>\n      <path d=\"M230 274q35-25 66 0M319 274q34-25 67 0\" fill=\"none\" stroke=\"#171a14\" stroke-width=\"10\"/><path d=\"M253 283h18M343 283h18\" stroke=\"#8cff00\" stroke-width=\"7\"/>\n      <path d=\"M305 285l-12 71 31 4\" fill=\"none\" stroke=\"#6f6251\" stroke-width=\"6\"/><path d=\"M263 401q39 27 79 0\" fill=\"none\" stroke=\"#572014\" stroke-width=\"8\"/><path d=\"M266 417q35 19 69 0\" fill=\"none\" stroke=\"#8a7760\" stroke-width=\"3\"/>\n      <path d=\"M205 303l-22-22 7 95 25 31M396 303l21-22-7 95-25 31\" fill=\"#b29f83\" stroke=\"#11130f\" stroke-width=\"6\"/>\n      <g class=\"glitch-b\"><rect x=\"148\" y=\"322\" width=\"122\" height=\"14\" fill=\"#a33b22\"/><rect x=\"353\" y=\"342\" width=\"103\" height=\"11\" fill=\"#8cff00\"/><rect x=\"197\" y=\"377\" width=\"61\" height=\"8\" fill=\"#8cff00\"/><rect x=\"324\" y=\"222\" width=\"119\" height=\"7\" fill=\"#a33b22\"/></g>\n      <path d=\"M39 41h101v7H46v92h-7zM561 41H460v7h94v92h7zM39 639h101v-7H46v-92h-7zM561 639H460v-7h94v-92h7z\" fill=\"#8cff00\"/>\n      <text x=\"54\" y=\"654\" fill=\"#8cff00\" font-family=\"monospace\" font-size=\"17\">TENEV // CEREMONIAL_FEED</text>\n    </svg>\n    <div class=\"modal-label\">ENLARGED RELIC // ESC TO DISMISS</div>\n  </div>\n</div>\n\n<script>\n(function () {\n  \"use strict\";\n  const trigger = document.getElementById(\"portraitButton\");\n  const modal = document.getElementById(\"portraitModal\");\n  const closeButton = document.getElementById(\"closeButton\");\n\n  function openPortrait() {\n    modal.classList.add(\"open\");\n    modal.setAttribute(\"aria-hidden\", \"false\");\n    document.body.style.overflow = \"hidden\";\n    closeButton.focus();\n  }\n\n  function closePortrait() {\n    modal.classList.remove(\"open\");\n    modal.setAttribute(\"aria-hidden\", \"true\");\n    document.body.style.overflow = \"\";\n    trigger.focus();\n  }\n\n  trigger.addEventListener(\"click\", openPortrait);\n  closeButton.addEventListener(\"click\", closePortrait);\n\n  modal.addEventListener(\"click\", function (event) {\n    if (event.target === modal) closePortrait();\n  });\n\n  document.addEventListener(\"keydown\", function (event) {\n    if (!modal.classList.contains(\"open\")) return;\n    if (event.key === \"Escape\") closePortrait();\n    if (event.key === \"Tab\") {\n      event.preventDefault();\n      closeButton.focus();\n    }\n  });\n}());\n</script>\n</body>\n</html>",
  "acceptance": [
    "A LANDVILLE-style glitchy portrait of Vlad Tenev is clearly visible.",
    "Clicking the portrait opens a larger view.",
    "The enlarged portrait can be closed and returns to its initial state.",
    "The module works on desktop and mobile without external APIs or links."
  ]
}

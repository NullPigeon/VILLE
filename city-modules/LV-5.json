.lastFocus=null;focusNode(target)}\nfunction clearDraft(){ui.headline.value='';ui.details.value='';updateComposer()}\nasync function savePrivate(next){await storage({operation:'private.set',collection:'citizen_board_state',data:next})}\nasync function findCreatedIdea(headline,createdAt){var raw=await storage({operation:'shared.list',collection:'panic_ideas',limit:50});var list=extractList(raw);if(list===null)return null;for(var i=0;i<list.length;i++){var idea=normalizeIdea(list[i]);if(idea&&idea.headline===headline&&idea.createdAt===createdAt)return idea}return null}\nasync function submitIdea(){if(state.saving)return;var headline=ui.headline.value.trim(),details=ui.details.value.trim();if(!headline){ui.composerError.textContent='A headline is required.';return}if(headline.length>MAX_HEADLINE||details.length>MAX_DETAILS){ui.composerError.textContent='The note exceeds the posted character limits.';return}state.saving=true;ui.composerError.textContent='';updateComposer();renderStatus();var createdAt=new Date().toISOString();var data={headline:headline,details:details,dayKey:dayKey(new Date()),createdAt:createdAt,schemaVersion:1};try{var response=await storage({operation:'shared.create',collection:'panic_ideas',data:data});var idea=normalizedCreatedIdea(response);if(!idea)idea=await findCreatedIdea(headline,createdAt);if(!idea)throw new Error('The public write may have completed, but LANDVILLE returned no readable server-issued record ID. Reload the board before posting again.');state.ideas=state.ideas.filter(function(item){return item.id!==idea.id});state.ideas.unshift(idea);var next={reactionLedgerId:state.privateState.reactionLedgerId,choices:Object.assign({},state.privateState.choices),authoredIdeaIds:[idea.id].concat(state.privateState.authoredIdeaIds.filter(function(id){return id!==idea.id})).slice(0,50),schemaVersion:1,updatedAt:new Date().toISOString()};state.privateState=next;var privateWarning='';try{await savePrivate(next)}catch(error){privateWarning=' The p
{
  "version": 1,
  "proposalId": "LV-5",
  "title": "Town Hall Panic Board",
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Town Hall Panic Board</title>\n<style>\n:root{--void:#080907;--paper:#d5bd8d;--acid:#c7ff00;--rust:#c85f31;--metal:#6c5b39;--ink:#11130d;--muted:#9c8964;--danger:#f08a63;--line:rgba(213,189,141,.28)}\n*{box-sizing:border-box}\nhtml{background:var(--void);color:var(--paper);font-family:Arial,Helvetica,sans-serif}\nbody{margin:0;min-height:100vh;background:radial-gradient(circle at 78% 8%,rgba(199,255,0,.07),transparent 24%),linear-gradient(135deg,#080907,#10120c 55%,#080907);overflow-x:hidden}\nbody:before{content:\"\";position:fixed;inset:0;pointer-events:none;opacity:.055;background-image:url(\"data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.82' numOctaves='3'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E\")}\nbutton,textarea{font:inherit}\nbutton{cursor:pointer}\nbutton:disabled,textarea:disabled{cursor:not-allowed;opacity:.5}\nbutton:focus-visible,textarea:focus-visible{outline:3px solid var(--acid);outline-offset:3px}\n.shell{width:min(1180px,calc(100% - 28px));margin:auto;padding:16px 0 42px}\n.mast{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:18px;align-items:end;margin-bottom:11px;padding:10px 14px 12px;border:1px solid var(--line);border-left:5px solid var(--acid);background:#10120d;box-shadow:7px 7px #030402;transform:rotate(-.25deg)}\n.kicker,.machine-label,.scope,.status-line,.date-label,.composer-label,.author-line,.score-line,.note-error,.empty-copy,.limit-copy,.sync-warning{font-family:ui-monospace,SFMono-Regular,Consolas,monospace}\n.kicker{margin:0 0 4px;color:var(--acid);font-size:10px;font-weight:900;letter-spacing:1.8px}\nh1{margin:0;color:#e4cc98;font-family:Impact,Haettenschweiler,\"Arial Narrow Bold\",sans-serif;font-size:clamp(42px,6.4vw,72px);font-weight:950;line-height:.82;letter-spacing:-2px;text-transform:uppercase}\nh1 span{color:var(--acid)}\n.status-line{max-width:270px;margin:0;padding:9px 10px;border:1px solid #53642c;color:var(--acid);background:#0a0c08;font-size:9px;font-weight:800;line-height:1.45;text-align:right}\n.status-line:before{content:\"\";display:inline-block;width:7px;height:7px;margin-right:7px;border-radius:50%;background:currentColor;box-shadow:0 0 10px currentColor}\n.controls{display:flex;align-items:stretch;justify-content:space-between;gap:10px;margin:0 0 11px}\n.tabs{display:flex;gap:7px;flex-wrap:wrap}\n.tab,.retry,.submit,.reaction,.sync-button{min-height:44px;border:1px solid #59682d;border-radius:0;background:#10120d;color:var(--acid);padding:0 13px;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:10px;font-weight:900;letter-spacing:.35px;box-shadow:3px 3px #030402}\n.tab[aria-pressed=\"true\"],.submit{background:var(--acid);color:var(--ink);box-shadow:4px 4px #435800}\n.date-label{display:flex;align-items:center;padding:8px 11px;border:1px dashed #665839;color:#bda87d;background:#0c0d09;font-size:9px}\n.layout{display:grid;grid-template-columns:minmax(0,1.38fr) minmax(260px,.62fr);gap:16px;align-items:start}\n.board-wrap{position:relative;border:2px solid #765b34;background:#21170f;box-shadow:11px 11px #030402,15px 15px #16120b;transform:rotate(.2deg)}\n.board-wrap:before,.board-wrap:after{content:\"\";position:absolute;z-index:4;width:12px;height:12px;border:2px solid #25180f;border-radius:50%;background:#a46b38;box-shadow:inset 2px 2px #d19a58,2px 2px #080907}\n.board-wrap:before{left:9px;top:9px}.board-wrap:after{right:9px;bottom:9px}\n.board-head{min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 18px 11px;border-bottom:2px solid #7b5a34;background:linear-gradient(90deg,#24271a,#11130d 55%,#25160f);box-shadow:inset 0 -5px #0a0b08}\n.scrap-title{position:relative;padding:8px 13px 7px;border:1px solid #9fc92c;background:var(--acid);color:#11130d;font-family:Impact,Haettenschweiler,\"Arial Narrow Bold\",sans-serif;font-size:24px;letter-spacing:.8px;line-height:1;transform:rotate(-1.4deg);box-shadow:4px 4px #071000}\n.scrap-title:after{content:\"\";position:absolute;right:-8px;top:6px;width:14px;height:5px;background:var(--rust);transform:rotate(8deg)}\n.board-scope{display:flex;align-items:center;justify-content:flex-end;gap:11px;min-width:0}\n.scope{max-width:245px;color:#bea77a;font-size:8px;line-height:1.45;text-align:right}\n.mini-gauge{position:relative;flex:0 0 55px;width:55px;height:31px;overflow:hidden;border:1px solid #756039;border-bottom:4px solid #292317;background:radial-gradient(circle at 50% 100%,#d5bd8d 0 9%,#171910 10% 58%,#090a07 59%);box-shadow:3px 3px #050603}\n.mini-gauge:before{content:\"\";position:absolute;left:8px;right:8px;bottom:4px;height:20px;border-top:1px dashed #728833;border-radius:100% 100% 0 0}\n.mini-gauge i{position:absolute;left:50%;bottom:3px;width:22px;height:2px;background:var(--rust);transform:rotate(-27deg);transform-origin:0 50%}\n.board{min-height:440px;padding:20px;background-color:#3b2818;background-image:linear-gradient(45deg,rgba(255,255,255,.025) 25%,transparent 25%,transparent 75%,rgba(255,255,255,.025) 75%),radial-gradient(circle at 15% 30%,rgba(0,0,0,.19),transparent 20%),radial-gradient(circle at 82% 68%,rgba(199,255,0,.035),transparent 22%);background-size:8px 8px,100% 100%,100% 100%}\n.note-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 14px;align-items:start}\n.note{--note-bg:#d4bd8d;--note-ink:#17130e;position:relative;min-width:0;border:1px solid rgba(18,17,12,.72);background:var(--note-bg);color:var(--note-ink);box-shadow:6px 7px #16110a;clip-path:polygon(0 2%,98% 0,100% 96%,3% 100%)}\n.note:nth-child(4n+1){--note-bg:#c7ff00;transform:rotate(-1.2deg)}\n.note:nth-child(4n+2){--note-bg:#e07b3e;transform:rotate(1.1deg)}\n.note:nth-child(4n+3){--note-bg:#d5bd8d;transform:rotate(.55deg)}\n.note:nth-child(4n+4){--note-bg:#202616;--note-ink:#d8c18e;border-color:#748932;transform:rotate(-.8deg)}\n.note:first-child{grid-column:span 2}\n.pin{position:absolute;z-index:3;left:50%;top:-7px;width:17px;height:17px;border:2px solid #45210f;border-radius:50%;background:var(--rust);box-shadow:inset 3px 3px #ee996c,2px 4px rgba(0,0,0,.5);transform:translateX(-50%)}\n.rank{position:absolute;z-index:2;left:8px;top:8px;min-width:31px;padding:5px 6px;background:#11130d;color:var(--acid);font:900 9px ui-monospace,SFMono-Regular,Consolas,monospace;transform:rotate(-3deg);text-align:center}\n.note-open{width:100%;min-height:92px;padding:31px 13px 8px;border:0;background:transparent;color:inherit;text-align:left}\n.note-open:focus-visible,.reaction:focus-visible{outline:0;box-shadow:inset 0 0 0 3px var(--acid)}\n.idea-text{display:-webkit-box;overflow:hidden;margin:0;font-family:Impact,Haettenschweiler,\"Arial Narrow Bold\",sans-serif;font-size:clamp(18px,2.7vw,27px);font-weight:900;line-height:1.02;letter-spacing:.1px;-webkit-box-orient:vertical;-webkit-line-clamp:3;overflow-wrap:anywhere}\n.note.expanded .idea-text{display:block}\n.expand-hint{display:block;margin-top:7px;font:800 8px ui-monospace,SFMono-Regular,Consolas,monospace;opacity:.68}\n.note-meta{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:7px;padding:8px 12px;border-top:1px dashed rgba(17,19,13,.45);font:800 8px ui-monospace,SFMono-Regular,Consolas,monospace}\n.author-line{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}\n.score-line{display:flex;gap:9px;justify-content:space-between;padding:8px 12px 0;font-size:9px;font-weight:900}\n.score-line strong{font-size:12px}\n.reaction-row{display:grid;grid-template-columns:1fr 1fr;gap:6px;padding:8px 10px 10px}\n.reaction{min-height:44px;padding:0 8px;border-color:rgba(17,19,13,.62);background:rgba(17,19,13,.88);color:var(--acid);box-shadow:none}\n.reaction.dislike{color:#ff9b74}\n.reaction[aria-pressed=\"true\"]{background:var(--acid);color:#101108}\n.reaction.dislike[aria-pressed=\"true\"]{background:var(--rust);color:#100b08}\n.note-error{margin:0 10px 9px;padding:7px;border:1px solid #7e311d;background:#27120c;color:#ffd0bd;font-size:8px;line-height:1.4}\n.sync-button{width:calc(100% - 20px);margin:0 10px 10px;border-color:#4d281d;color:#241007;background:#f09a70;box-shadow:none}\n.board-state{grid-column:1/-1;min-height:300px;display:grid;place-items:center;padding:28px;border:1px dashed #896d40;background:rgba(12,12,8,.45);text-align:center}\n.board-state .paper{max-width:440px;padding:24px;background:var(--paper);color:#16130e;box-shadow:7px 7px #100c08;transform:rotate(-1deg);clip-path:polygon(2% 0,100% 3%,97% 100%,0 96%)}\n.board-state strong{display:block;font-family:Impact,Haettenschweiler,\"Arial Narrow Bold\",sans-serif;font-size:29px;line-height:.95}\n.empty-copy{margin:11px 0 0;font-size:10px;line-height:1.5}\n.loading-note{min-height:126px;display:grid;place-items:center;padding:16px;text-align:center}\n.loading-note b{font:900 10px ui-monospace,SFMono-Regular,Consolas,monospace;letter-spacing:1.5px}\n.vacant-board{position:relative;grid-column:1/-1;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px 14px;min-height:335px;padding:5px}\n.vacant-note{position:relative;min-height:118px;display:grid;place-items:center;padding:28px 12px 12px;border:1px solid #332618;background:#d5bd8d;color:#21170f;box-shadow:6px 7px #16110a;clip-path:polygon(1% 3%,98% 0,100% 96%,3% 100%);transform:rotate(-1deg);text-align:center}\n.vacant-note:nth-child(2){background:var(--acid);transform:rotate(1.2deg)}\n.vacant-note:nth-child(3){background:#e07b3e;transform:rotate(-.4deg)}\n.vacant-note:nth-child(4){background:#202616;color:#d8c18e;border-color:#748932;transform:rotate(.9deg)}\n.vacant-note:nth-child(5){background:#d5bd8d;transform:rotate(-1.3deg)}\n.vacant-note:first-child{grid-column:span 2}\n.vacant-note small{position:absolute;left:9px;top:9px;padding:4px 5px;background:#11130d;color:var(--acid);font:900 8px ui-monospace,SFMono-Regular,Consolas,monospace}\n.vacant-note b{font-family:Impact,Haettenschweiler,\"Arial Narrow Bold\",sans-serif;font-size:19px;letter-spacing:.4px}\n.vacant-notice{position:absolute;z-index:5;left:50%;top:50%;width:min(280px,78%);padding:11px;border:2px solid var(--rust);background:#11130ded;color:#e8895f;font:950 10px/1.35 ui-monospace,SFMono-Regular,Consolas,monospace;transform:translate(-50%,-50%) rotate(-2deg);box-shadow:5px 5px #070805}\n.side{display:grid;gap:14px}\n.machine{border:1px solid #665534;background:#10120d;box-shadow:7px 7px #030402}\n.machine-head{display:flex;align-items:center;justify-content:space-between;gap:10px;min-height:43px;padding:9px 12px;border-bottom:1px solid #4a4028;background:#171910}\n.machine-head h2{margin:0;font-size:13px;letter-spacing:.3px}\n.machine-label{color:var(--acid);font-size:8px}\n.composer{padding:13px}\n.composer-label{display:flex;justify-content:space-between;gap:10px;margin-bottom:7px;color:#af9b72;font-size:9px;font-weight:800}\ntextarea{width:100%;min-height:112px;resize:vertical;border:1px solid #74613b;border-radius:0;background:#d3bd8e;color:#15120e;padding:12px;font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:13px;line-height:1.45;box-shadow:inset 4px 4px rgba(36,24,13,.16)}\ntextarea::placeholder{color:#66563c}\n.composer-actions{display:grid;grid-template-columns:1fr auto;gap:8px;align-items:stretch;margin-top:9px}\n.submit{padding:0 15px}\n.limit-copy{display:flex;align-items:center;color:#8d7a59;font-size:8px;line-height:1.35}\n.composer-message,.sync-warning{margin:10px 0 0;padding:8px;border-left:2px solid var(--acid);background:#171a10;color:#c7b384;font-size:9px;line-height:1.45}\n.composer-message.error,.sync-warning{border-color:var(--danger);color:#f1a181;background:#24130e}\n.gauge-box{padding:13px}\n.gauge{position:relative;width:180px;height:104px;margin:3px auto 9px;overflow:hidden;border:2px solid #725a34;border-bottom:8px solid #292317;background:radial-gradient(circle at 50% 96%,#d5bd8d 0 8%,#191a12 9% 52%,#090a07 53%);box-shadow:inset 0 0 22px #000,4px 4px #030402}\n.gauge:before{content:\"LOW   CIVIC PRESSURE   HIGH\";position:absolute;left:0;right:0;top:13px;color:#bfa979;font:800 7px ui-monospace,SFMono-Regular,Consolas,monospace;text-align:center;letter-spacing:.5px}\n.ticks{position:absolute;left:27px;right:27px;bottom:13px;height:66px;border-top:2px dashed #66752e;border-radius:100% 100% 0 0}\n.needle{position:absolute;z-index:2;left:50%;bottom:6px;width:65px;height:3px;background:var(--rust);transform-origin:0 50%;transform:rotate(-42deg);box-shadow:0 0 7px rgba(240,120,64,.6)}\n.needle:after{content:\"\";position:absolute;left:-7px;top:-6px;width:14px;height:14px;border-radius:50%;background:var(--acid);box-shadow:0 0 10px rgba(199,255,0,.5)}\n.gauge.twitch .needle{animation:needle-twitch .62s cubic-bezier(.2,.8,.2,1)}\n.stamp{display:none;margin:0;padding:8px 9px;border:2px solid var(--rust);color:#e37a4b;font:950 9px ui-monospace,SFMono-Regular,Consolas,monospace;line-height:1.35;text-align:center;transform:rotate(-1.3deg)}\n.stamp.visible{display:block}\n.legend{padding:11px 13px 13px;border-top:1px solid var(--line);color:#a79269;font:9px/1.5 ui-monospace,SFMono-Regular,Consolas,monospace}\n.legend b{color:var(--acid)}\n.live-region{position:fixed;left:-9999px;width:1px;height:1px;overflow:hidden}\n@keyframes needle-twitch{0%{transform:rotate(-42deg)}28%{transform:rotate(34deg)}52%{transform:rotate(-7deg)}76%{transform:rotate(18deg)}100%{transform:rotate(-42deg)}}\n@media(max-width:820px){.layout{grid-template-columns:1fr}.side{grid-template-columns:1fr 1fr}.machine.composer-machine{grid-column:1/-1}.mast{align-items:center}.status-line{max-width:220px}}\n@media(max-width:560px){.shell{width:min(100% - 18px,1180px);padding-top:10px}.mast{grid-template-columns:1fr;gap:10px}.status-line{max-width:none;text-align:left}.controls{display:grid}.date-label{min-height:40px}.board-head{align-items:flex-start}.board-scope{gap:7px}.scope{max-width:128px}.mini-gauge{flex-basis:45px;width:45px}.board{padding:15px 11px}.note-grid{grid-template-columns:1fr}.note:first-child{grid-column:auto}.side{grid-template-columns:1fr}.composer-machine{grid-column:auto}.idea-text{font-size:23px}.scrap-title{font-size:20px}.vacant-board{grid-template-columns:1fr}.vacant-note:first-child{grid-column:auto}.vacant-note{min-height:92px}.vacant-notice{position:sticky;bottom:10px;grid-column:1;transform:rotate(-2deg);margin:-88px auto 5px}}\n@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}.gauge.twitch .needle{animation:none}}\n</style>\n</head>\n<body>\n<main class=\"shell\">\n  <header class=\"mast\">\n    <div>\n      <p class=\"kicker\">TOWN HALL / PUBLIC NOVELTY INTAKE</p>\n      <h1>PANIC <span>BOARD</span></h1>\n    </div>\n    <p class=\"status-line\" id=\"statusLine\" aria-live=\"polite\">CONNECTING TO PUBLIC BOARD…</p>\n  </header>\n\n  <div class=\"controls\" aria-label=\"Board views\">\n    <div class=\"tabs\">\n      <button class=\"tab\" id=\"topTab\" type=\"button\" aria-pressed=\"true\">TOP 5</button>\n      <button class=\"tab\" id=\"todayTab\" type=\"button\" aria-pressed=\"false\">TODAY'S BOARD</button>\n    </div>\n    <div class=\"date-label\" id=\"dateLabel\">UTC DAY —</div>\n  </div>\n\n  <div class=\"layout\">\n    <section class=\"board-wrap\" aria-labelledby=\"boardTitle\">\n      <header class=\"board-head\">\n        <div class=\"scrap-title\" id=\"boardTitle\" tabindex=\"-1\">TOP 5</div>\n        <div class=\"board-scope\">\n          <div class=\"scope\" id=\"scopeLine\">TOP 5 / LOADED UTC BOARD</div>\n          <div class=\"mini-gauge\" aria-hidden=\"true\"><i></i></div>\n        </div>\n      </header>\n      <div class=\"board\">\n        <div class=\"note-grid\" id=\"noteGrid\" aria-busy=\"true\"></div>\n      </div>\n    </section>\n\n    <aside class=\"side\">\n      <section class=\"machine composer-machine\">\n        <header class=\"machine-head\"><h2>FILE AN ABSURDITY</h2><span class=\"machine-label\">PUBLIC / 240 MAX</span></header>\n        <div class=\"composer\">\n          <label class=\"composer-label\" for=\"ideaInput\"><span>IDEA TEXT</span><span id=\"charCount\">0 / 240</span></label>\n          <textarea id=\"ideaInput\" maxlength=\"240\" placeholder=\"Example: replace the town clock with a suspiciously punctual goose.\" disabled></textarea>\n          <div class=\"composer-actions\">\n            <span class=\"limit-copy\" id=\"writeAccess\">CHECKING CITIZEN ACCESS…</span>\n            <button class=\"submit\" id=\"submitIdea\" type=\"button\" disabled>PIN TO BOARD</button>\n          </div>\n          <p class=\"composer-message\" id=\"composerMessage\" role=\"status\" aria-live=\"polite\" hidden></p>\n        </div>\n      </section>\n\n      <section class=\"machine\">\n        <header class=\"machine-head\"><h2>PRESSURE GAUGE</h2><span class=\"machine-label\">REACTION WRITE</span></header>\n        <div class=\"gauge-box\">\n          <div class=\"gauge\" id=\"gauge\" aria-hidden=\"true\"><div class=\"ticks\"></div><div class=\"needle\"></div></div>\n          <p class=\"stamp\" id=\"stamp\">CIVIC PRESSURE RECALIBRATED. PROBABLY.</p>\n        </div>\n        <div class=\"legend\"><b>RANKING:</b> NET SCORE, THEN TOTAL REACTIONS, THEN EARLIEST POST, THEN RECORD ID. MAXIMUM 50 LOADED IDEAS AND 50 LOADED REACTIONS.</div>\n      </section>\n\n      <section class=\"machine\" id=\"syncPanel\" hidden>\n        <header class=\"machine-head\"><h2>PRIVATE STATE NEEDS ATTENTION</h2><span class=\"machine-label\">REACTIONS LOCKED</span></header>\n        <div class=\"composer\">\n          <p class=\"sync-warning\" id=\"syncWarning\"></p>\n          <button class=\"retry\" id=\"retryPrivate\" type=\"button\">RETRY CITIZEN STATE</button>\n        </div>\n      </section>\n    </aside>\n  </div>\n  <div class=\"live-region\" id=\"liveRegion\" aria-live=\"polite\" aria-atomic=\"true\"></div>\n</main>\n<script>\n(function(){\n  \"use strict\";\n\n  const state={\n    loading:true,view:\"top\",ideas:[],reactions:[],privateMap:{},expanded:new Set(),\n    ideasError:\"\",reactionsError:\"\",privateIssue:\"\",privateIssueKind:\"\",auth:\"checking\",\n    submitting:false,reactionBusy:new Set(),noteErrors:{},dirtyPrivate:new Set(),\n    dayKey:\"\",reconciling:false,loadRun:0\n  };\n\n  const pending=new Map();\n  let sequence=0;\n  let gaugeTimer=0;\n  const byId=(id)=>document.getElementById(id);\n  const noteGrid=byId(\"noteGrid\");\n  const input=byId(\"ideaInput\");\n  const submit=byId(\"submitIdea\");\n  const live=byId(\"liveRegion\");\n\n  function requestStorage(inputData){\n    return new Promise((resolve,reject)=>{\n      const requestId=\"panic_\"+Date.now().toString(36)+\"_\"+(++sequence).toString(36);\n      const timer=setTimeout(()=>{pending.delete(requestId);reject(new Error(\"LANDVILLE storage timed out. Retry the board.\"));},12000);\n      pending.set(requestId,{resolve,reject,timer});\n      window.parent.postMessage({type:\"landville:capability-request\",requestId:requestId,capability:\"module.storage\",input:inputData},\"*\");\n    });\n  }\n\n  const storageApi={\n    listIdeas:()=>requestStorage({operation:\"shared.list\",collection:\"panic_ideas\",limit:50}),\n    createIdea:(data)=>requestStorage({operation:\"shared.create\",collection:\"panic_ideas\",data:data}),\n    listReactions:()=>requestStorage({operation:\"shared.list\",collection:\"panic_reactions\",limit:50}),\n    createReaction:(data)=>requestStorage({operation:\"shared.create\",collection:\"panic_reactions\",data:data}),\n    updateReaction:(id,data)=>requestStorage({operation:\"shared.update\",collection:\"panic_reactions\",id:id,data:data}),\n    deleteReaction:(id)=>requestStorage({operation:\"shared.delete\",collection:\"panic_reactions\",id:id}),\n    getPrivate:()=>requestStorage({operation:\"private.get\",collection:\"panic_state\"}),\n    setPrivate:(data)=>requestStorage({operation:\"private.set\",collection:\"panic_state\",data:data})\n  };\n\n  function onMessage(event){\n    if(event.source!==window.parent)return;\n    const data=event.data;\n    if(!data||data.type!==\"landville:capability-response\"||typeof data.requestId!==\"string\")return;\n    const job=pending.get(data.requestId);\n    if(!job)return;\n    clearTimeout(job.timer);pending.delete(data.requestId);\n    if(data.ok)job.resolve(data.data);\n    else job.reject(new Error(typeof data.error===\"string\"?data.error:\"LANDVILLE storage request failed.\"));\n  }\n\n  window.addEventListener(\"message\",onMessage);\n  window.addEventListener(\"pagehide\",()=>{\n    window.removeEventListener(\"message\",onMessage);\n    pending.forEach((job)=>{clearTimeout(job.timer);job.reject(new Error(\"Board closed.\"));});\n    pending.clear();clearTimeout(gaugeTimer);clearInterval(dayTimer);\n  },{once:true});\n\n  function normalizeText(value){return typeof value===\"string\"?value.replace(/\\s+/g,\" \").trim():\"\";}\n  function safeDate(value){const date=new Date(value);return Number.isFinite(date.getTime())?date:null;}\n  function messageOf(error){return error instanceof Error?error.message:\"LANDVILLE storage request failed.\";}\n  function looksSignedOut(message){return /(sign.?in|signed.?out|citizen account|authentication|unauthorized|forbidden|log.?in)/i.test(message);}\n  function utcKey(value){const date=value instanceof Date?value:new Date(value);return date.toISOString().slice(0,10);}\n  function formatTime(value){return new Intl.DateTimeFormat(\"en-US\",{timeZone:\"UTC\",hour:\"2-digit\",minute:\"2-digit\",hour12:false}).format(new Date(value))+\" UTC\";}\n\n  function authorLabel(record){\n    const author=record&&record.author;\n    if(author&&typeof author.label===\"string\"&&normalizeText(author.label))return normalizeText(author.label).slice(0,80);\n    if(author&&typeof author.username===\"string\"&&normalizeText(author.username))return \"@\"+normalizeText(author.username).replace(/^@/,\"\").slice(0,78);\n    if(record&&record.ownedByViewer===true)return \"YOU\";\n    return \"\";\n  }\n\n  function authorIdentity(record,label){\n    if(record&&record.ownedByViewer===true)return \"__viewer__\";\n    const author=record&&record.author;\n    if(author&&(typeof author.citizenNumber===\"number\"||typeof author.citizenNumber===\"string\")){\n      const number=String(author.citizenNumber).trim();\n      if(number)return \"citizen:\"+number;\n    }\n    return \"label:\"+label.toLocaleLowerCase();\n  }\n\n  function normalizeIdea(record){\n    if(!record||typeof record.id!==\"string\"||!record.id||!safeDate(record.createdAt))return null;\n    const text=normalizeText(record.data&&record.data.text);\n    const author=authorLabel(record);\n    if(!text||text.length>240||!author)return null;\n    return {id:record.id,text:text,author:author,createdAt:new Date(record.createdAt).toISOString(),ownedByViewer:record.ownedByViewer===true};\n  }\n\n  function normalizeReaction(record){\n    if(!record||typeof record.id!==\"string\"||!record.id||!safeDate(record.createdAt))return null;\n    const ideaId=record.data&&record.data.ideaId;\n    const choice=record.data&&record.data.choice;\n    const author=authorLabel(record);\n    if(typeof ideaId!==\"string\"||!ideaId||!author||(choice!==\"LIKE\"&&choice!==\"DISLIKE\"))return null;\n    const updated=safeDate(record.updatedAt)||safeDate(record.createdAt);\n    return {id:record.id,ideaId:ideaId,choice:choice,author:author,authorKey:authorIdentity(record,author),createdAt:new Date(record.createdAt).toISOString(),updatedAt:updated.toISOString(),ownedByViewer:record.ownedByViewer===true};\n  }\n\n  function parsePrivate(value){\n    const result={};\n    const reactions=value&&typeof value===\"object\"&&value.reactions&&typeof value.reactions===\"object\"?value.reactions:{};\n    Object.keys(reactions).forEach((ideaId)=>{\n      const item=reactions[ideaId];\n      if(item&&typeof item.recordId===\"string\"&&item.recordId&&(item.choice===\"LIKE\"||item.choice===\"DISLIKE\"))result[ideaId]={recordId:item.recordId,choice:item.choice};\n    });\n    return result;\n  }\n\n  function privatePayload(){\n    const reactions={};\n    Object.keys(state.privateMap).sort().forEach((ideaId)=>{\n      const item=state.privateMap[ideaId];\n      if(item&&typeof item.recordId===\"string\"&&(item.choice===\"LIKE\"||item.choice===\"DISLIKE\"))reactions[ideaId]={recordId:item.recordId,choice:item.choice};\n    });\n    return {version:1,reactions:reactions};\n  }\n\n  function dedupedReactions(){\n    const ideaIds=new Set(state.ideas.map((idea)=>idea.id));\n    const newest=new Map();\n    state.reactions.forEach((reaction)=>{\n      if(!ideaIds.has(reaction.ideaId))return;\n      const key=reaction.ideaId+\"\\u0000\"+reaction.authorKey;\n      const previous=newest.get(key);\n      const currentTime=Date.parse(reaction.updatedAt);\n      const previousTime=previous?Date.parse(previous.updatedAt):-1;\n      if(!previous||currentTime>previousTime||(currentTime===previousTime&&reaction.id>previous.id))newest.set(key,reaction);\n    });\n    return Array.from(newest.values());\n  }\n\n  function scoreMap(){\n    const scores=new Map(state.ideas.map((idea)=>[idea.id,{likes:0,dislikes:0,total:0,net:0}]));\n    dedupedReactions().forEach((reaction)=>{\n      const score=scores.get(reaction.ideaId);if(!score)return;\n      if(reaction.choice===\"LIKE\")score.likes++;else score.dislikes++;\n      score.total=score.likes+score.dislikes;score.net=score.likes-score.dislikes;\n    });\n    return scores;\n  }\n\n  function todayIdeas(){return state.ideas.filter((idea)=>utcKey(idea.createdAt)===state.dayKey);}\n\n  function rankedIdeas(){\n    const scores=scoreMap();\n    return todayIdeas().slice().sort((a,b)=>{\n      const sa=scores.get(a.id),sb=scores.get(b.id);\n      return sb.net-sa.net||sb.total-sa.total||Date.parse(a.createdAt)-Date.parse(b.createdAt)||a.id.localeCompare(b.id);\n    });\n  }\n\n  function todayReactionCount(){\n    const ids=new Set(todayIdeas().map((idea)=>idea.id));\n    return dedupedReactions().filter((reaction)=>ids.has(reaction.ideaId)).length;\n  }\n\n  function rankFor(ideaId){const index=rankedIdeas().findIndex((idea)=>idea.id===ideaId);return index<0?0:index+1;}\n  function scoreFor(ideaId){return scoreMap().get(ideaId)||{likes:0,dislikes:0,total:0,net:0};}\n\n  async function persistPrivate(){\n    try{\n      await storageApi.setPrivate(privatePayload());\n      state.privateIssue=\"\";state.privateIssueKind=\"\";state.auth=\"signedin\";state.dirtyPrivate.clear();\n      return true;\n    }catch(error){\n      const message=messageOf(error);\n      if(looksSignedOut(message)){state.auth=\"signedout\";state.privateIssue=\"Sign in through LANDVILLE before changing reactions.\";}\n      else state.privateIssue=message;\n      state.privateIssueKind=\"save\";\n      return false;\n    }\n  }\n\n  async function reconcilePrivate(){\n    if(state.auth!==\"signedin\")return;\n    const before=JSON.parse(JSON.stringify(state.privateMap));\n    const loadedIds=new Set(state.ideas.map((idea)=>idea.id));\n    Object.keys(state.privateMap).forEach((ideaId)=>{if(!loadedIds.has(ideaId))delete state.privateMap[ideaId];});\n\n    const owned=new Map();\n    state.reactions.filter((item)=>item.ownedByViewer).forEach((reaction)=>{\n      const previous=owned.get(reaction.ideaId);\n      if(!previous||Date.parse(reaction.updatedAt)>Date.parse(previous.updatedAt)||(reaction.updatedAt===previous.updatedAt&&reaction.id>previous.id))owned.set(reaction.ideaId,reaction);\n    });\n    owned.forEach((reaction,ideaId)=>{if(loadedIds.has(ideaId))state.privateMap[ideaId]={recordId:reaction.id,choice:reaction.choice};});\n\n    if(JSON.stringify(before)!==JSON.stringify(state.privateMap)){\n      const changed=new Set([...Object.keys(before),...Object.keys(state.privateMap)]);\n      state.reconciling=true;\n      const ok=await persistPrivate();\n      if(!ok)changed.forEach((id)=>state.dirtyPrivate.add(id));\n      state.reconciling=false;\n    }\n  }\n\n  async function loadBoard(){\n    const run=++state.loadRun;\n    state.loading=true;state.ideasError=\"\";state.reactionsError=\"\";state.privateIssue=\"\";state.privateIssueKind=\"\";state.auth=\"checking\";\n    state.dayKey=utcKey(new Date());renderAll();\n    const results=await Promise.allSettled([storageApi.listIdeas(),storageApi.listReactions(),storageApi.getPrivate()]);\n    if(run!==state.loadRun)return;\n    const ideaResult=results[0],reactionResult=results[1],privateResult=results[2];\n\n    if(ideaResult.status===\"fulfilled\"){\n      const records=Array.isArray(ideaResult.value&&ideaResult.value.records)?ideaResult.value.records:[];\n      const seen=new Set();state.ideas=records.map(normalizeIdea).filter((item)=>item&&!seen.has(item.id)&&seen.add(item.id)).slice(0,50);\n    }else{state.ideas=[];state.ideasError=messageOf(ideaResult.reason);}\n\n    if(reactionResult.status===\"fulfilled\"){\n      const records=Array.isArray(reactionResult.value&&reactionResult.value.records)?reactionResult.value.records:[];\n      const seen=new Set();state.reactions=records.map(normalizeReaction).filter((item)=>item&&!seen.has(item.id)&&seen.add(item.id)).slice(0,50);\n    }else{state.reactions=[];state.reactionsError=messageOf(reactionResult.reason);}\n\n    if(privateResult.status===\"fulfilled\"){\n      state.auth=\"signedin\";state.privateMap=parsePrivate(privateResult.value&&privateResult.value.value);\n    }else{\n      const message=messageOf(privateResult.reason);state.privateMap={};\n      if(looksSignedOut(message)){state.auth=\"signedout\";state.privateIssue=\"Sign in through LANDVILLE to submit or react.\";}\n      else{state.auth=\"unknown\";state.privateIssue=message;state.privateIssueKind=\"load\";}\n    }\n\n    if(!state.ideasError&&!state.reactionsError)await reconcilePrivate();\n    if(run!==state.loadRun)return;\n    state.loading=false;renderAll();\n  }\n\n  async function retryPrivateLoad(){\n    if(state.reconciling)return;\n    state.reconciling=true;renderAll();\n    try{\n      const result=await storageApi.getPrivate();\n      state.privateMap=parsePrivate(result&&result.value);state.auth=\"signedin\";state.privateIssue=\"\";state.privateIssueKind=\"\";\n      if(!state.ideasError&&!state.reactionsError)await reconcilePrivate();\n      announce(\"Citizen reaction state loaded and reconciled.\");\n    }catch(error){\n      const message=messageOf(error);\n      if(looksSignedOut(message)){state.auth=\"signedout\";state.privateIssue=\"Sign in through LANDVILLE to submit or react.\";}\n      else{state.auth=\"unknown\";state.privateIssue=message;state.privateIssueKind=\"load\";}\n      announce(\"Citizen state could not be loaded. No public write was attempted.\");\n    }finally{state.reconciling=false;renderAll();}\n  }\n\n  function createElement(tag,className,text){\n    const element=document.createElement(tag);\n    if(className)element.className=className;\n    if(text!==undefined)element.textContent=text;\n    return element;\n  }\n\n  function renderState(title,copy,canRetry){\n    const wrap=createElement(\"div\",\"board-state\");\n    const paper=createElement(\"div\",\"paper\");\n    paper.append(createElement(\"strong\",\"\",title),createElement(\"p\",\"empty-copy\",copy));\n    if(canRetry){const button=createElement(\"button\",\"retry\",\"RETRY BOARD\");button.type=\"button\";button.addEventListener(\"click\",loadBoard);paper.append(button);}\n    wrap.append(paper);return wrap;\n  }\n\n  function renderLoading(){\n    noteGrid.replaceChildren();\n    for(let i=0;i<5;i++){\n      const note=createElement(\"article\",\"note loading-note\");\n      note.append(createElement(\"span\",\"pin\"),createElement(\"b\",\"\",\"LOADING PUBLIC SCRAP…\"));noteGrid.append(note);\n    }\n  }\n\n  function renderVacant(){\n    const board=createElement(\"div\",\"vacant-board\");\n    for(let i=1;i<=5;i++){\n      const note=createElement(\"article\",\"vacant-note\");\n      note.append(createElement(\"span\",\"pin\"),createElement(\"small\",\"\",\"EMPTY FILE \"+String(i).padStart(2,\"0\")),createElement(\"b\",\"\",\"VACANT PUBLIC SLOT\"));\n      board.append(note);\n    }\n    board.append(createElement(\"div\",\"vacant-notice\",\"NO PUBLIC IDEAS FILED FOR \"+state.dayKey+\". THIS IS EITHER PEACE OR POOR ADMINISTRATION.\"));\n    noteGrid.replaceChildren(board);\n  }\n\n  function renderNote(idea,index,score){\n    const note=createElement(\"article\",\"note\"+(state.expanded.has(idea.id)?\" expanded\":\"\"));\n    note.dataset.ideaId=idea.id;note.append(createElement(\"span\",\"pin\"));\n    note.append(createElement(\"span\",\"rank\",state.view===\"top\"?\"#\"+(index+1):\"FILE \"+String(index+1).padStart(2,\"0\")));\n\n    const open=createElement(\"button\",\"note-open\");open.type=\"button\";open.dataset.action=\"expand\";open.dataset.ideaId=idea.id;open.dataset.focus=idea.id+\":expand\";\n    open.setAttribute(\"aria-expanded\",state.expanded.has(idea.id)?\"true\":\"false\");\n    open.setAttribute(\"aria-label\",(state.expanded.has(idea.id)?\"Collapse idea: \":\"Expand idea: \")+idea.text);\n    open.append(createElement(\"p\",\"idea-text\",idea.text),createElement(\"span\",\"expand-hint\",state.expanded.has(idea.id)?\"COLLAPSE NOTE\":\"EXPAND FULL NOTE\"));note.append(open);\n\n    const meta=createElement(\"div\",\"note-meta\");\n    const time=createElement(\"time\",\"\",formatTime(idea.createdAt));time.dateTime=idea.createdAt;\n    meta.append(createElement(\"span\",\"author-line\",idea.author),time);note.append(meta);\n\n    const scores=createElement(\"div\",\"score-line\");\n    if(score){\n      scores.append(createElement(\"span\",\"\",\"LIKE \"+score.likes),createElement(\"span\",\"\",\"DISLIKE \"+score.dislikes));\n      const net=createElement(\"strong\",\"\",(score.net>0?\"+\":\"\")+score.net);net.setAttribute(\"aria-label\",\"Net score \"+score.net);scores.append(net);\n    }else scores.append(createElement(\"span\",\"\",\"REACTION TALLY UNAVAILABLE\"));\n    note.append(scores);\n\n    const selected=state.privateMap[idea.id]&&state.privateMap[idea.id].choice;\n    const locked=state.loading||state.auth!==\"signedin\"||Boolean(state.reactionsError)||state.reactionBusy.has(idea.id)||state.dirtyPrivate.has(idea.id)||state.reconciling||state.privateIssueKind===\"load\";\n    const reactions=createElement(\"div\",\"reaction-row\");\n    [\"LIKE\",\"DISLIKE\"].forEach((choice)=>{\n      const button=createElement(\"button\",\"reaction \"+(choice===\"DISLIKE\"?\"dislike\":\"\"),choice);\n      button.type=\"button\";button.dataset.action=\"react\";button.dataset.ideaId=idea.id;button.dataset.choice=choice;button.dataset.focus=idea.id+\":\"+choice;\n      button.setAttribute(\"aria-pressed\",selected===choice?\"true\":\"false\");button.disabled=locked;\n      const verb=selected===choice?\"Remove \":selected?\"Change reaction to \":\"Record \";\n      button.setAttribute(\"aria-label\",verb+choice.toLowerCase()+\" for: \"+idea.text);\n      if(state.reactionBusy.has(idea.id))button.textContent=\"WRITING…\";\n      reactions.append(button);\n    });\n    note.append(reactions);\n\n    if(state.noteErrors[idea.id])note.append(createElement(\"p\",\"note-error\",state.noteErrors[idea.id]));\n    if(state.dirtyPrivate.has(idea.id)){\n      const retry=createElement(\"button\",\"sync-button\",\"RETRY PRIVATE SYNC\");retry.type=\"button\";retry.dataset.action=\"sync\";retry.dataset.ideaId=idea.id;retry.dataset.focus=idea.id+\":sync\";note.append(retry);\n    }\n    return note;\n  }\n\n  function renderBoard(focusKey){\n    noteGrid.setAttribute(\"aria-busy\",state.loading?\"true\":\"false\");\n    if(state.loading){renderLoading();return;}\n    if(state.ideasError){noteGrid.replaceChildren(renderState(\"BOARD FEED FAILED\",state.ideasError,true));return;}\n    if(state.view===\"top\"&&state.reactionsError){noteGrid.replaceChildren(renderState(\"RANKING LEDGER FAILED\",\"TOP 5 cannot be calculated until reactions load. TODAY'S BOARD remains available. \"+state.reactionsError,true));return;}\n\n    const scores=state.reactionsError?null:scoreMap();\n    const ideas=state.view===\"top\"?rankedIdeas().slice(0,5):todayIdeas().slice().sort((a,b)=>Date.parse(b.createdAt)-Date.parse(a.createdAt)||a.id.localeCompare(b.id));\n    if(!ideas.length){renderVacant();return;}\n\n    const fragment=document.createDocumentFragment();\n    ideas.forEach((idea,index)=>fragment.append(renderNote(idea,index,scores?scores.get(idea.id):null)));\n    noteGrid.replaceChildren(fragment);\n    if(focusKey)requestAnimationFrame(()=>{\n      const target=noteGrid.querySelector('[data-focus=\"'+CSS.escape(focusKey)+'\"]');\n      if(target&&!target.disabled)target.focus();else byId(\"boardTitle\").focus();\n    });\n  }\n\n  function renderChrome(){\n    byId(\"dateLabel\").textContent=\"UTC DAY \"+state.dayKey;\n    byId(\"topTab\").setAttribute(\"aria-pressed\",state.view===\"top\"?\"true\":\"false\");\n    byId(\"todayTab\").setAttribute(\"aria-pressed\",state.view===\"today\"?\"true\":\"false\");\n    byId(\"boardTitle\").textContent=state.view===\"top\"?\"TOP 5\":\"TODAY'S BOARD\";\n    const reactionScope=state.reactionsError?\"REACTIONS UNAVAILABLE\":todayReactionCount()+\" COUNTED REACTIONS\";\n    byId(\"scopeLine\").textContent=(state.view===\"top\"?\"TOP 5 / LOADED UTC BOARD\":\"TODAY'S BOARD / UTC\")+\" · \"+state.dayKey+\" · \"+todayIdeas().length+\" IDEAS · \"+reactionScope;\n\n    const status=byId(\"statusLine\");\n    if(state.loading)status.textContent=\"CONNECTING TO PUBLIC BOARD…\";\n    else if(state.ideasError)status.textContent=\"PUBLIC BOARD FEED UNAVAILABLE\";\n    else if(state.reactionsError)status.textContent=\"PUBLIC BOARD / REACTION LEDGER ERROR\";\n    else if(state.auth===\"signedout\")status.textContent=\"PUBLIC BOARD / READ-ONLY VISITOR\";\n    else if(state.auth!==\"signedin\"||state.privateIssue)status.textContent=\"PUBLIC BOARD / CITIZEN STATE NEEDS RETRY\";\n    else status.textContent=\"PUBLIC BOARD / CITIZEN WRITES READY\";\n  }\n\n  function renderComposer(){\n    const writable=!state.loading&&!state.ideasError&&state.auth===\"signedin\"&&!state.submitting;\n    input.disabled=!writable;submit.disabled=!writable||!normalizeText(input.value);\n    byId(\"writeAccess\").textContent=state.loading?\"CHECKING CITIZEN ACCESS…\":state.auth===\"signedout\"?\"READ-ONLY — SIGN IN THROUGH LANDVILLE\":state.auth!==\"signedin\"?\"CITIZEN STATE UNKNOWN — RETRY REQUIRED\":state.privateIssue?\"SIGNED CITIZEN / REACTION SYNC PENDING\":\"SIGNED CITIZEN / PUBLIC POST\";\n    submit.textContent=state.submitting?\"PINNING…\":\"PIN TO BOARD\";\n\n    const panel=byId(\"syncPanel\");panel.hidden=!state.privateIssue||state.auth===\"signedout\";\n    byId(\"syncWarning\").textContent=state.privateIssue||\"\";\n    const retry=byId(\"retryPrivate\");retry.disabled=state.reconciling;\n    retry.textContent=state.reconciling?\"RETRYING…\":state.privateIssueKind===\"load\"?\"RETRY CITIZEN STATE\":\"RETRY PRIVATE SYNC\";\n  }\n\n  function renderAll(focusKey){renderChrome();renderComposer();renderBoard(focusKey);}\n  function announce(text){live.textContent=\"\";requestAnimationFrame(()=>{live.textContent=text;});}\n\n  function revealGauge(){\n    const gauge=byId(\"gauge\");gauge.classList.remove(\"twitch\");void gauge.offsetWidth;gauge.classList.add(\"twitch\");\n    byId(\"stamp\").classList.add(\"visible\");clearTimeout(gaugeTimer);gaugeTimer=setTimeout(()=>gauge.classList.remove(\"twitch\"),750);\n  }\n\n  async function submitIdea(){\n    const text=normalizeText(input.value);\n    const message=byId(\"composerMessage\");\n    if(!text||text.length>240||state.submitting||state.auth!==\"signedin\")return;\n    state.submitting=true;message.hidden=true;renderComposer();\n    let publicCommitted=false;\n    try{\n      const response=await storageApi.createIdea({text:text});publicCommitted=true;\n      const record=Object.assign({},response&&response.record,{ownedByViewer:true,data:{text:text}});\n      const idea=normalizeIdea(record);\n      if(!idea){\n        message.textContent=\"The public idea write succeeded, but its returned record was incomplete. Reloading the board without submitting again.\";message.className=\"composer-message error\";message.hidden=false;\n        announce(\"Public idea write succeeded. Reloading the board to reconcile it.\");await loadBoard();return;\n      }\n      state.ideas=state.ideas.filter((item)=>item.id!==idea.id);state.ideas.unshift(idea);state.ideas=state.ideas.slice(0,50);\n      input.value=\"\";updateCount();state.view=\"today\";\n      message.textContent=\"Idea pinned to the public board.\";message.className=\"composer-message\";message.hidden=false;\n      announce(\"Idea pinned to Today's Board.\");\n    }catch(error){\n      const textMessage=messageOf(error);\n      if(looksSignedOut(textMessage)){state.auth=\"signedout\";state.privateIssue=\"Sign in through LANDVILLE to submit an idea.\";}\n      message.textContent=publicCommitted?\"The public idea write succeeded, but the board could not reconcile the returned record. Retry the board before submitting again.\":textMessage;\n      message.className=\"composer-message error\";message.hidden=false;\n    }finally{state.submitting=false;renderAll();}\n  }\n\n  function mergedUpdatedReaction(response,existing,ideaId,choice){\n    const record=response&&response.record;\n    if(record){\n      const normalized=normalizeReaction(Object.assign({},record,{id:existing?existing.id:record.id,ownedByViewer:true,data:{ideaId:ideaId,choice:choice}}));\n      if(normalized)return normalized;\n    }\n    if(existing){\n      return Object.assign({},existing,{ideaId:ideaId,choice:choice,ownedByViewer:true,authorKey:\"__viewer__\"});\n    }\n    return null;\n  }\n\n  async function react(ideaId,choice){\n    if(state.auth!==\"signedin\"||state.reactionBusy.has(ideaId)||state.dirtyPrivate.has(ideaId)||state.reactionsError||state.privateIssueKind===\"load\")return;\n    const current=state.privateMap[ideaId];\n    const oldRank=rankFor(ideaId);\n    state.reactionBusy.add(ideaId);delete state.noteErrors[ideaId];renderBoard(ideaId+\":\"+choice);\n    let publicCommitted=false;\n    let action=\"recorded\";\n\n    try{\n      if(!current){\n        const response=await storageApi.createReaction({ideaId:ideaId,choice:choice});publicCommitted=true;\n        const publicRecord=normalizeReaction(Object.assign({},response&&response.record,{ownedByViewer:true,data:{ideaId:ideaId,choice:choice}}));\n        if(!publicRecord)throw new Error(\"The public write returned no usable reaction record ID.\");\n        state.reactions=state.reactions.filter((item)=>item.id!==publicRecord.id);state.reactions.unshift(publicRecord);state.reactions=state.reactions.slice(0,50);\n        state.privateMap[ideaId]={recordId:publicRecord.id,choice:choice};\n      }else if(current.choice===choice){\n        await storageApi.deleteReaction(current.recordId);publicCommitted=true;action=\"removed\";\n        state.reactions=state.reactions.filter((item)=>item.id!==current.recordId);delete state.privateMap[ideaId];\n      }else{\n        const existing=state.reactions.find((item)=>item.id===current.recordId)||null;\n        const response=await storageApi.updateReaction(current.recordId,{ideaId:ideaId,choice:choice});publicCommitted=true;action=\"changed\";\n        const publicRecord=mergedUpdatedReaction(response,existing,ideaId,choice);\n        if(!publicRecord)throw new Error(\"The public update returned no usable reaction record.\");\n        state.reactions=state.reactions.filter((item)=>item.id!==current.recordId);state.reactions.unshift(publicRecord);\n        state.privateMap[ideaId]={recordId:current.recordId,choice:choice};\n      }\n\n      revealGauge();\n      const newScore=scoreFor(ideaId),newRank=rankFor(ideaId);\n      const privateOk=await persistPrivate();\n      const rankText=newRank?\" Loaded UTC rank \"+newRank+(oldRank&&oldRank!==newRank?\", previously \"+oldRank:\"\")+\".\":\"\";\n      const scoreText=\" Net score \"+newScore.net+\" from \"+newScore.total+\" counted reaction\"+(newScore.total===1?\"\":\"s\")+\".\";\n\n      if(!privateOk){\n        state.dirtyPrivate.add(ideaId);\n        state.noteErrors[ideaId]=\"The public reaction write succeeded. Private state needs retry before another change to this idea.\";\n        announce(\"Public reaction \"+action+\".\"+scoreText+rankText+\" Private state needs retry.\");\n      }else announce(\"Reaction \"+action+\".\"+scoreText+rankText);\n    }catch(error){\n      const textMessage=messageOf(error);\n      if(publicCommitted){\n        revealGauge();state.dirtyPrivate.add(ideaId);state.privateIssue=textMessage;state.privateIssueKind=\"load\";\n        state.noteErrors[ideaId]=\"The public reaction write succeeded, but its record could not be reconciled. Reload citizen state before reacting again.\";\n        announce(\"Public reaction write succeeded, but local reconciliation failed. No duplicate reaction will be attempted.\");\n      }else{\n        if(looksSignedOut(textMessage)){state.auth=\"signedout\";state.privateIssue=\"Sign in through LANDVILLE before reacting.\";}\n        state.noteErrors[ideaId]=textMessage;announce(\"Reaction was not recorded. \"+textMessage);\n      }\n    }finally{state.reactionBusy.delete(ideaId);renderAll(ideaId+\":\"+choice);}\n  }\n\n  async function retryPrivateSave(ideaId){\n    if(state.reconciling)return;\n    state.reconciling=true;renderAll(ideaId?ideaId+\":sync\":undefined);\n    const ok=await persistPrivate();state.reconciling=false;\n    if(ok){state.noteErrors={};announce(\"Private reaction state synchronized.\");}\n    else announce(\"Private state synchronization failed. No new public reaction was attempted.\");\n    renderAll(ideaId?ideaId+\":sync\":undefined);\n  }\n\n  function retryPrivate(ideaId){\n    if(state.privateIssueKind===\"load\")retryPrivateLoad();else retryPrivateSave(ideaId);\n  }\n\n  function updateCount(){\n    byId(\"charCount\").textContent=input.value.length+\" / 240\";\n    const writable=!state.loading&&!state.ideasError&&state.auth===\"signedin\"&&!state.submitting;\n    submit.disabled=!writable||!normalizeText(input.value);\n  }\n\n  byId(\"topTab\").addEventListener(\"click\",()=>{state.view=\"top\";renderAll();byId(\"boardTitle\").focus();});\n  byId(\"todayTab\").addEventListener(\"click\",()=>{state.view=\"today\";renderAll();byId(\"boardTitle\").focus();});\n  input.addEventListener(\"input\",updateCount);\n  input.addEventListener(\"keydown\",(event)=>{if((event.ctrlKey||event.metaKey)&&event.key===\"Enter\"){event.preventDefault();submitIdea();}});\n  submit.addEventListener(\"click\",submitIdea);\n  byId(\"retryPrivate\").addEventListener(\"click\",()=>retryPrivate());\n  noteGrid.addEventListener(\"click\",(event)=>{\n    const button=event.target.closest(\"button[data-action]\");if(!button)return;\n    const action=button.dataset.action,ideaId=button.dataset.ideaId;\n    if(action===\"expand\"){\n      if(state.expanded.has(ideaId))state.expanded.delete(ideaId);else state.expanded.add(ideaId);\n      renderBoard(ideaId+\":expand\");\n    }else if(action===\"react\")react(ideaId,button.dataset.choice);\n    else if(action===\"sync\")retryPrivate(ideaId);\n  });\n\n  state.dayKey=utcKey(new Date());renderAll();loadBoard();\n  const dayTimer=setInterval(()=>{\n    const next=utcKey(new Date());\n    if(next!==state.dayKey){state.dayKey=next;renderAll();announce(\"The civic board rolled over to UTC day \"+next+\".\");}\n  },60000);\n})();\n</script>\n</body>\n</html>",
  "acceptance": [
    "Do it on the best way"
  ],
  "capabilities": {
    "storage": [
      {
        "name": "panic_ideas",
        "mode": "shared",
        "description": "Public absurd idea posts; text is citizen-authored and timestamps come from LANDVILLE storage."
      },
      {
        "name": "panic_reactions",
        "mode": "shared",
        "description": "Public LIKE or DISLIKE records keyed to an idea; only the reacting author may edit or delete them."
      },
      {
        "name": "panic_state",
        "mode": "private",
        "description": "Per-citizen reaction record IDs and choices used to reconcile and prevent duplicate reactions."
      }
    ]
  }

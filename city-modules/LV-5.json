ate.ledgers.push({id:ledgerId,choices:Object.assign({},nextChoices)});state.ownLedgerVisible=true;var nextState={reactionLedgerId:ledgerId,choices:Object.assign({},nextChoices),authoredIdeaIds:state.privateState.authoredIdeaIds.slice(0,50),schemaVersion:1,updatedAt:new Date().toISOString()};state.privateState=nextState;var warning='';try{await savePrivate(nextState)}catch(error){warning=' Public counts changed, but the private reaction link could not be synchronized: '+errorText(error)}setNotice(warning||'REACTION SAVED. CIVIC DESTINY REMAINS UNAFFECTED.',Boolean(warning))}catch(error){setNotice('REACTION NOT CONFIRMED: '+errorText(error),true)}finally{state.reactionBusy='';render()}}\nfunction showStamp(){clearTimeout(state.stampTimer);ui.stamp.hidden=false;ui.stamp.classList.remove('show');ui.arm.classList.remove('clack');void ui.stamp.offsetWidth;ui.stamp.classList.add('show');ui.arm.classList.add('clack');state.stampTimer=setTimeout(function(){ui.stamp.hidden=true;ui.stamp.classList.remove('show');ui.arm.classList.remove('clack')},9000)}\nfunction setView(view,moveFocus){state.view=view;renderBoard();if(moveFocus)focusNode(view==='top'?ui.topTab:ui.allTab)}\nfunction handleTabKeys(event){if(!['ArrowLeft','ArrowRight','Home','End'].includes(event.key))return;event.preventDefault();if(event.key==='Home')setView('top',true);else if(event.key==='End')setView('all',true);else setView(state.view==='top'?'all':'top',true)}\nfunction trapDialog(event){if(ui.composer.hidden||event.key!=='Tab')return;var focusable=Array.prototype.slice.call(ui.composer.querySelectorAll('button:not([disabled]),input:not([disabled]),textarea:not([disabled]),select:not([disabled]),[tabindex]:not([tabindex=\"-1\"])')).filter(function(node){return !node.hidden&&node.offsetParent!==null});if(!focusable.length){event.preventDefault();return}var first=focusable[0],last=focusable[focusable.length-1];if(event.shiftKey&&document.activeElement===first){event.preventDefault();last.focus()}else if(!eve
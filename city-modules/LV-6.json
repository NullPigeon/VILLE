{
  "version": 1,
  "proposalId": "LV-6",
  "title": "Avatar Forge Window",
  "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Avatar Forge Window</title>\n<style>\n:root{--void:#080907;--ink:#11130d;--paper:#d5bd8d;--acid:#c7ff00;--rust:#a64b28;--line:rgba(213,189,141,.28);--muted:#93805d;--danger:#ee8d68}*{box-sizing:border-box}html{background:var(--void);color:var(--paper);font-family:Arial,Helvetica,sans-serif}body{min-width:280px;margin:0;background:radial-gradient(circle at 81% 4%,rgba(166,75,40,.15),transparent 27%),linear-gradient(135deg,#080907,#0d0e09 58%,#080907);color:var(--paper)}body:before{content:\"\";position:fixed;inset:0;pointer-events:none;opacity:.15;background-image:radial-gradient(#d5bd8d 0.45px,transparent .7px);background-size:7px 9px;mix-blend-mode:screen}button,textarea{font:inherit}button{cursor:pointer}button:disabled{cursor:not-allowed;opacity:.48}textarea:disabled{cursor:not-allowed;opacity:1;color:#a18e69;background:#0b0c09}button:focus-visible,textarea:focus-visible{outline:3px solid var(--acid);outline-offset:3px}.shell{width:min(1180px,calc(100% - 28px));margin:auto;padding:18px 0 50px}.forge-head{position:relative;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:18px;align-items:end;padding:16px 18px 14px;border:1px solid #675632;border-bottom-color:var(--acid);background:#10120d;box-shadow:7px 7px #030402}.forge-head:before{content:\"\";position:absolute;top:-7px;left:34px;width:72px;height:7px;border:1px solid #675632;border-bottom:0;background:#10120d}.kicker,.status-line,.control-label,.counter,.machine-label,.candidate-meta,.summary-count,.quota-note,.world-copy,.storage-status,.input-hint{font-family:ui-monospace,SFMono-Regular,Consolas,monospace}.kicker{display:flex;align-items:center;gap:8px;margin-bottom:5px;color:var(--acid);font-size:9px;font-weight:900;letter-spacing:1.7px}.kicker i{width:7px;height:7px;display:inline-block;border-radius:50%;background:var(--acid);box-shadow:0 0 12px var(--acid)}h1{margin:0;color:#e0c999;font-size:clamp(38px,7vw,76px);font-weight:950;line-height:.78;letter-spacing:-4px;transform:skew(-4deg);transform-origin:left bottom}.head-ticket{min-width:190px;padding:9px 11px;border:1px dashed #667832;background:#171b10;transform:rotate(1deg)}.head-ticket b,.head-ticket span{display:block}.head-ticket b{color:var(--acid);font:900 10px ui-monospace,SFMono-Regular,Consolas,monospace}.head-ticket span{margin-top:5px;color:#a9956c;font:8px/1.45 ui-monospace,SFMono-Regular,Consolas,monospace}.machine{position:relative;margin-top:16px;padding:12px;border:1px solid #665333;background:#15150f;box-shadow:8px 8px #030402}.machine:before,.machine:after{content:\"\";position:absolute;width:7px;height:7px;border:1px solid #786441;background:#080907}.machine:before{left:5px;top:5px}.machine:after{right:5px;bottom:5px}.machine-top{display:flex;align-items:center;justify-content:space-between;gap:15px;min-height:34px;padding:0 6px 10px}.machine-label{color:var(--acid);font-size:9px;font-weight:900;letter-spacing:1.2px}.status-line{min-width:0;color:#9d8a64;font-size:8px;text-align:right}.machine-grid{display:grid;grid-template-columns:minmax(200px,.72fr) minmax(340px,1.28fr);gap:10px;min-height:350px}.specimen,.rack{position:relative;border:1px solid #5c4d30;background:#0c0e09;overflow:hidden}.specimen{min-height:350px;padding:10px;box-shadow:inset 0 0 45px #000}.specimen:before{content:\"SPECIMEN BAY / HEAD TO BOOTS\";position:absolute;z-index:4;left:9px;top:9px;padding:5px 7px;background:var(--acid);color:#101108;font:900 7px ui-monospace,SFMono-Regular,Consolas,monospace;box-shadow:3px 3px #263500;transform:rotate(-1deg)}.specimen:after{content:\"\";position:absolute;left:50%;bottom:18px;width:62%;height:13px;transform:translateX(-50%);border-radius:50%;background:#000;filter:blur(6px);opacity:.8}.hanger{position:absolute;left:50%;top:55px;width:60%;height:1px;transform:translateX(-50%);background:#7c6841}.hanger:before,.hanger:after{content:\"\";position:absolute;top:0;width:1px;height:30px;background:#7c6841}.hanger:before{left:16%}.hanger:after{right:16%}.stencil{position:absolute;z-index:2;left:50%;top:54%;width:142px;height:245px;transform:translate(-50%,-50%);filter:drop-shadow(7px 8px #000)}.stencil .head{position:absolute;left:50%;top:0;width:57px;height:61px;transform:translateX(-50%) rotate(-2deg);border:1px dashed #718335;background:#202718}.stencil .body{position:absolute;left:50%;top:66px;width:91px;height:105px;transform:translateX(-50%) skew(-3deg);border:1px dashed #718335;background:#171c12}.stencil .arm{position:absolute;top:73px;width:25px;height:118px;border:1px dashed #718335;background:#161b11}.stencil .arm.left{left:3px;transform:rotate(7deg)}.stencil .arm.right{right:3px;transform:rotate(-7deg)}.stencil .leg{position:absolute;top:164px;width:37px;height:78px;border:1px dashed #718335;background:#161b11}.stencil .leg.left{left:29px;transform:rotate(2deg)}.stencil .leg.right{right:29px;transform:rotate(-2deg)}.stencil .acid-mark{position:absolute;left:50%;top:103px;width:22px;height:22px;transform:translateX(-50%) rotate(45deg);border:2px solid var(--acid);box-shadow:0 0 15px rgba(199,255,0,.22)}.empty-instruction{position:absolute;z-index:3;left:12px;right:12px;bottom:12px;padding:8px;border-left:2px solid var(--rust);background:rgba(8,9,7,.9);color:#b9a478;font:8px/1.5 ui-monospace,SFMono-Regular,Consolas,monospace}.specimen-image{position:absolute;z-index:3;inset:0;width:100%;height:100%;display:none;object-fit:contain;object-position:center;background:#0b0c08}.specimen.has-image .specimen-image{display:block}.specimen.has-image .stencil,.specimen.has-image .empty-instruction,.specimen.has-image .hanger{display:none}.selection-mark{position:absolute;z-index:5;right:10px;bottom:12px;display:none;max-width:200px;padding:7px 9px;border:1px solid var(--acid);background:#0a0c08e8;color:var(--acid);font:900 8px ui-monospace,SFMono-Regular,Consolas,monospace;box-shadow:4px 4px #000}.specimen.has-image .selection-mark{display:block}.rack{display:grid;grid-template-rows:auto 1fr;padding:10px}.rack-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:1px 2px 9px;border-bottom:1px solid var(--line)}.rack-head b{font-size:12px;letter-spacing:.3px}.rack-head span{color:var(--acid);font:8px ui-monospace,SFMono-Regular,Consolas,monospace}.candidate-rack{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px;padding-top:10px}.candidate,.empty-slot{position:relative;min-width:0;min-height:287px;border:1px solid #50452b;background:#11130d;overflow:hidden}.candidate{padding:0;color:var(--paper);text-align:left;box-shadow:4px 4px #030402;transition:transform .13s ease,border-color .13s ease}.candidate:hover{border-color:#839c38;transform:translateY(-2px)}.candidate.selected{border:2px solid var(--acid);transform:translateY(-3px) rotate(-.5deg);box-shadow:5px 6px #344500}.candidate img{display:block;width:100%;height:242px;object-fit:contain;object-position:center;background:#0a0c08}.candidate .candidate-footer{position:absolute;z-index:2;left:0;right:0;bottom:0;min-height:44px;padding:7px 8px;background:#11130df2;border-top:1px solid #4b422a}.candidate .candidate-footer b{display:block;color:var(--acid);font:900 9px ui-monospace,SFMono-Regular,Consolas,monospace}.candidate-meta{display:block;margin-top:3px;color:#8f7d5b;font-size:7px}.empty-slot{display:grid;place-items:center;padding:12px;border-style:dashed;color:#6f6249;text-align:center}.empty-slot:before{content:\"\";position:absolute;inset:15px 25%;border:1px dashed #35411f;background:linear-gradient(90deg,transparent 47%,#35411f 48%,#35411f 52%,transparent 53%)}.empty-slot b{position:relative;z-index:2;padding:6px;background:#11130d;color:#889b4f;font:900 9px ui-monospace,SFMono-Regular,Consolas,monospace}.workbench{display:grid;grid-template-columns:minmax(0,1.18fr) minmax(280px,.82fr);gap:14px;margin-top:16px}.panel{position:relative;border:1px solid #58492e;background:#11130d;box-shadow:5px 5px #030402}.panel-head{min-height:43px;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 13px;border-bottom:1px solid #443a26}.panel-head h2{margin:0;font-size:13px;font-weight:950;letter-spacing:.3px}.panel-head span{color:var(--acid);font:8px ui-monospace,SFMono-Regular,Consolas,monospace}.panel-body{padding:13px}.brief-label{display:flex;justify-content:space-between;gap:12px;margin-bottom:7px;color:#b9a579;font:900 9px ui-monospace,SFMono-Regular,Consolas,monospace}.counter{color:var(--acid);font-size:8px}textarea{width:100%;min-height:105px;resize:vertical;padding:11px;border:1px solid #57492e;border-radius:0;outline:0;background:#080a07;color:var(--paper);font:11px/1.5 ui-monospace,SFMono-Regular,Consolas,monospace}.input-hint{margin:6px 0 0;color:#76694e;font-size:8px;line-height:1.45}.validation{min-height:18px;margin:6px 0 0;color:var(--danger);font:8px/1.45 ui-monospace,SFMono-Regular,Consolas,monospace}.control-bank{display:grid;gap:11px;margin-top:11px}.control-row{display:grid;grid-template-columns:100px minmax(0,1fr);gap:8px;align-items:start}.control-label{padding-top:12px;color:#8f7c59;font-size:8px;font-weight:900}.chips{display:flex;flex-wrap:wrap;gap:5px}.chip{min-height:44px;padding:7px 9px;border:1px solid #4e432b;border-radius:0;background:#0c0e09;color:#a79268;font:800 8px/1.2 ui-monospace,SFMono-Regular,Consolas,monospace}.chip:hover{border-color:#899f41;color:#c9b788}.chip.active{border-color:var(--acid);background:#202815;color:var(--acid);box-shadow:3px 3px #283700}.chip:disabled.active{opacity:.78}.review{margin-top:13px;border:1px dashed #66743b;background:#0a0c08}.review-head{display:flex;justify-content:space-between;gap:10px;padding:8px 9px;border-bottom:1px dashed #4a5530;color:var(--acid);font:900 8px ui-monospace,SFMono-Regular,Consolas,monospace}.summary-count{color:#9e8b66;font-size:8px}.review-output{min-height:60px;margin:0;padding:10px;color:#cbb88e;white-space:pre-wrap;overflow-wrap:anywhere;font:9px/1.55 ui-monospace,SFMono-Regular,Consolas,monospace}.forge-actions{display:grid;grid-template-columns:minmax(180px,auto) 1fr;gap:12px;align-items:center;margin-top:12px}.forge-button,.world-button{min-height:48px;border:1px solid var(--acid);border-radius:0;padding:0 14px;background:var(--acid);color:#0c0e09;font-size:10px;font-weight:950;letter-spacing:.5px;box-shadow:5px 5px #3b4e00}.forge-button:not(:disabled):hover,.world-button:not(:disabled):hover{transform:translate(-2px,-2px);box-shadow:7px 7px #3b4e00}.quota-note{margin:0;color:#93805d;font-size:8px;line-height:1.45}.quota-note b{color:#b7cc65}.notice{display:none;margin-top:12px;padding:10px;border-left:3px solid var(--acid);background:#171d10;color:#c7d881;font:9px/1.5 ui-monospace,SFMono-Regular,Consolas,monospace}.notice.show{display:block}.notice.error{border-color:var(--rust);background:#25140e;color:var(--danger)}.pending-box{display:none;margin-top:12px;padding:12px;border:1px dashed var(--acid);background:#10150b}.pending-box.show{display:grid;grid-template-columns:42px 1fr;gap:11px;align-items:center}.press-wheel{position:relative;width:38px;height:38px;border:3px dotted var(--acid);border-radius:50%;animation:turn 3.4s linear infinite}.press-wheel:before{content:\"\";position:absolute;inset:10px;border:1px solid var(--acid);transform:rotate(45deg)}.pending-box b{display:block;color:var(--acid);font:900 9px ui-monospace,SFMono-Regular,Consolas,monospace}.pending-box span{display:block;margin-top:4px;color:#9c8965;font:8px/1.45 ui-monospace,SFMono-Regular,Consolas,monospace}.world-panel .panel-body{display:grid;gap:12px}.world-gauge{display:grid;grid-template-columns:52px 1fr;gap:12px;align-items:center}.lever-box{position:relative;width:52px;height:96px;border:1px solid #5f5031;background:#080a07;box-shadow:inset 0 0 18px #000}.lever-track{position:absolute;left:50%;top:12px;bottom:12px;width:4px;transform:translateX(-50%);background:#423a28}.lever{position:absolute;z-index:2;left:50%;top:19px;width:28px;height:15px;transform:translateX(-50%);border:1px solid var(--acid);background:#1b2211;box-shadow:3px 3px #000;transition:top .25s ease}.lever:after{content:\"\";position:absolute;left:50%;bottom:12px;width:2px;height:25px;transform:translateX(-50%);background:#9d895e}.lever.dropped{top:59px}.world-status{color:var(--acid);font-size:13px;font-weight:950}.world-copy{margin:5px 0 0;color:#9e8b67;font-size:8px;line-height:1.55}.scrapy-stamp{display:none;padding:10px;border:2px solid var(--acid);color:var(--acid);font:950 10px/1.35 ui-monospace,SFMono-Regular,Consolas,monospace;transform:rotate(-1deg);box-shadow:4px 4px #293700}.scrapy-stamp.show{display:block}.publish-note{padding:10px;border:1px dashed #675735;color:#b19c74;background:#0b0d09;font:8px/1.55 ui-monospace,SFMono-Regular,Consolas,monospace}.publish-note b{color:var(--acid)}.world-button{width:100%}.world-button.secondary{background:transparent;color:var(--acid);box-shadow:none}.world-button.danger{border-color:var(--rust);background:#26150f;color:#f09a77;box-shadow:5px 5px #431b0e}.world-button.danger:not(:disabled):hover{box-shadow:7px 7px #431b0e}.storage-status{padding-top:2px;color:#887757;font-size:8px;line-height:1.45}.storage-status.warn{color:var(--danger)}.limits{margin-top:14px;padding:10px 12px;border:1px solid #443a26;background:#0b0c08;color:#7f7054;font:8px/1.55 ui-monospace,SFMono-Regular,Consolas,monospace}.limits b{color:#a9956d}.batch-ticket{display:none;margin-top:10px;padding:8px 10px;border:1px solid #6d8134;background:#171e0e;color:var(--acid);font:900 8px/1.45 ui-monospace,SFMono-Regular,Consolas,monospace}.batch-ticket.show{display:block}@keyframes turn{to{transform:rotate(360deg)}}@media(max-width:800px){.shell{width:min(100% - 18px,1180px)}.machine-grid{grid-template-columns:minmax(180px,.62fr) minmax(330px,1.38fr)}.workbench{grid-template-columns:1fr}.candidate img{height:220px}.candidate,.empty-slot{min-height:266px}}@media(max-width:520px){.shell{padding-top:9px}.forge-head{grid-template-columns:1fr;padding:14px}.head-ticket{min-width:0}.machine{padding:8px}.machine-top{display:grid}.status-line{text-align:left}.machine-grid{grid-template-columns:1fr}.specimen{min-height:385px}.rack{min-height:390px}.candidate-rack{gap:5px}.candidate,.empty-slot{min-height:315px}.candidate img{height:268px}.candidate .candidate-footer{padding:6px}.control-row{grid-template-columns:1fr}.control-label{padding-top:0}.forge-actions{grid-template-columns:1fr}.forge-button{width:100%}h1{font-size:46px}}@media(prefers-reduced-motion:reduce){*{scroll-behavior:auto!important}.press-wheel{animation:none}.candidate,.lever,.forge-button,.world-button{transition:none!important}}\n</style>\n</head>\n<body>\n<main class=\"shell\">\n<header class=\"forge-head\">\n<div><div class=\"kicker\"><i></i>MUNICIPAL IDENTITY WORKS / CITIZEN OPERATED</div><h1>AVATAR FORGE</h1></div>\n<div class=\"head-ticket\"><b>ONE UTC WEEK / ONE BATCH</b><span>THREE FULL-BODY CITIZENS.<br>ONE MAY ENTER THE WORLD.</span></div>\n</header>\n<section class=\"machine\" aria-labelledby=\"machine-title\">\n<div class=\"machine-top\"><span class=\"machine-label\" id=\"machine-title\">BAY 01 / PORTRAIT PRESS</span><output class=\"status-line\" id=\"topStatus\" aria-live=\"polite\">RESTORING CITIZEN SETTINGS…</output></div>\n<div class=\"machine-grid\">\n<div class=\"specimen\" id=\"specimen\">\n<div class=\"hanger\"></div>\n<div class=\"stencil\" aria-hidden=\"true\"><i class=\"head\"></i><i class=\"body\"></i><i class=\"arm left\"></i><i class=\"arm right\"></i><i class=\"leg left\"></i><i class=\"leg right\"></i><i class=\"acid-mark\"></i></div>\n<p class=\"empty-instruction\">DESCRIBE A CITIZEN, SET ANY OPTIONAL FORGE DIALS, THEN RUN THE THREE-PLATE PRESS.</p>\n<img class=\"specimen-image\" id=\"specimenImage\" alt=\"Selected generated LANDVILLE citizen\">\n<div class=\"selection-mark\" id=\"selectionMark\">INSPECTION CHOICE —</div>\n</div>\n<div class=\"rack\">\n<div class=\"rack-head\"><b>THREE-SLOT OUTPUT RACK</b><span id=\"rackState\">EMPTY / WAITING FOR BRIEF</span></div>\n<div class=\"candidate-rack\" id=\"candidateRack\" aria-live=\"polite\" aria-busy=\"false\"></div>\n</div>\n</div>\n</section>\n<div class=\"workbench\">\n<section class=\"panel\" aria-labelledby=\"brief-title\">\n<header class=\"panel-head\"><h2 id=\"brief-title\">CITIZEN WORK ORDER</h2><span>PLAIN TEXT / NO SECRET PROMPTS</span></header>\n<div class=\"panel-body\">\n<label class=\"brief-label\" for=\"brief\">WHO SHOULD WALK OUT OF THE PRESS?<span class=\"counter\" id=\"briefCount\">0 / 280</span></label>\n<textarea id=\"brief\" maxlength=\"280\" aria-describedby=\"briefHint validation\"></textarea>\n<p class=\"input-hint\" id=\"briefHint\">Describe one full-body citizen, their work, clothing or character. Do not enter secrets, wallet keys or URLs.</p>\n<p class=\"validation\" id=\"validation\" role=\"alert\"></p>\n<div class=\"control-bank\">\n<div class=\"control-row\"><span class=\"control-label\">SILHOUETTE</span><div class=\"chips\" role=\"group\" aria-label=\"Silhouette\"><button type=\"button\" class=\"chip active\" data-group=\"silhouette\" data-value=\"\">NO PREFERENCE</button><button type=\"button\" class=\"chip\" data-group=\"silhouette\" data-value=\"wiry\">WIRY</button><button type=\"button\" class=\"chip\" data-group=\"silhouette\" data-value=\"compact\">COMPACT</button><button type=\"button\" class=\"chip\" data-group=\"silhouette\" data-value=\"barrel-built\">BARREL-BUILT</button></div></div>\n<div class=\"control-row\"><span class=\"control-label\">PRESENTATION</span><div class=\"chips\" role=\"group\" aria-label=\"Presentation\"><button type=\"button\" class=\"chip active\" data-group=\"presentation\" data-value=\"\">NEUTRAL</button><button type=\"button\" class=\"chip\" data-group=\"presentation\" data-value=\"masculine edge\">MASC EDGE</button><button type=\"button\" class=\"chip\" data-group=\"presentation\" data-value=\"feminine edge\">FEMME EDGE</button><button type=\"button\" class=\"chip\" data-group=\"presentation\" data-value=\"androgynous\">ANDROGYNOUS</button></div></div>\n<div class=\"control-row\"><span class=\"control-label\">RENDERING</span><div class=\"chips\" role=\"group\" aria-label=\"Rendering influence\"><button type=\"button\" class=\"chip active\" data-group=\"influence\" data-value=\"\">FORGE DECIDES</button><button type=\"button\" class=\"chip\" data-group=\"influence\" data-value=\"cute constructed\">CUTE BUILT</button><button type=\"button\" class=\"chip\" data-group=\"influence\" data-value=\"anime-influenced print\">ANIME PRINT</button><button type=\"button\" class=\"chip\" data-group=\"influence\" data-value=\"severe punk editorial\">PUNK SEVERE</button></div></div>\n<div class=\"control-row\"><span class=\"control-label\">CIVIC ROLE</span><div class=\"chips\" role=\"group\" aria-label=\"Civic role\"><button type=\"button\" class=\"chip active\" data-group=\"role\" data-value=\"\">UNASSIGNED</button><button type=\"button\" class=\"chip\" data-group=\"role\" data-value=\"alley electrician\">ALLEY ELECTRICIAN</button><button type=\"button\" class=\"chip\" data-group=\"role\" data-value=\"bridge inspector\">BRIDGE INSPECTOR</button><button type=\"button\" class=\"chip\" data-group=\"role\" data-value=\"scrap librarian\">SCRAP LIBRARIAN</button><button type=\"button\" class=\"chip\" data-group=\"role\" data-value=\"night canteen cook\">NIGHT CANTEEN COOK</button></div></div>\n<div class=\"control-row\"><span class=\"control-label\">SALVAGE</span><div class=\"chips\" role=\"group\" aria-label=\"Salvaged material\"><button type=\"button\" class=\"chip active\" data-group=\"material\" data-value=\"\">MIXED BIN</button><button type=\"button\" class=\"chip\" data-group=\"material\" data-value=\"riveted tin\">RIVETED TIN</button><button type=\"button\" class=\"chip\" data-group=\"material\" data-value=\"patched canvas\">PATCHED CANVAS</button><button type=\"button\" class=\"chip\" data-group=\"material\" data-value=\"oxidized copper\">OXIDIZED COPPER</button></div></div>\n<div class=\"control-row\"><span class=\"control-label\">TOOL</span><div class=\"chips\" role=\"group\" aria-label=\"Practical tool\"><button type=\"button\" class=\"chip active\" data-group=\"tool\" data-value=\"\">EMPTY HANDS</button><button type=\"button\" class=\"chip\" data-group=\"tool\" data-value=\"municipal wrench\">MUNICIPAL WRENCH</button><button type=\"button\" class=\"chip\" data-group=\"tool\" data-value=\"lamp hook\">LAMP HOOK</button><button type=\"button\" class=\"chip\" data-group=\"tool\" data-value=\"stamp press\">STAMP PRESS</button></div></div>\n<div class=\"control-row\"><span class=\"control-label\">MOOD</span><div class=\"chips\" role=\"group\" aria-label=\"Mood\"><button type=\"button\" class=\"chip active\" data-group=\"mood\" data-value=\"\">UNSPECIFIED</button><button type=\"button\" class=\"chip\" data-group=\"mood\" data-value=\"deadpan\">DEADPAN</button><button type=\"button\" class=\"chip\" data-group=\"mood\" data-value=\"quietly proud\">QUIETLY PROUD</button><button type=\"button\" class=\"chip\" data-group=\"mood\" data-value=\"mildly suspicious\">MILDLY SUSPICIOUS</button></div></div>\n<div class=\"control-row\"><span class=\"control-label\">DEFECT</span><div class=\"chips\" role=\"group\" aria-label=\"Mechanical defect\"><button type=\"button\" class=\"chip active\" data-group=\"defect\" data-value=\"\">FACTORY SOUND</button><button type=\"button\" class=\"chip\" data-group=\"defect\" data-value=\"stiff left knee\">STIFF LEFT KNEE</button><button type=\"button\" class=\"chip\" data-group=\"defect\" data-value=\"one squeaky shoulder\">SQUEAKY SHOULDER</button><button type=\"button\" class=\"chip\" data-group=\"defect\" data-value=\"crooked antenna\">CROOKED ANTENNA</button></div></div>\n</div>\n<div class=\"review\"><div class=\"review-head\"><span>VISIBLE GENERATION BRIEF</span><span class=\"summary-count\" id=\"summaryCount\">0 / 280</span></div><pre class=\"review-output\" id=\"summaryOutput\">Your plain-text work order will appear here.</pre></div>\n<div class=\"forge-actions\"><button type=\"button\" class=\"forge-button\" id=\"forgeButton\" disabled>FORGE THREE CITIZENS</button><p class=\"quota-note\"><b>HOST-ENFORCED LIMIT:</b> one successful batch of three per signed-in citizen, per module, per UTC week. Reopening can return that week's saved batch without another paid generation.</p></div>\n<div class=\"pending-box\" id=\"pendingBox\" role=\"status\"><i class=\"press-wheel\" aria-hidden=\"true\"></i><div><b>THE PORTRAIT PRESS IS WORKING</b><span id=\"pendingText\">LANDVILLE image generation may take a while. This is a waiting state, not a progress estimate.</span></div></div>\n<div class=\"batch-ticket\" id=\"batchTicket\"></div>\n<div class=\"notice\" id=\"forgeNotice\" role=\"alert\"></div>\n</div>\n</section>\n<aside class=\"panel world-panel\" aria-labelledby=\"world-title\">\n<header class=\"panel-head\"><h2 id=\"world-title\">WORLD INSPECTION DESK</h2><span>ONE PUBLIC RESIDENT</span></header>\n<div class=\"panel-body\">\n<div class=\"world-gauge\"><div class=\"lever-box\" aria-hidden=\"true\"><i class=\"lever-track\"></i><i class=\"lever\" id=\"lever\"></i></div><div><div class=\"world-status\" id=\"worldStatus\">CHECKING WORLD STATUS…</div><p class=\"world-copy\" id=\"worldDetail\">LANDVILLE is asking whether this citizen already has a public resident.</p></div></div>\n<div class=\"scrapy-stamp\" id=\"scrapyStamp\">ONE FACE APPROVED. THE OTHER TWO HAVE BEEN RETURNED TO COMMITTEE.</div>\n<div class=\"publish-note\"><b>BEFORE PUBLICATION:</b> LANDVILLE will display the selected generated image with your host-provided username in World. The LANDVILLE host supplies the username and opens its own confirmation dialog before publishing, replacing or removing the resident. This forge cannot bypass that confirmation, choose map coordinates, update other profile surfaces or connect to X.</div>\n<button type=\"button\" class=\"world-button\" id=\"publishButton\" hidden>PUBLISH MY CITIZEN TO WORLD</button>\n<button type=\"button\" class=\"world-button danger\" id=\"removeButton\" hidden>REMOVE FROM WORLD</button>\n<button type=\"button\" class=\"world-button secondary\" id=\"retryStatusButton\" hidden>RECHECK WORLD STATUS</button>\n<div class=\"notice\" id=\"worldNotice\" role=\"alert\"></div>\n<output class=\"storage-status\" id=\"storageStatus\" aria-live=\"polite\">RESTORING PRIVATE FORGE SETTINGS…</output>\n</div>\n</aside>\n</div>\n<footer class=\"limits\"><b>FORGE BOUNDARY:</b> generated image bytes remain managed by LANDVILLE's image bridge. This module stores only your brief, optional dial choices and selected image index. It cannot inspect the parent World page, force itself open, access wallets, call arbitrary servers or publish without the host confirmation.</footer>\n</main>\n<script>\n(function(){\n'use strict';\nconst RESPONSE='landville:capability-response';\nconst REQUEST='landville:capability-request';\nconst allowed={silhouette:['','wiry','compact','barrel-built'],presentation:['','masculine edge','feminine edge','androgynous'],influence:['','cute constructed','anime-influenced print','severe punk editorial'],role:['','alley electrician','bridge inspector','scrap librarian','night canteen cook'],material:['','riveted tin','patched canvas','oxidized copper'],tool:['','municipal wrench','lamp hook','stamp press'],mood:['','deadpan','quietly proud','mildly suspicious'],defect:['','stiff left knee','one squeaky shoulder','crooked antenna']};\nconst defaults={brief:'',silhouette:'',presentation:'',influence:'',role:'',material:'',tool:'',mood:'',defect:'',selectedIndex:null,hadBatch:false,generatedAt:null};\nlet state=Object.assign({},defaults);\nlet images=[];\nlet booting=true;\nlet generating=false;\nlet publishing=false;\nlet published=false;\nlet publishedIndex=null;\nlet worldAvailable=false;\nlet worldError='';\nlet saveTimer=0;\nlet pendingTimer=0;\nlet pendingStarted=0;\nlet requestSequence=0;\nlet serverConfirmedInvalidBatch=false;\nconst pending=new Map();\nconst $=id=>document.getElementById(id);\nconst brief=$('brief'),briefCount=$('briefCount'),validation=$('validation'),summaryOutput=$('summaryOutput'),summaryCount=$('summaryCount');\nconst forgeButton=$('forgeButton'),candidateRack=$('candidateRack'),rackState=$('rackState'),specimen=$('specimen'),specimenImage=$('specimenImage'),selectionMark=$('selectionMark');\nconst forgeNotice=$('forgeNotice'),pendingBox=$('pendingBox'),batchTicket=$('batchTicket'),topStatus=$('topStatus');\nconst publishButton=$('publishButton'),removeButton=$('removeButton'),retryStatusButton=$('retryStatusButton'),worldStatus=$('worldStatus'),worldDetail=$('worldDetail'),worldNotice=$('worldNotice'),storageStatus=$('storageStatus');\nconst lever=$('lever'),scrapyStamp=$('scrapyStamp');\nfunction nextRequestId(){return 'forge_'+Date.now().toString(36)+'_'+(++requestSequence).toString(36)}\nfunction sendRequest(request,timeout){return new Promise((resolve,reject)=>{const timer=setTimeout(()=>{pending.delete(request.requestId);reject(new Error('LANDVILLE did not answer this request in time. Your controls are unchanged.'))},timeout||20000);pending.set(request.requestId,{resolve,reject,timer});window.parent.postMessage(request,'*')})}\nwindow.addEventListener('message',event=>{if(event.source!==window.parent)return;const message=event.data;if(!message||message.type!==RESPONSE||typeof message.requestId!=='string')return;const task=pending.get(message.requestId);if(!task)return;pending.delete(message.requestId);clearTimeout(task.timer);if(message.ok===true)task.resolve(message.data||{});else task.reject(new Error(typeof message.error==='string'?message.error:'LANDVILLE rejected the request.'))});\nfunction storageGet(){return sendRequest({type:REQUEST,requestId:nextRequestId(),capability:'module.storage',input:{operation:'private.get',collection:'avatar_forge_state'}},16000)}\nfunction storageSet(data){return sendRequest({type:REQUEST,requestId:nextRequestId(),capability:'module.storage',input:{operation:'private.set',collection:'avatar_forge_state',data:data}},16000)}\nfunction imageGenerate(text){return sendRequest({type:REQUEST,requestId:nextRequestId(),capability:'module.image.generate',input:{operation:'generate',brief:text}},240000)}\nfunction worldStatusRequest(){return sendRequest({type:REQUEST,requestId:nextRequestId(),capability:'world.citizen.publish',input:{operation:'status'}},20000)}\nfunction worldPublish(index){return sendRequest({type:REQUEST,requestId:nextRequestId(),capability:'world.citizen.publish',input:{operation:'publish',imageIndex:index}},60000)}\nfunction worldUnpublish(){return sendRequest({type:REQUEST,requestId:nextRequestId(),capability:'world.citizen.publish',input:{operation:'unpublish'}},60000)}\nfunction safeState(value){const clean=Object.assign({},defaults);if(!value||typeof value!=='object')return clean;clean.brief=typeof value.brief==='string'?value.brief.slice(0,280):'';Object.keys(allowed).forEach(key=>{clean[key]=allowed[key].includes(value[key])?value[key]:''});clean.selectedIndex=[0,1,2].includes(value.selectedIndex)?value.selectedIndex:null;clean.hadBatch=value.hadBatch===true;clean.generatedAt=typeof value.generatedAt==='string'?value.generatedAt.slice(0,60):null;return clean}\nfunction snapshot(){return {brief:state.brief,silhouette:state.silhouette,presentation:state.presentation,influence:state.influence,role:state.role,material:state.material,tool:state.tool,mood:state.mood,defect:state.defect,selectedIndex:state.selectedIndex,hadBatch:state.hadBatch,generatedAt:state.generatedAt}}\nfunction controlsLocked(){return booting||generating||state.hadBatch||images.length===3||serverConfirmedInvalidBatch}\nfunction scheduleSave(){if(booting)return;clearTimeout(saveTimer);storageStatus.textContent='PRIVATE SETTINGS CHANGED / WAITING TO SAVE…';storageStatus.className='storage-status';saveTimer=setTimeout(saveState,550)}\nasync function saveState(){storageStatus.textContent='SAVING PRIVATE FORGE SETTINGS…';storageStatus.className='storage-status';try{await storageSet(snapshot());storageStatus.textContent='PRIVATE FORGE SETTINGS SAVED BY LANDVILLE.'}catch(error){storageStatus.textContent='SETTINGS REMAIN TEMPORARY: '+error.message;storageStatus.className='storage-status warn'}}\nfunction assembleBrief(){const raw=state.brief.trim();if(!raw)return '';const parts=[raw];const labels=[['silhouette','Silhouette'],['presentation','Presentation'],['influence','Rendering'],['role','Role'],['material','Salvage'],['tool','Tool'],['mood','Mood'],['defect','Defect']];labels.forEach(pair=>{if(state[pair[0]])parts.push(pair[1]+': '+state[pair[0]]+'.')});return parts.join(' ')}\nfunction setNotice(element,text,error){element.textContent=text||'';element.className='notice'+(text?' show':'')+(error?' error':'')}\nfunction updateReview(){state.brief=brief.value.slice(0,280);briefCount.textContent=state.brief.length+' / 280';const text=assembleBrief();summaryOutput.textContent=text||'Your plain-text work order will appear here.';summaryCount.textContent=text.length+' / 280';if(state.brief.length&&state.brief.trim().length===0)validation.textContent='The work order cannot contain only whitespace.';else if(text.length>280)validation.textContent='The assembled brief is '+text.length+' characters. Shorten the work order or clear optional dials until it fits 280.';else validation.textContent='';const usable=state.brief.trim().length>0&&text.length<=280;forgeButton.disabled=booting||generating||images.length===3||serverConfirmedInvalidBatch||!usable;if(images.length===3)forgeButton.textContent='THREE CITIZENS ON THE RACK';else if(serverConfirmedInvalidBatch)forgeButton.textContent='REOPEN TO RETRIEVE SAVED BATCH';else if(state.hadBatch)forgeButton.textContent=\"RETRIEVE THIS WEEK'S SAVED BATCH\";else forgeButton.textContent='FORGE THREE CITIZENS';scheduleSave()}\nfunction renderChips(){const locked=controlsLocked();brief.disabled=locked;document.querySelectorAll('.chip').forEach(button=>{const active=state[button.dataset.group]===button.dataset.value;button.classList.toggle('active',active);button.setAttribute('aria-pressed',active?'true':'false');button.disabled=locked})}\nfunction renderEmptyRack(){candidateRack.textContent='';for(let i=0;i<3;i++){const slot=document.createElement('div');slot.className='empty-slot';const label=document.createElement('b');label.textContent='IMAGE INDEX '+i;slot.appendChild(label);candidateRack.appendChild(slot)}}\nfunction renderCandidates(focusIndex){candidateRack.textContent='';images.forEach(item=>{const button=document.createElement('button');button.type='button';button.className='candidate'+(state.selectedIndex===item.index?' selected':'');button.dataset.index=String(item.index);button.setAttribute('aria-pressed',state.selectedIndex===item.index?'true':'false');button.setAttribute('aria-label','Select generated citizen image index '+item.index);const img=document.createElement('img');img.src=item.imageUrl;img.alt='Generated full-body LANDVILLE citizen choice, image index '+item.index;const footer=document.createElement('span');footer.className='candidate-footer';const name=document.createElement('b');name.textContent='IMAGE INDEX '+item.index;const meta=document.createElement('span');meta.className='candidate-meta';meta.textContent=state.selectedIndex===item.index?'SELECTED FOR INSPECTION':'SELECT THIS CITIZEN';footer.append(name,meta);button.append(img,footer);button.addEventListener('click',()=>selectCandidate(item.index));candidateRack.appendChild(button)});rackState.textContent='3 / 3 RASTER PLATES RECEIVED';renderSpecimen();if([0,1,2].includes(focusIndex)){setTimeout(()=>{const target=candidateRack.querySelector('[data-index=\"'+focusIndex+'\"]');if(target)target.focus()},0)}}\nfunction renderSpecimen(){const chosen=images.find(item=>item.index===state.selectedIndex);specimen.classList.toggle('has-image',Boolean(chosen));if(chosen){specimenImage.src=chosen.imageUrl;selectionMark.textContent='INSPECTION CHOICE / IMAGE INDEX '+chosen.index}else{specimenImage.removeAttribute('src');selectionMark.textContent='INSPECTION CHOICE —'}lever.classList.toggle('dropped',Boolean(chosen));scrapyStamp.classList.toggle('show',Boolean(chosen))}\nfunction selectCandidate(index){if(!images.some(item=>item.index===index))return;state.selectedIndex=index;renderCandidates(index);renderWorld();scheduleSave()}\nfunction renderWorld(){const selected=images.some(item=>item.index===state.selectedIndex);if(!worldAvailable){worldStatus.textContent='WORLD STATUS UNAVAILABLE';worldDetail.textContent=worldError||'LANDVILLE has not confirmed whether a public resident exists.';publishButton.hidden=true;removeButton.hidden=true;retryStatusButton.hidden=false;return}retryStatusButton.hidden=true;if(published){const replacement=selected&&publishedIndex!==state.selectedIndex;worldStatus.textContent='PUBLIC RESIDENT ACTIVE';worldDetail.textContent=replacement?'LANDVILLE confirms a resident is public. Image index '+state.selectedIndex+' is selected as a possible replacement.':publishedIndex===null?'LANDVILLE confirms a resident is visible in World.':'LANDVILLE confirms image index '+publishedIndex+' is visible in World with your username.';removeButton.hidden=false;removeButton.disabled=publishing;publishButton.hidden=!replacement;publishButton.disabled=publishing||!replacement;publishButton.textContent=replacement?'REPLACE WORLD RESIDENT WITH INDEX '+state.selectedIndex:'PUBLISH MY CITIZEN TO WORLD'}else{worldStatus.textContent='NOT PUBLISHED TO WORLD';worldDetail.textContent=selected?'Image index '+state.selectedIndex+' is selected. LANDVILLE will ask for confirmation before making it public.':'Select one returned image before publication becomes available.';removeButton.hidden=true;publishButton.hidden=!selected;publishButton.disabled=publishing||!selected;publishButton.textContent='PUBLISH MY CITIZEN TO WORLD'}}\nfunction startPending(){generating=true;pendingStarted=Date.now();candidateRack.setAttribute('aria-busy','true');pendingBox.classList.add('show');setNotice(forgeNotice,'',false);topStatus.textContent='PORTRAIT PRESS RUNNING / DO NOT DOUBLE-FEED';renderChips();updateReview();pendingTimer=setInterval(()=>{const elapsed=Math.floor((Date.now()-pendingStarted)/1000);const minutes=String(Math.floor(elapsed/60)).padStart(2,'0');const seconds=String(elapsed%60).padStart(2,'0');$('pendingText').textContent='WAITING '+minutes+':'+seconds+' — LANDVILLE image generation may take a while. This timer is elapsed time, not a progress estimate.'},1000)}\nfunction stopPending(){generating=false;clearInterval(pendingTimer);candidateRack.setAttribute('aria-busy','false');pendingBox.classList.remove('show');$('pendingText').textContent='LANDVILLE image generation may take a while. This is a waiting state, not a progress estimate.';renderChips();updateReview()}\nfunction validateBatch(data){if(!data||!Array.isArray(data.images)||data.images.length!==3)throw new Error('LANDVILLE confirmed a batch but did not return exactly three image choices.');const normalized=data.images.map(item=>({index:Number(item&&item.index),imageUrl:item&&typeof item.imageUrl==='string'?item.imageUrl:'',mimeType:item&&typeof item.mimeType==='string'?item.mimeType:''})).sort((a,b)=>a.index-b.index);if(normalized.map(item=>item.index).join(',')!=='0,1,2')throw new Error('LANDVILLE confirmed a batch without the required unique image indexes 0, 1 and 2.');if(normalized.some(item=>!/^data:image\\/(?:png|jpeg|webp);base64,/i.test(item.imageUrl)))throw new Error('LANDVILLE confirmed a batch with an unsupported raster image source.');return normalized}\nasync function forge(){const text=assembleBrief();if(!state.brief.trim()||text.length>280||generating||images.length===3||serverConfirmedInvalidBatch)return;startPending();try{const data=await imageGenerate(text);let received;try{received=validateBatch(data)}catch(error){serverConfirmedInvalidBatch=true;throw error}const wasCached=data.cached===true;if(!wasCached)state.selectedIndex=null;images=received;if(wasCached&&state.selectedIndex===null&&published&&[0,1,2].includes(publishedIndex))state.selectedIndex=publishedIndex;state.hadBatch=true;state.generatedAt=typeof data.generatedAt==='string'?data.generatedAt:null;batchTicket.textContent=(wasCached?\"THIS WEEK'S SAVED BATCH\":\"NEW BATCH FOR THIS UTC WEEK\")+(state.generatedAt?' / GENERATED '+state.generatedAt:'');batchTicket.classList.add('show');topStatus.textContent=wasCached?'SAVED WEEKLY BATCH RESTORED':'THREE CITIZENS FORGED / CHOOSE ONE';setNotice(forgeNotice,wasCached?'LANDVILLE returned the saved three-choice batch for this UTC week. No second generation was claimed.':'Three authoritative raster choices returned. Select exactly one image for World inspection.',false);renderCandidates();renderWorld();scheduleSave()}catch(error){topStatus.textContent=serverConfirmedInvalidBatch?'BATCH CONFIRMED / PLATES INCOMPLETE':'PORTRAIT PRESS STOPPED';const suffix=serverConfirmedInvalidBatch?' Do not run another forge request in this session; reopen the module to retrieve the host-saved batch.':' Your work order remains editable and no candidate has been fabricated.';setNotice(forgeNotice,error.message+suffix,true)}finally{stopPending()}}\nasync function checkWorldStatus(){if(publishing)return;publishing=true;retryStatusButton.disabled=true;setNotice(worldNotice,'CHECKING AUTHORITATIVE WORLD STATUS…',false);try{const data=await worldStatusRequest();if(typeof data.published!=='boolean')throw new Error('LANDVILLE returned an incomplete World status.');worldAvailable=true;worldError='';published=data.published;publishedIndex=[0,1,2].includes(data.selectedImageIndex)?data.selectedImageIndex:null;setNotice(worldNotice,'',false)}catch(error){worldAvailable=false;worldError=error.message;setNotice(worldNotice,error.message,true)}finally{publishing=false;retryStatusButton.disabled=false;renderWorld()}}\nasync function publish(){const index=state.selectedIndex;if(publishing||!worldAvailable||!images.some(item=>item.index===index))return;publishing=true;publishButton.disabled=true;setNotice(worldNotice,'WAITING FOR THE LANDVILLE HOST CONFIRMATION…',false);try{const data=await worldPublish(index);if(data.published!==true)throw new Error('LANDVILLE did not confirm that the resident is public.');worldAvailable=true;published=true;publishedIndex=[0,1,2].includes(data.selectedImageIndex)?data.selectedImageIndex:index;setNotice(worldNotice,'LANDVILLE CONFIRMED PUBLICATION. THE SELECTED IMAGE AND YOUR HOST-PROVIDED USERNAME ARE NOW PUBLIC IN WORLD.',false)}catch(error){setNotice(worldNotice,error.message,true)}finally{publishing=false;renderWorld()}}\nasync function unpublish(){if(publishing||!worldAvailable)return;publishing=true;removeButton.disabled=true;setNotice(worldNotice,'WAITING FOR THE LANDVILLE HOST CONFIRMATION…',false);try{const data=await worldUnpublish();if(data.published!==false)throw new Error('LANDVILLE did not confirm removal from World.');worldAvailable=true;published=false;publishedIndex=null;setNotice(worldNotice,'LANDVILLE CONFIRMED REMOVAL. YOUR PRIVATE FORGE SETTINGS REMAIN HERE.',false)}catch(error){setNotice(worldNotice,error.message,true)}finally{publishing=false;renderWorld()}}\nasync function restore(){topStatus.textContent='RESTORING CITIZEN SETTINGS…';const results=await Promise.allSettled([storageGet(),worldStatusRequest()]);if(results[0].status==='fulfilled'){const stored=results[0].value&&results[0].value.value;state=safeState(stored);brief.value=state.brief;storageStatus.textContent=stored?'PRIVATE FORGE SETTINGS RESTORED.':'NO SAVED FORGE SETTINGS YET.'}else{storageStatus.textContent='PRIVATE SETTINGS UNAVAILABLE: '+results[0].reason.message;storageStatus.className='storage-status warn'}if(results[1].status==='fulfilled'&&typeof results[1].value.published==='boolean'){const data=results[1].value;worldAvailable=true;published=data.published;publishedIndex=[0,1,2].includes(data.selectedImageIndex)?data.selectedImageIndex:null}else{worldAvailable=false;worldError=results[1].status==='rejected'?results[1].reason.message:'LANDVILLE returned an incomplete World status.';setNotice(worldNotice,'Publication controls remain unavailable until LANDVILLE reports authoritative status.',true)}booting=false;renderChips();updateReview();renderWorld();if(state.hadBatch){rackState.textContent='SAVED BATCH AVAILABLE FROM LANDVILLE';topStatus.textContent=\"READY TO RETRIEVE THIS WEEK'S BATCH\"}else topStatus.textContent='FORGE READY / AWAITING WORK ORDER'}\ndocument.querySelectorAll('.chip').forEach(button=>button.addEventListener('click',()=>{if(controlsLocked())return;const group=button.dataset.group,value=button.dataset.value;if(!allowed[group]||!allowed[group].includes(value))return;state[group]=value;renderChips();updateReview()}));brief.addEventListener('input',updateReview);forgeButton.addEventListener('click',forge);publishButton.addEventListener('click',publish);removeButton.addEventListener('click',unpublish);retryStatusButton.addEventListener('click',checkWorldStatus);renderEmptyRack();renderChips();updateReview();restore();\n})();\n</script>\n</body>\n</html>",
  "acceptance": [
    "Approved."
  ],
  "capabilities": {
    "storage": [
      {
        "name": "avatar_forge_state",
        "mode": "private",
        "description": "Stores the citizen's forge brief, optional control selections and selected image index; generated image bytes remain managed by the image bridge."
      }
    ],
    "imageGeneration": {
      "purpose": "Generate the signed-in citizen's weekly reviewed set of three original full-body LANDVILLE avatar choices for selection and World publication.",
      "visualDirection": "Create three distinct vertical full-body interpretations of the same citizen brief, readable in LANDVILLE's narrow World resident card. Each image must contain one complete head-to-boots figure with a visible face, hands and footwear; no cropped limbs, extra people, text, logos, interface frames or targeting circles. Ground the character in LANDVILLE's hand-built civic junkyard: patched workwear, punk-editorial collage, practical municipal equipment, oxidized salvage, soot and warm-paper tones, with sparing acid-lime accents. Use tactile weathered printmaking and constructed retro-industrial character design rather than glossy cyberpunk. Keep the background quiet—stained paper or a shallow scrapyard—so the silhouette remains clear. Honor requested silhouette, presentation, rendering influence, role, material, tool, mood and defect without stereotyping or inventing demographic traits. Make the choices materially different in pose, garment construction and salvage details while preserving the same requested character concept.",
      "maxImages": 3
    },
    "worldCitizen": {
      "purpose": "Publish the caller-selected generated avatar as the caller's public World resident beside the username supplied by LANDVILLE."
    }
  }
}

true;message='Write result unclear. Reloading the civic file…';render();try{const [privateResult,sharedResult]=await Promise.all([privateGet(),sharedList()]);profiles=cleanProfiles(sharedResult&&sharedResult.records);const saved=cleanState(privateResult&&privateResult.value);if(!saved)throw new Error('The private state could not be verified.');state=saved;syncPrefs();mode='ready';if(state.commitStatus==='published'){state=rollIfStale(state);syncPrefs();mode=state.recipes.length?'ready':'empty';busy=false;message='';render();if(publicationAttempt)celebrate();return}if(state.commitStatus==='publishing'){const match=matchingRecord(state.recipes[state.lockedIndex],state.weekKey);if(match){message='Locked public plate found. Finishing the private receipt…';render();await finishPublication(match.id,publicationAttempt);return}busy=false;message=originalError instanceof Error?originalError.message:'The locked publication needs a retry.';render();return}state=state.weekKey===currentWeek?state:blank(state.publicRecordId);syncPrefs();mode=state.recipes.length?'ready':'empty';busy=false;message=originalError instanceof Error?originalError.message:'The previous write was not confirmed.';render()}catch(error){busy=false;mode=signedOut(error)?'signedout':'error';message=error instanceof Error?error.message:'The civic state could not be reloaded.';render()}}prompt.addEventListener('input',()=>{prefs.prompt=prompt.value.slice(0,140);count.textContent=prompt.value.length+' / 140';message='';errorLine.textContent=''});chips.forEach(button=>button.addEventListener('click',()=>{if(button.disabled)return;prefs.prompt=prompt.value.slice(0,140);const key=button.dataset.style;prefs.styles[key]=!prefs.styles[key];render()}));presentationButtons.forEach(button=>button.addEventListener('click',()=>{if(button.disabled)return;prefs.prompt=prompt.value.slice(0,140);prefs.presentation=button.dataset.presentation;render()}));generate.addEventListener('click',async()=>{if(busy||!state||state.recipes.length)return;const text=normalize(prompt.value);if(text.length<4){message='Use at least four characters so the forge has something better than municipal fog.';render();prompt.focus();return}const next={schema:1,weekKey:currentWeek,prompt:text,styles:{...prefs.styles},presentation:prefs.presentation,recipes:makeRecipes(text,prefs.styles,prefs.presentation),selectedIndex:null,lockedIndex:null,commitStatus:'draft',publicRecordId:state.publicRecordId||((profiles.find(item=>item.ownedByViewer)||{}).id||'')};busy=true;message='Stamping all three recipes into private storage…';render();try{await privateSet(next);state=next;prefs.prompt=text;mode='ready';busy=false;message='';render()}catch(error){await recover(error,false)}});chooseButton.addEventListener('click',()=>{if(!state||state.selectedIndex===null||state.commitStatus!=='draft')return;confirmOpen=true;message='';render()});cancelButton.addEventListener('click',()=>{confirmOpen=false;render()});confirmButton.addEventListener('click',async()=>{if(busy||!state||state.selectedIndex===null||state.commitStatus!=='draft')return;const locked={...state,lockedIndex:state.selectedIndex,commitStatus:'publishing'};busy=true;confirmOpen=false;message='Saving the weekly lock before any public write…';render();try{await privateSet(locked);state=locked;busy=false;render();await publishLocked()}catch(error){await recover(error,true)}});resumeButton.addEventListener('click',publishLocked);retryButton.addEventListener('click',load);render();load()})()</script></body></html>",

{
  "version": 1,
  "proposalId": "LV-6",
  "title": "Avatar Forge Window",
  "html": "<!doctype html><html lang='en'><head><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Avatar Forge Window</title><style>:root{--void:#080907;--panel:#11130d;--paper:#d5bd8d;--acid:#c7ff00;--rust:#a94f28;--brass:#b89350;--line:rgba(213,189,141,.28);--muted:#9b8762}*{box-sizing:border-box}html{background:var(--void);color:var(--paper);font-family:Arial,Helvetica,sans-serif}body{margin:0;min-width:300px;background:radial-gradient(circle at 74% 2%,rgba(199,255,0,.09),transparent 27%),linear-gradient(135deg,#080907,#11120c 58%,#19130d);color:var(--paper)}button,input{font:inherit}button{cursor:pointer}.noise{position:fixed;inset:0;pointer-events:none;opacity:.045;background-image:radial-gradient(#d5bd8d .65px,transparent .75px);background-size:5px 5px}.app{position:relative;min-height:100vh;padding:12px}.topbar,.rack-panel,.console,.passport-panel{border:1px solid #5b4d30;background:#11130d;box-shadow:6px 6px #030402}.topbar{position:relative;min-height:64px;display:flex;align-items:center;gap:13px;padding:10px 14px}.topbar:before{content:'';position:absolute;left:22px;top:-7px;width:58px;height:7px;border:1px solid #5b4d30;border-bottom:0;background:#11130d}.lamp{width:11px;height:11px;flex:0 0 auto;border:1px solid var(--acid);background:var(--acid);box-shadow:0 0 14px rgba(199,255,0,.55)}.app[data-mode='loading'] .lamp{animation:pulse 1s steps(2,end) infinite}.app[data-mode='error'] .lamp,.app[data-mode='signedout'] .lamp{border-color:#df7855;background:#df7855;box-shadow:none}.kicker,.label{color:var(--acid);font:800 9px/1.35 monospace;letter-spacing:1.2px}.brand{min-width:0}.brand h1{margin:2px 0 0;font-size:clamp(28px,5vw,47px);line-height:.82;letter-spacing:-3px;font-weight:950}.top-state{margin-left:auto;max-width:290px;padding:8px 11px;border-left:2px solid var(--acid);background:#090b08;color:#b29c73;font:9px/1.45 monospace}.top-state b{display:block;margin-bottom:2px;color:var(--acid);font-size:10px}.forge{display:grid;grid-template-columns:minmax(0,1fr) minmax(270px,345px);gap:12px;margin-top:13px}.rack-panel{position:relative;min-height:410px;overflow:hidden;padding:10px 10px 14px;background:linear-gradient(90deg,#10120d,#1b1911 48%,#10120d)}.rack-panel:before{content:'';position:absolute;left:0;right:0;top:47px;height:11px;border-block:1px solid #6b5b38;background:linear-gradient(#302d21,#11130d);box-shadow:0 6px #070805}.rack-head{height:36px;display:flex;justify-content:space-between;gap:8px;color:var(--muted);font:9px monospace}.rack-head b{color:var(--acid);letter-spacing:1px}.rack{position:relative;z-index:2;height:345px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}.candidate{position:relative;min-width:0;height:326px;margin-top:13px;padding:6px 6px 8px;border:1px solid #6a5b39;border-radius:0;background:#191a12;color:var(--paper);box-shadow:4px 5px #050603;transition:transform .14s ease,border-color .14s ease}.candidate:before{content:'';position:absolute;left:50%;top:-18px;width:3px;height:17px;background:#a18752;box-shadow:0 -2px #080907}.candidate:after{content:'';position:absolute;left:50%;top:-22px;width:18px;height:9px;border:2px solid #a18752;border-bottom:0;transform:translateX(-50%)}.candidate:nth-child(2){margin-top:18px;transform:rotate(.7deg)}.candidate:nth-child(3){margin-top:10px;transform:rotate(-.7deg)}.candidate:hover:not(:disabled),.candidate[aria-pressed='true']{z-index:3;border-color:var(--acid);transform:translateY(-3px) rotate(-.5deg);box-shadow:5px 7px #354500}.candidate svg{display:block;width:100%;height:266px;border-bottom:1px solid #41402a;background:#090b08}.candidate-name,.candidate small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.candidate-name{margin-top:7px;color:var(--acid);font:900 10px/1 monospace}.candidate small{margin-top:5px;color:#94805c;font:9px/1 monospace}.candidate:disabled{cursor:not-allowed}.rack-foot{position:absolute;left:12px;right:12px;bottom:8px;height:6px;background:#67472f;box-shadow:0 2px #080907}.console{position:relative;padding:11px;background:linear-gradient(155deg,#18180f,#0d0f0a 72%)}.console:after{content:'';position:absolute;right:-1px;top:72px;width:7px;height:66px;background:var(--rust);box-shadow:-3px 8px #080907}.week{display:flex;justify-content:space-between;gap:8px;padding-bottom:9px;border-bottom:1px solid var(--line);color:var(--muted);font:9px monospace}.week b{color:var(--acid)}.preview{height:128px;margin:9px 0;border:1px solid #4c4329;background:radial-gradient(circle at 50% 38%,rgba(199,255,0,.18),transparent 57%),#090b08;display:grid;place-items:center;overflow:hidden}.preview svg{width:auto;height:146px}.preview-empty{display:grid;justify-items:center;gap:7px;color:#817153;text-align:center;font:9px monospace}.preview-empty i{width:42px;height:57px;border:1px dashed #697c36;position:relative}.preview-empty i:before{content:'';position:absolute;left:10px;top:-17px;width:20px;height:16px;border:1px dashed #697c36}.field-row{display:flex;justify-content:space-between;gap:8px;margin:9px 0 5px;color:#a18c66;font:9px monospace}.field-row span:last-child{color:#78694c}.prompt{width:100%;min-height:46px;border:1px solid #594c30;border-radius:0;background:#080a07;color:var(--paper);padding:10px;font:11px monospace}.hint,.boundary{color:#95815e;font:9px/1.45 monospace}.hint{margin-top:6px}.chip-row,.presentation{display:grid;gap:5px}.chip-row{grid-template-columns:repeat(4,1fr)}.presentation{grid-template-columns:repeat(2,1fr)}.chip,.presentation button{min-height:44px;border:1px solid #51472e;border-radius:0;background:#11130d;color:#9a865f;font:800 9px monospace}.chip[aria-pressed='true'],.presentation button[aria-checked='true']{border-color:var(--acid);background:#202711;color:var(--acid)}.lever,.primary,.secondary{min-height:44px;border-radius:0;font:900 10px monospace}.lever{width:100%;min-height:50px;margin-top:10px;border:1px solid var(--acid);background:var(--acid);color:#0c0e09;letter-spacing:.7px;box-shadow:5px 5px #3c4f00;display:flex;align-items:center;justify-content:center;gap:9px}.lever:before{content:'';width:12px;height:12px;border:3px solid #0c0e09;background:var(--rust);transform:rotate(45deg)}.state-copy{min-height:45px;margin:10px 0;padding:7px 0 7px 9px;border-left:2px solid var(--acid);color:#bba57c;font:9px/1.45 monospace}.state-copy strong{display:block;margin-bottom:2px;color:var(--acid);font-size:10px}.actions{display:grid;gap:7px;margin-top:10px}.primary,.secondary{padding:8px 10px}.primary{border:1px solid var(--acid);background:var(--acid);color:#0b0d08;box-shadow:4px 4px #354500}.secondary{border:1px solid #756442;background:#11130d;color:var(--paper)}button:disabled,input:disabled{cursor:not-allowed;opacity:.52}.candidate:focus-visible,.chip:focus-visible,.presentation button:focus-visible,.lever:focus-visible,.primary:focus-visible,.secondary:focus-visible,.prompt:focus-visible{outline:2px solid var(--acid);outline-offset:3px}.confirmation{margin-top:10px;padding:10px;border:1px solid var(--rust);background:#25170f}.confirmation h3{margin:0 0 5px;color:#ef9a70;font-size:13px}.confirmation p{margin:0 0 9px;color:#c1a47c;font:9px/1.5 monospace}.confirm-actions{display:grid;grid-template-columns:1fr 1fr;gap:7px}.error{min-height:20px;margin:9px 0 0;color:#e98a69;font:9px/1.45 monospace}.signature{display:flex;align-items:center;gap:9px;margin-top:10px;padding:9px;border:1px solid #7b633b;background:#1e1a10;color:#d6bc84;font:9px/1.4 monospace}.signature[hidden]{display:none}.bolt{width:20px;height:20px;flex:0 0 auto;border:2px solid #dfc06d;border-radius:50%;background:#7e5c28;box-shadow:inset 0 0 0 3px #392811;position:relative}.bolt:after{content:'';position:absolute;left:2px;right:2px;top:7px;height:2px;background:#171109}.signature.turn .bolt{animation:bolt-turn .65s cubic-bezier(.2,.8,.2,1)}.boundary{margin-top:11px;padding:8px 9px;border:1px dashed #625738}.passport-panel{margin-top:13px;padding:11px}.passport-head{display:flex;align-items:end;justify-content:space-between;gap:12px;padding-bottom:9px;border-bottom:1px solid var(--line)}.passport-head h2{margin:2px 0 0;font-size:24px;letter-spacing:-1.4px}.passport-head p{max-width:410px;margin:0;color:#97825f;text-align:right;font:9px/1.45 monospace}.passport-layout{display:grid;grid-template-columns:minmax(230px,315px) 1fr;gap:10px;margin-top:10px}.my-passport{min-height:190px;border:1px solid #5a4e31;background:#0d0f0a;padding:8px;display:grid;grid-template-columns:120px 1fr;gap:10px;align-items:center}.my-passport svg{width:120px;height:168px;background:#090b08}.identity small{color:var(--acid);font:9px monospace}.identity strong{display:block;margin:7px 0;font-size:18px;overflow-wrap:anywhere}.identity p{margin:0;color:#96825f;font:9px/1.5 monospace}.public-rack{min-height:190px;display:grid;grid-template-columns:repeat(4,minmax(90px,1fr));gap:7px}.public-card{min-width:0;border:1px solid #4f452d;background:#0e100b;padding:5px}.public-card svg{display:block;width:100%;height:137px;background:#090b08}.public-card b,.public-card small{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.public-card b{margin-top:6px;color:var(--acid);font:9px monospace}.public-card small{margin-top:4px;color:#817153;font:9px monospace}.public-empty{grid-column:1/-1;display:grid;place-items:center;min-height:190px;border:1px dashed #4d442d;color:#817153;text-align:center;font:10px/1.5 monospace}@keyframes pulse{50%{opacity:.25}}@keyframes bolt-turn{to{transform:rotate(360deg)}}@media(max-width:760px){.forge{grid-template-columns:minmax(0,1fr) 250px;gap:8px}.rack{gap:5px}.candidate{padding:4px}.passport-layout{grid-template-columns:230px 1fr}.public-rack{grid-template-columns:repeat(3,minmax(80px,1fr))}}@media(max-width:590px){.app{padding:8px}.topbar{align-items:flex-start}.top-state{max-width:175px;font-size:8px}.forge{grid-template-columns:1fr}.rack-panel{min-height:400px}.passport-head{display:block}.passport-head p{margin-top:7px;text-align:left}.passport-layout{grid-template-columns:1fr}.public-rack{grid-template-columns:repeat(2,minmax(110px,1fr))}.my-passport{grid-template-columns:108px 1fr}.my-passport svg{width:108px}.brand h1{font-size:34px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}</style></head><body><div class='noise' aria-hidden='true'></div><main class='app' id='app' data-mode='loading'><header class='topbar'><span class='lamp' aria-hidden='true'></span><div class='brand'><div class='kicker'>LANDVILLE CIVIC PORTRAIT WORKS / WINDOW 03</div><h1>AVATAR FORGE</h1></div><output class='top-state' id='topState' aria-live='polite'><b>LOADING CIVIC FILE</b><span>Checking the private lock and public passport rack.</span></output></header><section class='forge' aria-label='Weekly citizen avatar forge'><div class='rack-panel'><div class='rack-head'><b>THREE-BODY ISSUE RACK</b><span>ONE CHOICE / UTC WEEK</span></div><div class='rack' id='rack' aria-live='polite'></div><div class='rack-foot' aria-hidden='true'></div></div><aside class='console'><div class='week'><span>ISSUE WEEK</span><b id='weekLabel'>CALCULATING</b></div><div class='preview' id='preview' aria-label='Enlarged selected avatar preview'></div><label class='field-row' for='prompt'><span>CITIZEN BRIEF</span><span id='count'>0 / 140</span></label><input class='prompt' id='prompt' maxlength='140' autocomplete='off' spellcheck='true' disabled aria-describedby='promptHint'><div class='hint' id='promptHint'>Describe clothing, job, mood, colors or useful junk. This brief stays in private module storage.</div><div class='field-row'><span>BUILD BIASES</span><span>INDEPENDENT</span></div><div class='chip-row'><button class='chip' type='button' data-style='fit' aria-pressed='false' disabled>FIT</button><button class='chip' type='button' data-style='fat' aria-pressed='false' disabled>FAT</button><button class='chip' type='button' data-style='cute' aria-pressed='false' disabled>CUTE</button><button class='chip' type='button' data-style='anime' aria-pressed='false' disabled>ANIME</button></div><div class='field-row'><span>PRESENTATION</span><span>VISUAL ONLY</span></div><div class='presentation' role='radiogroup' aria-label='Avatar presentation'><button type='button' role='radio' data-presentation='masc' aria-checked='false' disabled>MASC</button><button type='button' role='radio' data-presentation='fem' aria-checked='false' disabled>FEM</button><button type='button' role='radio' data-presentation='androgynous' aria-checked='false' disabled>ANDROGYNOUS</button><button type='button' role='radio' data-presentation='random' aria-checked='true' disabled>RANDOM</button></div><button class='lever' id='generate' type='button' disabled>GENERATE THREE</button><div class='state-copy' id='stateCopy'><strong>LOADING</strong><span>The portrait press is finding your clipboard.</span></div><div class='actions'><button class='primary' id='choose' type='button' hidden>CHOOSE THIS CITIZEN</button><button class='secondary' id='resume' type='button' hidden>RETRY LOCKED PUBLICATION</button><button class='secondary' id='retry' type='button' hidden>RETRY CIVIC STORAGE</button></div><section class='confirmation' id='confirmation' hidden aria-labelledby='confirmTitle'><h3 id='confirmTitle'>LOCK THIS FACEPLATE?</h3><p>The selected option becomes your one chosen avatar for this UTC week. The other two return to the parts bin.</p><div class='confirm-actions'><button class='secondary' id='cancel' type='button'>CANCEL</button><button class='primary' id='confirm' type='button'>CONFIRM &amp; FILE</button></div></section><p class='error' id='error' role='alert'></p><div class='signature' id='signature' role='status' hidden><span class='bolt' aria-hidden='true'></span><span>Faceplate filed. Try not to become a statue.</span></div><p class='boundary'>MODULE PASSPORT ONLY — the forge can show the chosen avatar beside LANDVILLE’s host-issued username here. It cannot replace the native profile avatar, alter the outer World shell or publish to X.</p></aside></section><section class='passport-panel' aria-labelledby='passportTitle'><header class='passport-head'><div><div class='label'>PUBLIC REGISTRATION</div><h2 id='passportTitle'>CITIZEN PASSPORT RACK</h2></div><p>Latest bounded records from this module. Displayed usernames come only from host-issued public author labels.</p></header><div class='passport-layout'><article class='my-passport' id='myPassport'></article><div class='public-rack' id='publicRack' aria-live='polite'></div></div></section></main><script>(()=>{'use strict';const NS='http://www.w3.org/2000/svg';const app=document.getElementById('app'),topState=document.getElementById('topState'),rack=document.getElementById('rack'),preview=document.getElementById('preview'),weekLabel=document.getElementById('weekLabel'),prompt=document.getElementById('prompt'),count=document.getElementById('count'),generate=document.getElementById('generate'),stateCopy=document.getElementById('stateCopy'),chooseButton=document.getElementById('choose'),resumeButton=document.getElementById('resume'),retryButton=document.getElementById('retry'),confirmation=document.getElementById('confirmation'),cancelButton=document.getElementById('cancel'),confirmButton=document.getElementById('confirm'),errorLine=document.getElementById('error'),signature=document.getElementById('signature'),myPassport=document.getElementById('myPassport'),publicRack=document.getElementById('publicRack'),chips=[...document.querySelectorAll('[data-style]')],presentationButtons=[...document.querySelectorAll('[data-presentation]')];const palettes=[['#c7ff00','#8e4828','#d5bd8d','#242a18'],['#e8874d','#c7ff00','#c7ae79','#202417'],['#d5bd8d','#9e3f25','#c7ff00','#292219'],['#9dbb55','#d5bd8d','#b5542c','#172016'],['#c7ff00','#52736c','#d4b67c','#25291d'],['#d26e43','#d5bd8d','#c7ff00','#1b2015']];const bodies=['lean','broad','compact'],heads=['box','dome','visor'],outfits=['boiler suit','patched coat','salvage apron','civic jacket'],accessories=['wrench','clipboard','lamp','scrap satchel','measuring rod','tin bird'],presentations=['masc','fem','androgynous'],flags=['fit','fat','cute','anime'];let mode='loading',busy=false,state=null,profiles=[],message='',confirmOpen=false,sequence=0;let prefs={prompt:'',styles:{fit:false,fat:false,cute:false,anime:false},presentation:'random'};const pending=new Map();function weekKey(){const now=new Date(),date=new Date(Date.UTC(now.getUTCFullYear(),now.getUTCMonth(),now.getUTCDate())),day=date.getUTCDay()||7;date.setUTCDate(date.getUTCDate()+4-day);const year=date.getUTCFullYear(),start=new Date(Date.UTC(year,0,1)),week=Math.ceil((((date-start)/86400000)+1)/7);return year+'-W'+String(week).padStart(2,'0')}const currentWeek=weekKey();function bridge(input){const requestId='forge'+Date.now().toString(36)+(++sequence).toString(36);return new Promise((resolve,reject)=>{const timer=setTimeout(()=>{pending.delete(requestId);reject(new Error('Civic storage did not answer in time.'))},10000);pending.set(requestId,{resolve,reject,timer});window.parent.postMessage({type:'landville:capability-request',requestId,capability:'module.storage',input},'*')})}window.addEventListener('message',event=>{if(event.source!==window.parent)return;const data=event.data;if(!data||data.type!=='landville:capability-response'||typeof data.requestId!=='string')return;const item=pending.get(data.requestId);if(!item)return;clearTimeout(item.timer);pending.delete(data.requestId);data.ok?item.resolve(data.data):item.reject(new Error(typeof data.error==='string'?data.error:'Civic storage request failed.'))});function privateGet(){return bridge({operation:'private.get',collection:'avatar_forge_state'})}function privateSet(data){return bridge({operation:'private.set',collection:'avatar_forge_state',data})}function sharedList(){return bridge({operation:'shared.list',collection:'avatar_profiles',limit:50})}function sharedCreate(data){return bridge({operation:'shared.create',collection:'avatar_profiles',data})}function sharedUpdate(id,data){return bridge({operation:'shared.update',collection:'avatar_profiles',id,data})}function signedOut(error){const text=String(error&&error.message||error).toLowerCase();return text.includes('sign in')||text.includes('signed')||text.includes('auth')||text.includes('unauthorized')||text.includes('citizen session')}function normalize(value){return String(value||'').trim().split(/\\s+/).filter(Boolean).join(' ').slice(0,140)}function hash(text){let value=2166136261;for(let i=0;i<text.length;i++){value^=text.charCodeAt(i);value=Math.imul(value,16777619)}return value>>>0}function blank(recordId=''){return{schema:1,weekKey:currentWeek,prompt:'',styles:{fit:false,fat:false,cute:false,anime:false},presentation:'random',recipes:[],selectedIndex:null,lockedIndex:null,commitStatus:'draft',publicRecordId:recordId}}function makeRecipes(text,styles,presentation){const active=flags.filter(key=>styles[key]).join('+')||'plain',base=hash(currentWeek+'|'+text.toLowerCase()+'|'+active+'|'+presentation);return[0,1,2].map(index=>({v:1,seed:hash(base+'|'+index),body:bodies[(base+index)%bodies.length],head:heads[(Math.floor(base/7)+index)%heads.length],outfit:outfits[(Math.floor(base/13)+index)%outfits.length],accessory:accessories[(Math.floor(base/19)+index*2)%accessories.length],palette:(Math.floor(base/23)+index)%palettes.length,stance:index,presentation:presentation==='random'?presentations[(Math.floor(base/29)+index)%presentations.length]:presentation,flags:flags.filter(key=>styles[key])}))}function cleanRecipe(value){if(!value||value.v!==1||!Number.isFinite(Number(value.seed))||!bodies.includes(value.body)||!heads.includes(value.head)||!outfits.includes(value.outfit)||!accessories.includes(value.accessory)||!Number.isInteger(value.palette)||value.palette<0||value.palette>=palettes.length||!Number.isInteger(value.stance)||value.stance<0||value.stance>2||!presentations.includes(value.presentation))return null;return{v:1,seed:Number(value.seed)>>>0,body:value.body,head:value.head,outfit:value.outfit,accessory:value.accessory,palette:value.palette,stance:value.stance,presentation:value.presentation,flags:Array.isArray(value.flags)?value.flags.filter(item=>flags.includes(item)):[]}}function cleanState(value){if(!value||typeof value!=='object'||value.schema!==1)return null;const recipes=Array.isArray(value.recipes)?value.recipes.map(cleanRecipe).filter(Boolean):[];if(recipes.length!==0&&recipes.length!==3)return null;const selected=Number.isInteger(value.selectedIndex)&&value.selectedIndex>=0&&value.selectedIndex<3?value.selectedIndex:null,locked=Number.isInteger(value.lockedIndex)&&value.lockedIndex>=0&&value.lockedIndex<3?value.lockedIndex:null,status=['draft','publishing','published'].includes(value.commitStatus)?value.commitStatus:'draft';if(status!=='draft'&&(locked===null||recipes.length!==3))return null;return{schema:1,weekKey:String(value.weekKey||''),prompt:String(value.prompt||'').slice(0,140),styles:{fit:Boolean(value.styles&&value.styles.fit),fat:Boolean(value.styles&&value.styles.fat),cute:Boolean(value.styles&&value.styles.cute),anime:Boolean(value.styles&&value.styles.anime)},presentation:['masc','fem','androgynous','random'].includes(value.presentation)?value.presentation:'random',recipes,selectedIndex:selected,lockedIndex:locked,commitStatus:status,publicRecordId:typeof value.publicRecordId==='string'?value.publicRecordId:''}}function cleanProfiles(records){if(!Array.isArray(records))return[];return records.map(record=>{const recipe=cleanRecipe(record&&record.data&&record.data.recipe);if(!record||typeof record.id!=='string'||!recipe)return null;return{id:record.id,recipe,weekKey:String(record.data.weekKey||''),label:record.author&&typeof record.author.label==='string'?record.author.label.slice(0,80):'',ownedByViewer:record.ownedByViewer===true}}).filter(Boolean)}function recipeKey(recipe){return[recipe.seed,recipe.body,recipe.head,recipe.outfit,recipe.accesso
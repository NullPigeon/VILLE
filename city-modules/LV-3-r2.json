{
  "version": 1,
  "proposalId": "LV-3",
  "title": "Clubhouse",
  "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>LANDVILLE Clubhouse</title>\n<style>\n:root{--void:#080907;--ink:#12130e;--metal:#25231a;--metal2:#171810;--paper:#d5bd8d;--paper2:#bda475;--acid:#c7ff00;--rust:#a94d2b;--rust2:#71331f;--line:rgba(213,189,141,.28);--muted:#94815d;--danger:#e08360;--shadow:#030402}\n*{box-sizing:border-box}\nhtml{scroll-behavior:smooth;background:var(--void)}\nbody{min-width:300px;min-height:100dvh;margin:0;overflow-x:hidden;background:var(--void);color:var(--paper);font-family:Arial,Helvetica,sans-serif}\nbutton,input,textarea{font:inherit}\nbutton{cursor:pointer}\nbutton:disabled{cursor:not-allowed;opacity:.48}\ninput,textarea{width:100%;min-height:44px;border:1px solid #625637;border-radius:0;background:#090a07;color:#ead5a8;padding:10px 11px;outline:none;font:700 11px/1.45 monospace}\ntextarea{min-height:70px;resize:vertical}\ninput:focus,textarea:focus,button:focus-visible,a:focus-visible{outline:2px solid var(--acid);outline-offset:3px}\n::selection{background:var(--acid);color:#101108}\n.noise{position:fixed;z-index:100;inset:0;pointer-events:none;opacity:.055;background-image:url(\"data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.72' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E\")}\n.masthead{position:relative;z-index:2;display:grid;grid-template-columns:minmax(230px,.72fr) minmax(360px,1.28fr) auto;align-items:center;gap:20px;min-height:118px;padding:17px clamp(14px,3vw,36px) 15px;border-bottom:1px solid #685534;background:linear-gradient(180deg,#17160f,#0b0c08);box-shadow:0 7px 0 #050603}\n.masthead:before{content:\"\";position:absolute;inset:7px 12px auto;height:3px;background:linear-gradient(90deg,var(--rust),transparent 28%,var(--acid) 28% 34%,transparent 34% 76%,var(--rust) 76% 89%,transparent 89%)}\n.sign-wrap{position:relative;min-height:77px;display:flex;align-items:center}\n.sign{position:relative;display:inline-block;padding:10px 18px 8px;border:1px solid #876a3d;background:repeating-linear-gradient(93deg,#75532d 0,#75532d 12px,#6a4928 13px,#6a4928 25px);color:var(--acid);font-size:clamp(31px,4.6vw,60px);font-weight:950;line-height:.78;letter-spacing:-3px;text-shadow:3px 3px #273500;transform:rotate(-1.2deg);box-shadow:7px 7px #050603}\n.sign:before,.sign:after{content:\"\";position:absolute;width:7px;height:7px;border:1px solid #201a10;border-radius:50%;background:#b68a4e;box-shadow:inset 1px 1px #ebc77d}\n.sign:before{left:7px;top:7px}.sign:after{right:7px;bottom:7px}\n.sign small{display:block;margin-top:8px;color:#efe0b8;font:800 7px/1 monospace;letter-spacing:2.5px;text-shadow:none}\n.mast-copy{min-width:0}\n.mast-copy .eyebrow{margin:0 0 7px;color:var(--acid);font:900 8px monospace;letter-spacing:1.8px}\n.mast-copy h1{margin:0;font-size:clamp(21px,3vw,38px);line-height:.9;letter-spacing:-1.8px}\n.mast-copy p{max-width:650px;margin:8px 0 0;color:#a8936b;font:9px/1.45 monospace}\n.notice{min-width:222px;padding:10px 12px;border:1px dashed var(--acid);background:#11150c;color:var(--acid);font:900 8px/1.5 monospace;letter-spacing:.5px;transform:rotate(.5deg);box-shadow:4px 4px #050603}\n.notice b{display:block;color:#e2cc9f;font-size:9px}\n.session-meter{display:flex;gap:1px;margin-top:7px;background:#463d28}\n.session-meter span{flex:1;padding:5px;background:#0b0d08;text-align:center;color:#9b895f;font:7px monospace}\n.session-meter strong{display:block;color:var(--acid);font-size:10px}\n.truth-strip{position:sticky;z-index:31;top:0;min-height:32px;display:flex;align-items:center;justify-content:center;padding:6px 12px;border-bottom:1px solid #526128;background:#0c0e09f4;color:var(--acid);font:900 8px/1.2 monospace;letter-spacing:.75px;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;backdrop-filter:blur(8px)}\n.mobile-index{display:none;position:sticky;z-index:30;top:32px;grid-template-columns:repeat(3,1fr);border-bottom:1px solid #5c4b2e;background:#0d0f0aee;backdrop-filter:blur(8px)}\n.mobile-index a{min-height:44px;display:grid;place-items:center;border-right:1px solid #443b27;color:#9e8a62;text-decoration:none;font:800 8px monospace}\n.mobile-index a:last-child{border:0}.mobile-index a:focus,.mobile-index a:hover{color:var(--acid);background:#171c0f}\n.workbench{position:relative;z-index:1;display:grid;grid-template-columns:1.05fr 1.12fr .93fr;gap:9px;width:min(1500px,calc(100% - 24px));margin:20px auto 0;padding:9px 9px 24px;border:1px solid #715b36;background:repeating-linear-gradient(90deg,#342a1b 0,#342a1b 32px,#2b2317 33px,#2b2317 66px);box-shadow:9px 10px var(--shadow),inset 0 0 0 3px #16130d}\n.workbench:before{content:\"WELDED PUBLIC WORKBENCH · SESSION 01\";position:absolute;z-index:3;left:18px;bottom:3px;color:#a89064;font:7px monospace;letter-spacing:1.2px}\n.workbench:after{content:\"\";position:absolute;z-index:-1;left:3%;right:3%;bottom:-20px;height:22px;background:linear-gradient(90deg,#16130e 0 8%,transparent 8% 46%,#16130e 46% 54%,transparent 54% 92%,#16130e 92%);filter:drop-shadow(0 8px 0 #030402)}\n.bay{position:relative;min-width:0;min-height:590px;border:1px solid #5d4e30;background:#11130d;box-shadow:4px 4px #070805;overflow:hidden}\n.bay:before,.bay:after{content:\"\";position:absolute;z-index:2;width:7px;height:7px;border:1px solid #201b11;border-radius:50%;background:#a68049}\n.bay:before{left:6px;top:6px}.bay:after{right:6px;top:6px}\n.bay-head{position:relative;min-height:65px;padding:13px 14px 10px 50px;border-bottom:1px solid #51452b;background:#181910}\n.bay-number{position:absolute;left:13px;top:13px;width:27px;height:32px;display:grid;place-items:center;border:1px solid var(--acid);color:var(--acid);font:900 10px monospace;box-shadow:3px 3px #273500}\n.bay-head small{display:block;color:var(--acid);font:800 7px monospace;letter-spacing:1.6px}\n.bay-head h2{margin:4px 0 0;font-size:22px;line-height:.84;letter-spacing:-1px}\n.bay-status{position:absolute;right:13px;bottom:9px;color:#907b57;font:7px monospace}\n.bay-body{padding:13px}\n.topic-bay .bay-body{background:linear-gradient(100deg,transparent 0 96%,#6e3122 96%)}\n.poll-bay{border-color:#6d6339}.poll-bay .bay-head{background:#1d2113}\n.steps-bay .bay-body{min-height:524px;background-color:#11130d;background-image:radial-gradient(#5b5136 1px,transparent 1px);background-size:15px 15px}\n.civic-label{display:flex;justify-content:space-between;gap:8px;margin:0 0 5px;color:#aa966d;font:800 8px monospace}\n.civic-label b{color:var(--acid);font-weight:900}\n.field{margin-bottom:11px}\n.field-note{margin:5px 0 0;color:#796a4d;font:7px/1.35 monospace}\n.starter-stamp{display:inline-block;margin-bottom:10px;padding:5px 7px;border:1px solid #876f42;color:#bea878;background:#221c12;font:900 7px monospace;transform:rotate(-1deg)}\n.paper-stack{position:relative;display:grid;gap:7px;min-height:62px;margin:10px 0;padding:9px;border:1px solid #594a2e;background:#0b0d09}\n.paper-stack:before{content:\"VISIBLE NOTE STACK\";position:absolute;right:7px;top:-6px;padding:2px 4px;background:#0b0d09;color:#817052;font:7px monospace}\n.empty-paper{align-self:center;margin:auto;color:#77694d;text-align:center;font:8px/1.4 monospace}\n.note{position:relative;display:grid;grid-template-columns:1fr 44px;gap:7px;align-items:center;min-height:54px;padding:9px 5px 9px 11px;background:var(--paper);color:#1b1710;box-shadow:3px 3px #3d2e1a;transform:rotate(-.45deg)}\n.note:nth-child(even){background:#c9ae7d;transform:rotate(.55deg)}\n.note p{min-width:0;margin:0;overflow-wrap:anywhere;font:700 9px/1.4 monospace;white-space:pre-wrap}\n.icon-button{width:44px;height:44px;display:grid;place-items:center;border:1px solid currentColor;border-radius:0;background:transparent;color:inherit;font:950 16px monospace}\n.note .icon-button{color:#5d2c1d}\n.action-row{display:flex;gap:7px;flex-wrap:wrap;margin-top:10px}\n.btn{min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:0 12px;border:1px solid var(--acid);border-radius:0;background:#11130d;color:var(--acid);font-size:9px;font-weight:950;letter-spacing:.45px;box-shadow:3px 3px #050603}\n.btn:hover{background:#1e2710}.btn.primary{background:var(--acid);color:#101108;box-shadow:4px 4px #3e5200}.btn.rust{border-color:#a85738;color:#dd8b68}.btn.wide{width:100%}.btn svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:1.8}\n.inline-error{min-height:17px;margin:6px 0 0;color:var(--danger);font:800 8px/1.4 monospace}\n.inline-error:empty{min-height:0;margin:0}\n.poll-hardware{position:relative;padding:11px;border:1px solid #5a5f34;background:linear-gradient(135deg,#202218,#11130d 48%,#191b12);box-shadow:inset 0 0 24px #050603;transform-origin:50% 10%}\n.poll-hardware:before{content:\"\";position:absolute;right:7px;top:7px;width:31px;height:5px;background:var(--rust);box-shadow:-12px 8px var(--acid)}\n.poll-hardware.engage{animation:engage .34s cubic-bezier(.2,.8,.35,1)}\n@keyframes engage{0%{transform:translateY(-2px) rotate(-.35deg)}45%{transform:translateY(2px) rotate(.45deg);box-shadow:inset 0 0 24px #050603,0 0 18px rgba(199,255,0,.14)}100%{transform:none}}\n.poll-state{display:flex;align-items:center;gap:8px;margin-bottom:11px;padding-right:42px;color:#9c8a65;font:8px monospace}\n.poll-state i{width:9px;height:9px;border-radius:50%;background:#675d40;box-shadow:0 0 0 2px #1a1c12,0 0 0 3px #665a37}\n.poll-state.open i{background:var(--acid);box-shadow:0 0 12px var(--acid)}\n.poll-state.results i{background:#d9784f;box-shadow:0 0 10px #d9784f}\n.option-editor{display:grid;grid-template-columns:25px 1fr 44px;gap:6px;align-items:center;margin-bottom:7px}\n.option-editor .lever-index{height:34px;display:grid;place-items:center;border:1px solid #56642e;background:#0b0d08;color:var(--acid);font:900 8px monospace}\n.option-editor .icon-button{color:#a89168}\n.honesty{margin:10px 0;padding:9px;border-left:3px solid var(--rust);background:#21150f;color:#cba77f;font:800 7px/1.5 monospace}\n.room-question{margin:7px 0 12px;color:#ead4a5;font-size:18px;line-height:1.05;letter-spacing:-.6px;overflow-wrap:anywhere}\n.choice-bank{display:grid;gap:7px}\n.choice{position:relative;min-height:49px;display:grid;grid-template-columns:35px 1fr;align-items:center;gap:9px;padding:5px 10px 5px 5px;border:1px solid #615b39;background:#0c0e09;color:#c3ad83;text-align:left;font:900 9px/1.3 monospace}\n.choice:before{content:\"\";width:27px;height:35px;border:1px solid #52602c;background:linear-gradient(90deg,#171a11,#2a2b1b);box-shadow:inset 5px 0 #0a0b08}\n.choice:after{content:\"\";position:absolute;left:12px;top:15px;width:13px;height:17px;border:1px solid #8c8054;background:#494532;transition:transform .16s ease,background .16s ease}\n.choice[aria-pressed=\"true\"]{border-color:var(--acid);color:var(--acid);background:#1b2110}\n.choice[aria-pressed=\"true\"]:after{background:var(--acid);transform:translateY(-6px)}\n.choice span{overflow-wrap:anywhere}\n.tally{display:grid;gap:7px;margin-top:11px;padding-top:10px;border-top:1px solid #4a432c}\n.tally-row{display:grid;grid-template-columns:minmax(80px,1fr) 2fr auto;gap:7px;align-items:center;font:8px monospace}\n.tally-row b{min-width:0;overflow:hidden;color:#bca77d;text-overflow:ellipsis;white-space:nowrap}\n.tally-track{height:7px;background:#38372b;overflow:hidden}\n.tally-track i{display:block;height:100%;background:var(--acid);box-shadow:0 0 8px rgba(199,255,0,.45)}\n.tally-row span{color:var(--acid)}\n.tally-total{display:flex;justify-content:space-between;margin-top:4px;color:#887653;font:7px monospace}\n.result-note{margin:11px 0 0;padding:8px;border:1px dashed #7b6a40;color:#c2ab7f;font:8px/1.45 monospace}\n.task-rail{padding:10px;border:1px solid #5e5031;background:#0d0f0a;box-shadow:4px 4px #050603}\n.task-list{display:grid;gap:8px;margin-top:10px}\n.task{display:grid;grid-template-columns:44px minmax(0,1fr) 44px;gap:7px;align-items:center;min-height:58px;padding:6px;border:1px solid #655534;background:#17170f;color:#ccb78c;box-shadow:3px 3px #050603}\n.task.done{border-color:#657b32;background:#19200f;color:#9fb65b}\n.task-toggle{width:44px;height:44px;border:1px solid #66743a;background:#0b0d08;color:var(--acid);font-size:18px;font-weight:950}\n.task p{margin:0;overflow-wrap:anywhere;font:800 9px/1.4 monospace}\n.task p small{display:block;margin-top:3px;color:#75684c;font:7px monospace}\n.task .icon-button{color:#9b674e}\n.progress-case{margin:11px 0;padding:10px;border:1px solid #5b5333;background:#11130d}\n.progress-head{display:flex;justify-content:space-between;color:#95815e;font:8px monospace}\n.progress-head b{color:var(--acid)}\n.progress-track{height:8px;margin-top:7px;background:#343328;overflow:hidden}\n.progress-track i{display:block;height:100%;background:var(--acid);transition:width .22s ease}\n.brass-box{position:relative;display:grid;grid-template-columns:46px 1fr;gap:11px;align-items:center;margin-top:12px;padding:11px;border:2px solid #7f6236;background:linear-gradient(135deg,#3c2d18,#1a160f);box-shadow:5px 5px #050603;transform-origin:20% 50%}\n.brass-box:before,.brass-box:after{content:\"\";position:absolute;width:6px;height:6px;border-radius:50%;background:#c6974e;border:1px solid #332510}\n.brass-box:before{left:4px;top:4px}.brass-box:after{right:4px;bottom:4px}\n.lamp{width:38px;height:38px;display:grid;place-items:center;border:3px solid #7d643b;border-radius:50%;background:#29261b;box-shadow:inset 0 0 0 4px #11130d}\n.lamp i{width:17px;height:17px;border-radius:50%;background:#655f42}\n.brass-box.complete .lamp i{background:var(--acid);box-shadow:0 0 17px var(--acid)}\n.brass-label{display:block;color:#d3bd8d;font-size:10px;font-weight:950;line-height:1.05;letter-spacing:.2px}\n.brass-sub{display:block;margin-top:5px;color:#8f7c5b;font:7px/1.35 monospace}\n.brass-box.clunk{animation:clunk .48s cubic-bezier(.2,.9,.35,1)}\n@keyframes clunk{0%{transform:rotate(0)}35%{transform:translateY(2px) rotate(-2deg)}65%{transform:translateY(-1px) rotate(1deg)}100%{transform:rotate(1deg)}}\n.clear-zone{width:min(1500px,calc(100% - 24px));margin:28px auto 24px;display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 14px;border:1px dashed #76513c;background:#130f0b;color:#8e7b59}\n.clear-zone p{margin:0;font:8px/1.45 monospace}.clear-zone b{display:block;color:#be9d73;font-size:9px}\n.confirm-strip{position:fixed;z-index:80;left:50%;bottom:16px;width:min(700px,calc(100% - 24px));display:none;grid-template-columns:1fr auto auto;gap:9px;align-items:center;padding:12px;border:1px solid var(--acid);background:#11130df7;box-shadow:8px 8px #030402,0 0 32px rgba(199,255,0,.12);transform:translateX(-50%)}\n.confirm-strip.show{display:grid}.confirm-strip p{margin:0;color:#d4bd8f;font:8px/1.45 monospace}.confirm-strip b{display:block;color:var(--acid);font-size:9px}\n.visually-hidden{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}\n[hidden]{display:none!important}\n@media(max-width:920px){.masthead{grid-template-columns:auto 1fr}.notice{grid-column:1/-1;display:grid;grid-template-columns:1fr auto;align-items:center}.session-meter{min-width:260px;margin:0}.workbench{grid-template-columns:1fr 1.08fr .92fr}.bay-body{padding:10px}.bay-head{padding-left:45px}.bay-head h2{font-size:18px}.btn{padding-inline:9px;font-size:8px}.room-question{font-size:15px}}\n@media(max-width:540px){.masthead{grid-template-columns:1fr;gap:11px;padding-top:18px}.sign-wrap{min-height:58px}.sign{font-size:39px}.mast-copy h1{font-size:25px}.notice{grid-template-columns:1fr;min-width:0}.session-meter{min-width:0;margin-top:8px}.truth-strip{justify-content:flex-start}.mobile-index{display:grid}.workbench{display:block;width:calc(100% - 18px);margin-top:13px;padding:8px 8px 20px}.bay{min-height:0;margin-bottom:12px}.bay-head h2{font-size:22px}.steps-bay .bay-body{min-height:0}.clear-zone{width:calc(100% - 18px);align-items:stretch;flex-direction:column}.clear-zone .btn{width:100%}.confirm-strip{grid-template-columns:1fr 1fr}.confirm-strip p{grid-column:1/-1}.workbench:after{display:none}}\n@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.choice:after,.progress-track i{transition:none}.poll-hardware.engage{animation:none}.brass-box.clunk{animation:none;transform:rotate(1deg)}}\n</style>\n</head>\n<body>\n<div class=\"noise\" aria-hidden=\"true\"></div>\n<header class=\"masthead\">\n  <div class=\"sign-wrap\"><div class=\"sign\">CLUBHOUSE<small>DISCUSS · CHECK THE ROOM · PREPARE</small></div></div>\n  <div class=\"mast-copy\">\n    <p class=\"eyebrow\">COMMUNITY MEETING SHED / PASS-THE-SCREEN EDITION</p>\n    <h1>Put the question on the table.</h1>\n    <p>A facilitated workbench for drafting a topic, taking an informal room temperature, and leaving with practical next steps.</p>\n  </div>\n  <aside class=\"notice\" aria-label=\"Session limitations\">\n    <div><b>SESSION-LOCAL · RESETS WHEN CLOSED</b>NOT AN OFFICIAL LANDVILLE VOTE · NO IDENTITY, ELIGIBILITY, UNIQUENESS, OR GOVERNANCE AUTHORITY VERIFIED.</div>\n    <div class=\"session-meter\" aria-label=\"Session counts\">\n      <span><strong id=\"headNoteCount\">0</strong>NOTES</span>\n      <span><strong id=\"headResponseCount\">0</strong>RESPONSES</span>\n      <span><strong id=\"headStepCount\">0/3</strong>STEPS</span>\n    </div>\n  </aside>\n</header>\n<div class=\"truth-strip\" role=\"note\">SESSION-LOCAL · NOT AN OFFICIAL LANDVILLE VOTE · RESETS WHEN CLOSED</div>\n<nav class=\"mobile-index\" aria-label=\"Clubhouse sections\">\n  <a href=\"#topicBay\">01 OPEN TOPIC</a><a href=\"#pollBay\">02 ROOM CHECK</a><a href=\"#stepsBay\">03 NEXT STEPS</a>\n</nav>\n<main class=\"workbench\" aria-label=\"Clubhouse meeting workbench\">\n  <section class=\"bay topic-bay\" id=\"topicBay\" aria-labelledby=\"topicHeading\">\n    <header class=\"bay-head\"><span class=\"bay-number\">01</span><small>WARM-PAPER DISCUSSION BOARD</small><h2 id=\"topicHeading\">OPEN TOPIC</h2><span class=\"bay-status\" id=\"topicStatus\">STARTER QUESTION</span></header>\n    <div class=\"bay-body\">\n      <span class=\"starter-stamp\">EDITABLE STARTER · NOT COMMUNITY DATA</span>\n      <div class=\"field\">\n        <label class=\"civic-label\" for=\"topicTitle\"><span>TOPIC QUESTION</span><b>1–90</b></label>\n        <input id=\"topicTitle\" maxlength=\"90\" value=\"What should LANDVILLE decide together next?\" aria-describedby=\"topicTitleHelp\">\n        <p class=\"field-note\" id=\"topicTitleHelp\">Changes live only in this clubhouse session.</p>\n      </div>\n      <div class=\"field\">\n        <label class=\"civic-label\" for=\"topicContext\"><span>CONTEXT FOR THE ROOM</span><b>0–320</b></label>\n        <textarea id=\"topicContext\" maxlength=\"320\" aria-describedby=\"topicContextHelp\"></textarea>\n        <p class=\"field-note\" id=\"topicContextHelp\">Add the reason, constraint, or trade-off worth discussing.</p>\n      </div>\n      <div class=\"paper-stack\" id=\"noteStack\" aria-label=\"Session notes\"></div>\n      <div class=\"field\">\n        <label class=\"civic-label\" for=\"noteComposer\"><span>ADD A PAPER NOTE</span><b>1–240</b></label>\n        <textarea id=\"noteComposer\" maxlength=\"240\" aria-describedby=\"noteHelp\"></textarea>\n        <p class=\"field-note\" id=\"noteHelp\">Notes are visible only in this module instance or screen share.</p>\n        <p class=\"inline-error\" id=\"noteError\" role=\"alert\"></p>\n      </div>\n      <div class=\"action-row\">\n        <button class=\"btn primary\" id=\"addNote\" type=\"button\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14M5 12h14\"/></svg>ADD NOTE</button>\n        <button class=\"btn\" id=\"moveToPoll\" type=\"button\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M5 12h13M13 7l5 5-5 5\"/></svg>MOVE TO ROOM CHECK</button>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"bay poll-bay\" id=\"pollBay\" aria-labelledby=\"pollHeading\">\n    <header class=\"bay-head\"><span class=\"bay-number\">02</span><small>PASS-THE-SCREEN TEMPERATURE CHECK</small><h2 id=\"pollHeading\">ROOM CHECK</h2><span class=\"bay-status\">SESSION-LOCAL</span></header>\n    <div class=\"bay-body\">\n      <div class=\"poll-hardware\" id=\"pollHardware\">\n        <div class=\"poll-state\" id=\"pollState\"><i aria-hidden=\"true\"></i><b id=\"pollStateText\">SETUP · LEVERS PARKED</b></div>\n\n        <div id=\"pollSetup\">\n          <div class=\"field\">\n            <label class=\"civic-label\" for=\"pollQuestion\"><span>CHECK QUESTION</span><b>1–120</b></label>\n            <input id=\"pollQuestion\" maxlength=\"120\" aria-describedby=\"pollQuestionHelp\">\n            <p class=\"field-note\" id=\"pollQuestionHelp\">Use MOVE TO ROOM CHECK to copy the open topic, or write another question.</p>\n          </div>\n          <div class=\"civic-label\"><span>ROOM OPTIONS</span><b>2–4 · 1–60 EACH</b></div>\n          <p class=\"field-note\">Editable starter options only; these are not prior responses or community data.</p>\n          <div id=\"optionEditors\"></div>\n          <button class=\"btn\" id=\"addOption\" type=\"button\">+ ADD OPTION</button>\n          <p class=\"inline-error\" id=\"pollError\" role=\"alert\"></p>\n          <button class=\"btn primary wide\" id=\"openPoll\" type=\"button\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M7 20V9M17 20V4M4 20h16\"/></svg>OPEN ROOM CHECK</button>\n        </div>\n\n        <div id=\"pollOpen\" hidden>\n          <span class=\"starter-stamp\">ROOM CHECK · SESSION-LOCAL</span>\n          <h3 class=\"room-question\" id=\"openQuestion\"></h3>\n          <div class=\"choice-bank\" id=\"choiceBank\" aria-label=\"Room check options\"></div>\n          <p class=\"field-note\" id=\"participantPrompt\">Current participant: select one option. The choice can change before recording.</p>\n          <p class=\"inline-error\" id=\"selectionError\" role=\"alert\"></p>\n          <div class=\"honesty\"><b>NOT AN OFFICIAL LANDVILLE VOTE.</b><br>Pass the screen to one participant at a time. The module cannot verify who responds or whether anyone responds twice.</div>\n          <button class=\"btn primary wide\" id=\"recordResponse\" type=\"button\">RECORD ROOM RESPONSE</button>\n          <div id=\"liveTally\"></div>\n          <div class=\"action-row\">\n            <button class=\"btn\" id=\"closeResults\" type=\"button\">CLOSE TO RESULTS</button>\n            <button class=\"btn rust\" id=\"resetOpenPoll\" type=\"button\">RESET &amp; EDIT</button>\n          </div>\n        </div>\n\n        <div id=\"pollResults\" hidden>\n          <span class=\"starter-stamp\">ROOM CHECK · SESSION-LOCAL · NO GOVERNANCE EFFECT</span>\n          <h3 class=\"room-question\" id=\"resultQuestion\"></h3>\n          <div id=\"resultTally\"></div>\n          <p class=\"result-note\" id=\"resultInsight\"></p>\n          <div class=\"action-row\">\n            <button class=\"btn primary\" id=\"reopenPoll\" type=\"button\">REOPEN ROOM CHECK</button>\n            <button class=\"btn rust\" id=\"resetResults\" type=\"button\">RESET &amp; EDIT</button>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"bay steps-bay\" id=\"stepsBay\" aria-labelledby=\"stepsHeading\">\n    <header class=\"bay-head\"><span class=\"bay-number\">03</span><small>PEGBOARD / LEAVE WITH A PLAN</small><h2 id=\"stepsHeading\">NEXT STEPS</h2><span class=\"bay-status\" id=\"stepsStatus\">0 OF 3 DONE</span></header>\n    <div class=\"bay-body\">\n      <span class=\"starter-stamp\">EDITABLE STARTER CHECKLIST</span>\n      <div class=\"task-rail\">\n        <div class=\"field\">\n          <label class=\"civic-label\" for=\"taskComposer\"><span>ADD A NEXT STEP</span><b>1–120</b></label>\n          <input id=\"taskComposer\" maxlength=\"120\" aria-describedby=\"taskHelp\">\n          <p class=\"field-note\" id=\"taskHelp\">Keep it concrete enough that someone can do it after the meeting.</p>\n          <p class=\"inline-error\" id=\"taskError\" role=\"alert\"></p>\n        </div>\n        <button class=\"btn wide\" id=\"addTask\" type=\"button\">+ HANG STEP ON PEGBOARD</button>\n        <div class=\"task-list\" id=\"taskList\"></div>\n      </div>\n      <div class=\"progress-case\">\n        <div class=\"progress-head\"><span>MEETING EXIT PROGRESS</span><b id=\"progressText\">0 / 3</b></div>\n        <div class=\"progress-track\" aria-hidden=\"true\"><i id=\"progressBar\" style=\"width:0%\"></i></div>\n      </div>\n      <div class=\"brass-box\" id=\"brassBox\" aria-live=\"polite\">\n        <span class=\"lamp\" aria-hidden=\"true\"><i></i></span>\n        <div><strong class=\"brass-label\" id=\"brassLabel\">MEETING STILL LEAKING</strong><span class=\"brass-sub\" id=\"brassSub\">Complete every visible next step before adjourning.</span></div>\n      </div>\n    </div>\n  </section>\n</main>\n<section class=\"clear-zone\" aria-label=\"Clear clubhouse session\">\n  <p><b>END-OF-SHIFT BROOM</b>Clears the topic, paper notes, room counts, setup, and checklist. Nothing is stored elsewhere because the shed has no filing cabinet.</p>\n  <button class=\"btn rust\" id=\"requestClear\" type=\"button\">CLEAR CLUBHOUSE SESSION</button>\n</section>\n<div class=\"confirm-strip\" id=\"confirmStrip\" role=\"group\" aria-label=\"Confirm clearing clubhouse session\">\n  <p><b>CLEAR THE WHOLE WORKBENCH?</b>This cannot be undone. All session-local content and room responses will reset.</p>\n  <button class=\"btn rust\" id=\"confirmClear\" type=\"button\">YES, CLEAR IT</button>\n  <button class=\"btn\" id=\"cancelClear\" type=\"button\">CANCEL</button>\n</div>\n<div class=\"visually-hidden\" id=\"liveRegion\" aria-live=\"polite\" aria-atomic=\"true\"></div>\n<script>\n(function(){\n'use strict';\nvar serial=0;\nfunction uid(prefix){serial+=1;return prefix+'-'+serial;}\nfunction starterState(){\n  return {\n    topic:{title:'What should LANDVILLE decide together next?',context:'',notes:[]},\n    poll:{mode:'setup',question:'',options:[\n      {id:uid('option'),text:'Ready to draft the idea',count:0},\n      {id:uid('option'),text:'Keep discussing the trade-offs',count:0}\n    ],selectedId:null},\n    tasks:[\n      {id:uid('task'),text:'Summarize the question in one clear sentence',done:false,starter:true},\n      {id:uid('task'),text:'Name the main trade-offs or unknowns',done:false,starter:true},\n      {id:uid('task'),text:'Decide whether to draft an official proposal',done:false,starter:true}\n    ],\n    clearConfirm:false\n  };\n}\nvar state=starterState();\nvar lastAllComplete=false;\nfunction el(id){return document.getElementById(id);}\nfunction text(id,value){el(id).textContent=String(value);}\nfunction announce(message){text('liveRegion',message);}\nfunction clearError(id){text(id,'');}\nfunction totalResponses(){return state.poll.options.reduce(function(sum,item){return sum+item.count;},0);}\nfunction completedTasks(){return state.tasks.filter(function(item){return item.done;}).length;}\nfunction syncInputs(){\n  el('topicTitle').value=state.topic.title;\n  el('topicContext').value=state.topic.context;\n  el('pollQuestion').value=state.poll.question;\n  el('noteComposer').value='';\n  el('taskComposer').value='';\n  ['noteError','pollError','selectionError','taskError'].forEach(clearError);\n}\nfunction renderHeader(){\n  text('headNoteCount',state.topic.notes.length);\n  text('headResponseCount',totalResponses());\n  text('headStepCount',completedTasks()+'/'+state.tasks.length);\n  text('topicStatus',state.topic.notes.length===0?'STARTER QUESTION':state.topic.notes.length+' SESSION NOTE'+(state.topic.notes.length===1?'':'S'));\n}\nfunction makeDeleteButton(label,handler){\n  var button=document.createElement('button');\n  button.type='button';button.className='icon-button';button.setAttribute('aria-label',label);button.textContent='×';\n  button.addEventListener('click',handler);return button;\n}\nfunction renderNotes(){\n  var stack=el('noteStack');stack.textContent='';\n  if(!state.topic.notes.length){\n    var empty=document.createElement('p');empty.className='empty-paper';empty.textContent='No notes yet. The paper clips remain emotionally available.';stack.appendChild(empty);return;\n  }\n  state.topic.notes.forEach(function(item,index){\n    var article=document.createElement('article');article.className='note';\n    var copy=document.createElement('p');copy.textContent=item.text;\n    article.appendChild(copy);\n    article.appendChild(makeDeleteButton('Delete note '+(index+1),function(){\n      state.topic.notes=state.topic.notes.filter(function(note){return note.id!==item.id;});render();announce('Note deleted. '+state.topic.notes.length+' notes remain.');\n    }));stack.appendChild(article);\n  });\n}\nfunction renderOptionEditors(){\n  var box=el('optionEditors');box.textContent='';\n  state.poll.options.forEach(function(item,index){\n    var row=document.createElement('div');row.className='option-editor';\n    var number=document.createElement('span');number.className='lever-index';number.textContent=String(index+1).padStart(2,'0');\n    var input=document.createElement('input');input.maxLength=60;input.value=item.text;input.setAttribute('aria-label','Room option '+(index+1));\n    input.addEventListener('input',function(){item.text=input.value;clearError('pollError');});\n    row.appendChild(number);row.appendChild(input);\n    var remove=makeDeleteButton('Remove room option '+(index+1),function(){\n      if(state.poll.options.length<=2){text('pollError','Keep at least two option levers on the bank.');return;}\n      state.poll.options=state.poll.options.filter(function(option){return option.id!==item.id;});renderOptionEditors();clearError('pollError');announce('Room option removed.');\n    });\n    remove.disabled=state.poll.options.length<=2;row.appendChild(remove);box.appendChild(row);\n  });\n  el('addOption').disabled=state.poll.options.length>=4;\n}\nfunction createTally(containerId){\n  var container=el(containerId);container.textContent='';\n  var total=totalResponses();\n  var tally=document.createElement('div');tally.className='tally';\n  state.poll.options.forEach(function(item){\n    var percentage=total?Math.round(item.count/total*100):0;\n    var row=document.createElement('div');row.className='tally-row';\n    var label=document.createElement('b');label.textContent=item.text;\n    var track=document.createElement('div');track.className='tally-track';\n    var fill=document.createElement('i');fill.style.width=percentage+'%';track.appendChild(fill);\n    var amount=document.createElement('span');amount.textContent=item.count+' · '+percentage+'%';\n    row.appendChild(label);row.appendChild(track);row.appendChild(amount);tally.appendChild(row);\n  });\n  var footer=document.createElement('div');footer.className='tally-total';\n  var left=document.createElement('span');left.textContent='ROOM COUNT';\n  var right=document.createElement('b');right.textContent=String(total)+' RESPONSE'+(total===1?'':'S');\n  footer.appendChild(left);footer.appendChild(right);tally.appendChild(footer);container.appendChild(tally);\n}\nfunction renderPoll(){\n  var mode=state.poll.mode;\n  var stateLabel='SETUP · LEVERS PARKED';\n  if(mode==='open'){\n    stateLabel=state.poll.selectedId?'RESPONSE SELECTED · MAY CHANGE':totalResponses()>0?'RESPONSE RECORDED · NEXT PARTICIPANT':'OPEN · PASS THE SCREEN';\n  }else if(mode==='results'){\n    stateLabel='RESULTS · DISCUSS THE NUMBERS';\n  }\n  el('pollSetup').hidden=mode!=='setup';el('pollOpen').hidden=mode!=='open';el('pollResults').hidden=mode!=='results';\n  el('pollState').className='poll-state '+(mode==='open'?'open':mode==='results'?'results':'');\n  text('pollStateText',stateLabel);\n  if(mode==='setup'){renderOptionEditors();el('pollQuestion').value=state.poll.question;}\n  if(mode==='open'){\n    text('openQuestion',state.poll.question);\n    text('participantPrompt',state.poll.selectedId?'Choice selected. It can still be changed before recording.':'Current participant: select one option, then record the response.');\n    var bank=el('choiceBank');bank.textContent='';\n    state.poll.options.forEach(function(item){\n      var button=document.createElement('button');button.type='button';button.className='choice';button.setAttribute('aria-pressed',String(state.poll.selectedId===item.id));\n      var label=document.createElement('span');label.textContent=item.text;button.appendChild(label);\n      button.addEventListener('click',function(){state.poll.selectedId=item.id;clearError('selectionError');renderPoll();announce('Selected '+item.text+'. Choice can still be changed before recording.');});bank.appendChild(button);\n    });\n    if(totalResponses()>0){createTally('liveTally');}else{el('liveTally').textContent='';}\n  }\n  if(mode==='results'){\n    text('resultQuestion',state.poll.question);createTally('resultTally');\n    var total=totalResponses();var message='No responses were recorded. Reopen the room check or reset the setup.';\n    if(total>0){\n      var max=Math.max.apply(null,state.poll.options.map(function(item){return item.count;}));\n      var leaders=state.poll.options.filter(function(item){return item.count===max;});\n      message=leaders.length>1?'Discuss the split — the highest room count is tied. No consensus or approval is implied.':'Highest room count: '+leaders[0].text+'. This is a numerical lead only, not community approval.';\n    }\n    text('resultInsight',message);\n  }\n}\nfunction triggerPollEngage(){\n  var hardware=el('pollHardware');hardware.classList.remove('engage');void hardware.offsetWidth;hardware.classList.add('engage');\n  window.setTimeout(function(){hardware.classList.remove('engage');},500);\n}\nfunction triggerClunk(){\n  var box=el('brassBox');box.classList.remove('clunk');void box.offsetWidth;box.classList.add('clunk');\n  window.setTimeout(function(){box.classList.remove('clunk');},700);\n}\nfunction renderTasks(){\n  var list=el('taskList');list.textContent='';\n  if(!state.tasks.length){\n    var empty=document.createElement('p');empty.className='empty-paper';empty.textContent='No next steps are hanging here yet.';list.appendChild(empty);\n  }\n  state.tasks.forEach(function(item,index){\n    var row=document.createElement('article');row.className='task'+(item.done?' done':'');\n    var toggle=document.createElement('button');toggle.type='button';toggle.className='task-toggle';toggle.setAttribute('aria-label',(item.done?'Mark incomplete: ':'Complete: ')+item.text);toggle.setAttribute('aria-pressed',String(item.done));toggle.textContent=item.done?'✓':'□';\n    toggle.addEventListener('click',function(){item.done=!item.done;render();announce(item.done?'Next step completed.':'Next step marked incomplete.');});\n    var copy=document.createElement('p');copy.textContent=item.text;\n    var small=document.createElement('small');small.textContent=item.starter?'STARTER STEP':'SESSION STEP';copy.appendChild(small);\n    row.appendChild(toggle);row.appendChild(copy);row.appendChild(makeDeleteButton('Delete next step '+(index+1),function(){state.tasks=state.tasks.filter(function(task){return task.id!==item.id;});render();announce('Next step removed.');}));list.appendChild(row);\n  });\n  var complete=completedTasks();var total=state.tasks.length;var percent=total?Math.round(complete/total*100):0;var all=total>0&&complete===total;\n  text('progressText',complete+' / '+total);el('progressBar').style.width=percent+'%';text('stepsStatus',complete+' OF '+total+' DONE');\n  el('brassBox').classList.toggle('complete',all);\n  text('brassLabel',all?'ADJOURNED — SUSPICIOUSLY PRODUCTIVE.':'MEETING STILL LEAKING');\n  text('brassSub',all?'All visible next steps are complete. The mayor has checked twice.':'Complete every visible next step before adjourning.');\n  if(all&&!lastAllComplete){triggerClunk();announce('All next steps complete. Adjourned — suspiciously productive.');}\n  lastAllComplete=all;\n}\nfunction renderClear(){el('confirmStrip').classList.toggle('show',state.clearConfirm);}\nfunction render(){renderHeader();renderNotes();renderPoll();renderTasks();renderClear();}\nfunction pollSetupError(){\n  var question=state.poll.question.trim();\n  if(!question)return 'Add a room-check question before opening the levers.';\n  var complete=state.poll.options.filter(function(item){return item.text.trim().length>0;});\n  if(complete.length<2)return 'Complete at least two room options before opening the check.';\n  if(complete.length!==state.poll.options.length)return 'Complete or remove every blank option lever.';\n  var normalized=complete.map(function(item){return item.text.trim().toLowerCase();});\n  if(new Set(normalized).size!==normalized.length)return 'Each room option must be different. Duplicate levers confuse even the machinery.';\n  return '';\n}\nel('topicTitle').addEventListener('input',function(){state.topic.title=this.value;clearError('noteError');});\nel('topicContext').addEventListener('input',function(){state.topic.context=this.value;});\nel('pollQuestion').addEventListener('input',function(){state.poll.question=this.value;clearError('pollError');});\nel('addNote').addEventListener('click',function(){\n  var value=el('noteComposer').value.trim();\n  if(!value){text('noteError','Write a note before clipping it to the stack.');el('noteComposer').focus();return;}\n  state.topic.notes.push({id:uid('note'),text:value});el('noteComposer').value='';clearError('noteError');render();announce('Note added. '+state.topic.notes.length+' notes are now visible.');\n});\nel('moveToPoll').addEventListener('click',function(){\n  var title=state.topic.title.trim();\n  if(!title){text('noteError','The open topic needs a title before it can move to the room check.');el('topicTitle').focus();return;}\n  state.poll.question=title;state.poll.mode='setup';state.poll.selectedId=null;clearError('noteError');render();\n  el('pollQuestion').value=title;el('pollBay').scrollIntoView({behavior:'smooth',block:'start'});window.setTimeout(function(){el('pollQuestion').focus();},250);announce('Topic copied into the room-check question. No response was recorded.');\n});\nel('addOption').addEventListener('click',function(){\n  if(state.poll.options.length>=4)return;\n  state.poll.options.push({id:uid('option'),text:'',count:0});renderOptionEditors();announce('Blank room option added.');\n  var inputs=el('optionEditors').querySelectorAll('input');inputs[inputs.length-1].focus();\n});\nel('openPoll').addEventListener('click',function(){\n  state.poll.question=el('pollQuestion').value;var error=pollSetupError();\n  if(error){text('pollError',error);return;}\n  state.poll.question=state.poll.question.trim();state.poll.options.forEach(function(item){item.text=item.text.trim();});state.poll.selectedId=null;state.poll.mode='open';clearError('pollError');render();triggerPollEngage();announce('Room check opened. It is session-local and not an official vote.');\n});\nel('recordResponse').addEventListener('click',function(){\n  if(!state.poll.selectedId){text('selectionError','Select one option for the current participant before recording.');return;}\n  var selected=state.poll.options.find(function(item){return item.id===state.poll.selectedId;});\n  if(!selected){text('selectionError','That option is no longer available. Select another.');return;}\n  selected.count+=1;state.poll.selectedId=null;clearError('selectionError');render();announce('Room response recorded locally. Room count is now '+totalResponses()+'. Pass the screen to the next participant.');\n});\nel('closeResults').addEventListener('click',function(){state.poll.mode='results';state.poll.selectedId=null;render();announce('Room check closed to numerical results. No official vote occurred.');});\nfunction resetPoll(){\n  state.poll.mode='setup';state.poll.selectedId=null;state.poll.options.forEach(function(item){item.count=0;});render();el('pollQuestion').focus();announce('Room-check responses cleared. Setup is editable again.');\n}\nel('resetOpenPoll').addEventListener('click',resetPoll);el('resetResults').addEventListener('click',resetPoll);\nel('reopenPoll').addEventListener('click',function(){state.poll.mode='open';state.poll.selectedId=null;render();triggerPollEngage();announce('Room check reopened with the existing session counts.');});\nel('addTask').addEventListener('click',function(){\n  var value=el('taskComposer').value.trim();\n  if(!value){text('taskError','Write a concrete next step before hanging it on the pegboard.');el('taskComposer').focus();return;}\n  state.tasks.push({id:uid('task'),text:value,done:false,starter:false});el('taskComposer').value='';clearError('taskError');render();announce('Next step added.');\n});\nel('requestClear').addEventListener('click',function(){state.clearConfirm=true;renderClear();window.setTimeout(function(){el('confirmClear').focus();},0);announce('Clear-session confirmation opened.');});\nel('cancelClear').addEventListener('click',function(){state.clearConfirm=false;renderClear();el('requestClear').focus();announce('Clear session cancelled.');});\nel('confirmClear').addEventListener('click',function(){\n  state=starterState();lastAllComplete=false;syncInputs();render();el('topicTitle').focus();announce('Clubhouse session cleared and returned to the editable starter state.');\n});\ndocument.addEventListener('keydown',function(event){\n  if(event.key==='Escape'&&state.clearConfirm){state.clearConfirm=false;renderClear();el('requestClear').focus();announce('Clear session cancelled.');}\n});\nel('noteComposer').addEventListener('input',function(){clearError('noteError');});el('taskComposer').addEventListener('input',function(){clearError('taskError');});\nsyncInputs();render();\n})();\n</script>\n</body>\n</html>",
  "acceptance": [
    "Keep our main website design and UI"
  ]
}

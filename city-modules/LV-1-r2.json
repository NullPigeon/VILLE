{
  "version": 1,
  "proposalId": "LV-1",
  "title": "VLAD TENEV PORTRAIT",
  "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<title>LANDVILLE — Vlad Tenev Portrait</title>\n<style>\n  :root {\n    --void: #090b09;\n    --black: #10130f;\n    --rust: #8c321f;\n    --rust-bright: #c34b29;\n    --green: #9cff00;\n    --bone: #dfd8bd;\n  }\n\n  * { box-sizing: border-box; }\n\n  html, body {\n    min-height: 100%;\n    margin: 0;\n  }\n\n  body {\n    display: grid;\n    place-items: center;\n    padding: clamp(18px, 5vw, 52px);\n    overflow-x: hidden;\n    background:\n      radial-gradient(circle at 50% 30%, rgba(156, 255, 0, .07), transparent 34rem),\n      repeating-linear-gradient(0deg, rgba(255, 255, 255, .018) 0 1px, transparent 1px 4px),\n      var(--void);\n    color: var(--bone);\n    font-family: \"Courier New\", Courier, monospace;\n  }\n\n  button { font: inherit; }\n  [hidden] { display: none !important; }\n\n  .svg-defs {\n    position: absolute;\n    width: 0;\n    height: 0;\n    overflow: hidden;\n  }\n\n  .module {\n    position: relative;\n    isolation: isolate;\n    width: min(100%, 760px);\n    padding: clamp(14px, 3vw, 28px);\n    border: 2px solid var(--rust);\n    background: linear-gradient(145deg, rgba(22, 27, 20, .97), rgba(7, 9, 7, .99));\n    box-shadow: 10px 10px 0 #35150f, 0 0 42px rgba(156, 255, 0, .09);\n  }\n\n  .module::before,\n  .module::after {\n    position: absolute;\n    z-index: -1;\n    content: \"\";\n    pointer-events: none;\n  }\n\n  .module::before {\n    inset: 8px;\n    border: 1px dashed rgba(156, 255, 0, .27);\n  }\n\n  .module::after {\n    top: -5px;\n    right: 12%;\n    width: 70px;\n    height: 8px;\n    background: var(--green);\n  }\n\n  .masthead {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: 16px;\n    margin-bottom: 14px;\n    text-transform: uppercase;\n  }\n\n  .eyebrow {\n    margin: 0;\n    color: var(--green);\n    font-size: clamp(.7rem, 2vw, .84rem);\n    letter-spacing: .18em;\n  }\n\n  .signal {\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    color: #aab3a0;\n    font-size: .68rem;\n    letter-spacing: .12em;\n    white-space: nowrap;\n  }\n\n  .signal-dot {\n    width: 8px;\n    height: 8px;\n    border-radius: 50%;\n    background: var(--green);\n    box-shadow: 0 0 12px var(--green);\n    animation: pulse 1.8s steps(2, end) infinite;\n  }\n\n  .portrait-button {\n    position: relative;\n    display: block;\n    width: 100%;\n    padding: 0;\n    overflow: hidden;\n    border: 1px solid #687759;\n    border-radius: 0;\n    appearance: none;\n    background: #050705;\n    color: inherit;\n    cursor: zoom-in;\n    box-shadow: inset 0 0 0 6px #0d110c;\n  }\n\n  .portrait-button:focus-visible,\n  .close:focus-visible {\n    outline: 3px solid var(--green);\n    outline-offset: 4px;\n  }\n\n  .portrait-button:hover .portrait-art,\n  .portrait-button:focus-visible .portrait-art {\n    filter: saturate(1.2) contrast(1.08);\n    transform: scale(1.012);\n  }\n\n  .portrait-art {\n    display: block;\n    width: 100%;\n    height: auto;\n    aspect-ratio: 16 / 10;\n    transition: transform .18s ease, filter .18s ease;\n  }\n\n  .portrait-button::after {\n    position: absolute;\n    right: 10px;\n    bottom: 10px;\n    padding: 6px 8px;\n    border-left: 3px solid var(--green);\n    background: rgba(5, 7, 5, .9);\n    color: var(--green);\n    content: \"CLICK TO ENLARGE // CEREMONIAL ZOOM\";\n    font-size: clamp(.56rem, 1.8vw, .72rem);\n    letter-spacing: .08em;\n  }\n\n  .scanlines {\n    position: absolute;\n    inset: 0;\n    background: repeating-linear-gradient(0deg, transparent 0 3px, rgba(0, 0, 0, .22) 3px 5px);\n    pointer-events: none;\n    mix-blend-mode: multiply;\n  }\n\n  .caption {\n    display: grid;\n    grid-template-columns: minmax(0, 1fr) auto;\n    gap: 18px;\n    align-items: end;\n    padding: 18px 4px 2px;\n  }\n\n  h1 {\n    margin: 0;\n    color: var(--bone);\n    font-size: clamp(1.5rem, 6vw, 3.5rem);\n    line-height: .9;\n    letter-spacing: -.06em;\n    text-transform: uppercase;\n    text-shadow: 3px 0 var(--rust), -2px 0 rgba(156, 255, 0, .55);\n  }\n\n  .subtitle {\n    margin: 8px 0 0;\n    color: #aab3a0;\n    font-size: clamp(.67rem, 2vw, .82rem);\n    letter-spacing: .1em;\n    text-transform: uppercase;\n  }\n\n  .seal {\n    display: grid;\n    place-items: center;\n    width: 68px;\n    height: 68px;\n    border: 1px solid var(--rust-bright);\n    color: var(--green);\n    font-size: .72rem;\n    font-weight: 900;\n    line-height: 1;\n    text-align: center;\n    transform: rotate(5deg);\n    box-shadow: inset 0 0 16px rgba(195, 75, 41, .2);\n  }\n\n  .modal {\n    position: fixed;\n    inset: 0;\n    z-index: 20;\n    display: grid;\n    place-items: center;\n    padding: clamp(12px, 3vw, 34px);\n    overflow: auto;\n    background: rgba(0, 0, 0, .94);\n  }\n\n  .modal-panel {\n    position: relative;\n    width: min(1100px, 100%);\n    max-height: calc(100dvh - 24px);\n    padding: clamp(8px, 2vw, 18px);\n    border: 2px solid var(--green);\n    background: #070907;\n    box-shadow: 12px 12px 0 var(--rust), 0 0 80px rgba(156, 255, 0, .18);\n  }\n\n  .modal-art {\n    display: block;\n    width: 100%;\n    height: auto;\n    max-height: calc(100dvh - 60px);\n    object-fit: contain;\n    background: #050705;\n  }\n\n  .close {\n    position: absolute;\n    top: 10px;\n    right: 10px;\n    z-index: 2;\n    min-width: 44px;\n    min-height: 44px;\n    padding: 0;\n    border: 2px solid var(--green);\n    border-radius: 0;\n    background: #0a0c09;\n    color: var(--green);\n    cursor: pointer;\n    font-size: 1.45rem;\n    font-weight: 900;\n    line-height: 1;\n    box-shadow: 4px 4px 0 var(--rust);\n  }\n\n  .close:hover {\n    background: var(--green);\n    color: var(--void);\n  }\n\n  .visually-hidden {\n    position: absolute;\n    width: 1px;\n    height: 1px;\n    padding: 0;\n    margin: -1px;\n    overflow: hidden;\n    clip: rect(0 0 0 0);\n    white-space: nowrap;\n    border: 0;\n  }\n\n  @keyframes pulse { 50% { opacity: .32; } }\n\n  @keyframes jitter {\n    0%, 88%, 100% { transform: translate(0); }\n    90% { transform: translate(5px, -1px); }\n    92% { transform: translate(-4px, 2px); }\n    94% { transform: translate(2px, 0); }\n  }\n\n  .glitch-group { animation: jitter 4.5s steps(1, end) infinite; }\n\n  @media (max-width: 520px) {\n    body { padding: 12px; }\n    .module { box-shadow: 6px 6px 0 #35150f; }\n    .caption { grid-template-columns: 1fr; }\n    .seal { width: 100%; height: 34px; transform: none; }\n    .signal-text { display: none; }\n    .portrait-button::after { right: auto; bottom: 8px; left: 8px; }\n    .modal-panel { box-shadow: 6px 6px 0 var(--rust); }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    *, *::before, *::after {\n      animation: none !important;\n      scroll-behavior: auto !important;\n      transition: none !important;\n    }\n  }\n</style>\n</head>\n<body>\n<svg class=\"svg-defs\" aria-hidden=\"true\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\">\n  <symbol id=\"portraitArtwork\" viewBox=\"0 0 960 600\">\n    <defs>\n      <linearGradient id=\"portraitBg\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n        <stop offset=\"0\" stop-color=\"#161b13\"/>\n        <stop offset=\".52\" stop-color=\"#080a08\"/>\n        <stop offset=\"1\" stop-color=\"#31130d\"/>\n      </linearGradient>\n      <linearGradient id=\"portraitSkin\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n        <stop offset=\"0\" stop-color=\"#dcc4a0\"/>\n        <stop offset=\".5\" stop-color=\"#ad7c5b\"/>\n        <stop offset=\"1\" stop-color=\"#704631\"/>\n      </linearGradient>\n      <linearGradient id=\"portraitCoat\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">\n        <stop offset=\"0\" stop-color=\"#242b22\"/>\n        <stop offset=\"1\" stop-color=\"#090b09\"/>\n      </linearGradient>\n      <filter id=\"portraitGlow\" x=\"-50%\" y=\"-50%\" width=\"200%\" height=\"200%\">\n        <feGaussianBlur stdDeviation=\"7\" result=\"blur\"/>\n        <feMerge>\n          <feMergeNode in=\"blur\"/>\n          <feMergeNode in=\"SourceGraphic\"/>\n        </feMerge>\n      </filter>\n      <clipPath id=\"portraitFaceClip\">\n        <path d=\"M399 192Q474 139 553 189L548 314Q533 391 478 418Q419 392 398 316Z\"/>\n      </clipPath>\n    </defs>\n\n    <rect width=\"960\" height=\"600\" fill=\"url(#portraitBg)\"/>\n    <path d=\"M20 519V87h110v432M830 519V87h110v432\" fill=\"none\" stroke=\"#8c321f\" stroke-width=\"18\"/>\n    <path d=\"M49 488V118h52v370M859 488V118h52v370\" fill=\"none\" stroke=\"#c34b29\" stroke-width=\"3\"/>\n    <path d=\"M118 92L202 38h556l84 54M118 516l84 49h556l84-49\" fill=\"none\" stroke=\"#9cff00\" stroke-width=\"3\" stroke-dasharray=\"18 10\" opacity=\".65\"/>\n    <circle cx=\"480\" cy=\"282\" r=\"221\" fill=\"none\" stroke=\"#26361e\" stroke-width=\"34\"/>\n    <circle cx=\"480\" cy=\"282\" r=\"211\" fill=\"none\" stroke=\"#9cff00\" stroke-width=\"2\" stroke-dasharray=\"2 17\" filter=\"url(#portraitGlow)\"/>\n    <path d=\"M480 42v64M480 458v101M238 282h91M631 282h92\" stroke=\"#9cff00\" stroke-width=\"4\"/>\n    <path d=\"M252 113l65 65M643 390l65 65M708 113l-65 65M317 390l-65 65\" stroke=\"#8c321f\" stroke-width=\"7\"/>\n\n    <g opacity=\".72\" fill=\"#9cff00\">\n      <rect x=\"155\" y=\"156\" width=\"75\" height=\"7\"/>\n      <rect x=\"181\" y=\"170\" width=\"106\" height=\"3\"/>\n      <rect x=\"691\" y=\"425\" width=\"113\" height=\"7\"/>\n      <rect x=\"658\" y=\"439\" width=\"77\" height=\"3\"/>\n      <rect x=\"113\" y=\"344\" width=\"151\" height=\"4\"/>\n      <rect x=\"747\" y=\"211\" width=\"98\" height=\"4\"/>\n    </g>\n\n    <g class=\"glitch-group\">\n      <path d=\"M282 600Q301 469 390 427L445 408H516L574 430Q664 471 690 600Z\" fill=\"url(#portraitCoat)\" stroke=\"#526448\" stroke-width=\"3\"/>\n      <path d=\"M390 427l87 111 97-108-55-24h-76Z\" fill=\"#d4c9aa\"/>\n      <path d=\"M445 405v55l34 27 38-30v-57Z\" fill=\"#9b654a\"/>\n      <path d=\"M399 192Q474 139 553 189L548 314Q533 391 478 418Q419 392 398 316Z\" fill=\"url(#portraitSkin)\" stroke=\"#39251d\" stroke-width=\"5\"/>\n\n      <g clip-path=\"url(#portraitFaceClip)\" opacity=\".22\">\n        <rect x=\"390\" y=\"248\" width=\"180\" height=\"8\" fill=\"#9cff00\"/>\n        <rect x=\"370\" y=\"330\" width=\"210\" height=\"5\" fill=\"#c34b29\"/>\n        <rect x=\"431\" y=\"178\" width=\"12\" height=\"250\" fill=\"#d9ff9d\"/>\n      </g>\n\n      <path d=\"M397 233Q397 155 468 142Q542 139 564 198L548 236l-18-47q-53 32-124 25l-8 62Z\" fill=\"#10120f\"/>\n      <path d=\"M407 205q65 6 123-28\" fill=\"none\" stroke=\"#34372f\" stroke-width=\"10\"/>\n      <path d=\"M421 279q24-16 49 0M494 279q25-16 45 0\" fill=\"none\" stroke=\"#35251e\" stroke-width=\"7\"/>\n      <ellipse cx=\"452\" cy=\"283\" rx=\"5\" ry=\"7\" fill=\"#11150e\"/>\n      <ellipse cx=\"520\" cy=\"283\" rx=\"5\" ry=\"7\" fill=\"#11150e\"/>\n      <path d=\"M484 286l-8 49 22 4\" fill=\"none\" stroke=\"#794d38\" stroke-width=\"5\"/>\n      <path d=\"M448 359q34 22 72-2\" fill=\"none\" stroke=\"#4e2c24\" stroke-width=\"6\"/>\n      <path d=\"M418 314q12 68 61 83M540 312q-10 63-58 85\" fill=\"none\" stroke=\"#80503a\" stroke-width=\"2\" opacity=\".7\"/>\n      <path d=\"M445 460l34 27-31 26-30-71M517 457l-38 30 36 27 32-72\" fill=\"#11150f\" stroke=\"#8c321f\" stroke-width=\"3\"/>\n    </g>\n\n    <g opacity=\".9\">\n      <rect x=\"354\" y=\"216\" width=\"88\" height=\"13\" fill=\"#c34b29\"/>\n      <rect x=\"528\" y=\"250\" width=\"83\" height=\"8\" fill=\"#9cff00\"/>\n      <rect x=\"375\" y=\"347\" width=\"70\" height=\"7\" fill=\"#9cff00\"/>\n      <rect x=\"505\" y=\"389\" width=\"118\" height=\"10\" fill=\"#8c321f\"/>\n      <rect x=\"299\" y=\"474\" width=\"135\" height=\"12\" fill=\"#9cff00\" opacity=\".45\"/>\n      <rect x=\"561\" y=\"503\" width=\"102\" height=\"8\" fill=\"#c34b29\"/>\n    </g>\n\n    <g font-family=\"Courier New, monospace\" font-weight=\"700\">\n      <text x=\"44\" y=\"65\" fill=\"#9cff00\" font-size=\"15\" letter-spacing=\"4\">CEREMONIAL NODE</text>\n      <text x=\"916\" y=\"557\" fill=\"#9cff00\" font-size=\"13\" text-anchor=\"end\">LV // VT</text>\n      <text x=\"46\" y=\"558\" fill=\"#a79f89\" font-size=\"12\">STYLIZED FIGURE: VLAD TENEV</text>\n    </g>\n    <path d=\"M0 71h188v5H0M785 527h175v9H785M0 406h115v5H0M846 129h114v6H846\" fill=\"#c34b29\"/>\n  </symbol>\n</svg>\n\n<main class=\"module\" id=\"portraitModule\" aria-labelledby=\"portrait-title\">\n  <header class=\"masthead\">\n    <p class=\"eyebrow\">Landville World Relic // 01</p>\n    <span class=\"signal\" aria-hidden=\"true\">\n      <span class=\"signal-dot\"></span>\n      <span class=\"signal-text\">LOCAL SIGNAL</span>\n    </span>\n  </header>\n\n  <button class=\"portrait-button\" id=\"openPortrait\" type=\"button\" aria-label=\"Enlarge the stylized portrait of Vlad Tenev\" aria-haspopup=\"dialog\" aria-controls=\"portraitModal\">\n    <svg class=\"portrait-art\" viewBox=\"0 0 960 600\" aria-hidden=\"true\" focusable=\"false\" xmlns=\"http://www.w3.org/2000/svg\">\n      <use href=\"#portraitArtwork\"/>\n    </svg>\n    <span class=\"scanlines\" aria-hidden=\"true\"></span>\n  </button>\n\n  <section class=\"caption\" aria-label=\"Portrait identification\">\n    <div>\n      <h1 id=\"portrait-title\">Vlad Tenev</h1>\n      <p class=\"subtitle\">Glitch envoy // ceremonial market apparition</p>\n    </div>\n    <div class=\"seal\" aria-hidden=\"true\">LV<br>WORLD</div>\n  </section>\n</main>\n\n<div class=\"modal\" id=\"portraitModal\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"modal-title\" aria-describedby=\"modal-description\" hidden>\n  <div class=\"modal-panel\">\n    <h2 class=\"visually-hidden\" id=\"modal-title\">Enlarged portrait of Vlad Tenev</h2>\n    <p class=\"visually-hidden\" id=\"modal-description\">A larger view of the glitchy ceremonial portrait. Press Escape or use the close button to return.</p>\n    <button class=\"close\" id=\"closePortrait\" type=\"button\" aria-label=\"Close enlarged portrait\">×</button>\n    <svg class=\"modal-art\" viewBox=\"0 0 960 600\" role=\"img\" aria-labelledby=\"modal-art-title modal-art-description\" xmlns=\"http://www.w3.org/2000/svg\">\n      <title id=\"modal-art-title\">Glitchy ceremonial portrait of Vlad Tenev</title>\n      <desc id=\"modal-art-description\">A stylized dark-haired figure framed by neon-green circuitry, rust-colored monuments, scan-line artifacts, and a ceremonial ring.</desc>\n      <use href=\"#portraitArtwork\"/>\n    </svg>\n  </div>\n</div>\n\n<script>\n(() => {\n  'use strict';\n\n  const module = document.getElementById('portraitModule');\n  const openButton = document.getElementById('openPortrait');\n  const modal = document.getElementById('portraitModal');\n  const closeButton = document.getElementById('closePortrait');\n  let previousFocus = null;\n\n  function openPortrait() {\n    previousFocus = document.activeElement;\n    modal.hidden = false;\n    module.inert = true;\n    document.body.style.overflow = 'hidden';\n    closeButton.focus();\n  }\n\n  function closePortrait() {\n    modal.hidden = true;\n    module.inert = false;\n    document.body.style.overflow = '';\n    if (previousFocus && typeof previousFocus.focus === 'function') {\n      previousFocus.focus();\n    }\n  }\n\n  openButton.addEventListener('click', openPortrait);\n  closeButton.addEventListener('click', closePortrait);\n\n  modal.addEventListener('click', (event) => {\n    if (event.target === modal) closePortrait();\n  });\n\n  document.addEventListener('keydown', (event) => {\n    if (modal.hidden) return;\n\n    if (event.key === 'Escape') {\n      event.preventDefault();\n      closePortrait();\n    } else if (event.key === 'Tab') {\n      event.preventDefault();\n      closeButton.focus();\n    }\n  });\n})();\n</script>\n</body>\n</html>",
  "acceptance": [
    "A LANDVILLE-style glitchy portrait of Vlad Tenev is clearly visible.",
    "Clicking the portrait opens a larger view.",
    "The enlarged portrait can be closed and returns to its initial state.",
    "The module works on desktop and mobile without external APIs or links."
  ]
}

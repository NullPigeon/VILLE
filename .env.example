# Public site origin used for absolute social metadata.
NEXT_PUBLIC_SITE_URL=https://your-landville-domain.vercel.app

# Use provider URLs with API keys in production. Robinhood public RPCs are rate-limited.
NEXT_PUBLIC_ROBINHOOD_MAINNET_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/YOUR_KEY

# Server-only Mayor Scrapy AI. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Public site origin used for absolute social metadata.
NEXT_PUBLIC_SITE_URL=https://your-landville-domain.vercel.app

# Wallet network: Robinhood mainnet, chain 4663. Public RPC is rate-limited.
# NEXT_PUBLIC_ values are visible in the browser; never put a secret provider key here.
NEXT_PUBLIC_ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Server-only Mayor Scrapy AI. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Wallet identity. Generate a long random value for production.
WALLET_SESSION_SECRET=

# The official SCRAPY address is pinned in source. Use a dedicated server-only mainnet RPC in production.
ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Public treasury address shown in the read-only treasury view.
NEXT_PUBLIC_TREASURY_ADDRESS=

# Shared citizens, chats, proposals, votes and World state. Both values are server-only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=
# Legacy projects may use a JWT service-role key instead.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated wallet addresses allowed to operate the sequential build queue.
LANDVILLE_ADMIN_WALLETS=

# Build coordinator in Vercel (disabled until its credentials and migration 004 are ready).
LANDVILLE_BUILDER_ENABLED=false
LANDVILLE_WORKER_SECRET=
# One operator wallet already present in LANDVILLE_ADMIN_WALLETS.
LANDVILLE_BUILD_ACTOR=
# Read-only GitHub token: this repo's Contents, Pull requests and Checks.
LANDVILLE_GITHUB_READ_TOKEN=
# Server-only Vercel release verification. Use the narrowest supported team/project access.
LANDVILLE_VERCEL_READ_TOKEN=
LANDVILLE_VERCEL_PROJECT_ID=
LANDVILLE_VERCEL_TEAM_ID=

# Worker-only configuration belongs in GitHub Actions, NOT in Vercel or browser code.
# See docs/build-executor.md for variables/secrets and activation steps.
# LANDVILLE_SITE_URL=https://your-production-domain
# LANDVILLE_BUILDER_MODEL=<model enabled for your API project>
# LANDVILLE_GITHUB_WRITE_TOKEN=<repo-only Contents + Pull requests write>
# OPENAI_API_KEY=<dedicated builder key with a spending limit>

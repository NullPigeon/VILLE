# Public site origin used for absolute social metadata.
NEXT_PUBLIC_SITE_URL=https://your-landville-domain.vercel.app

# Use provider URLs with API keys in production. Robinhood public RPCs are rate-limited.
NEXT_PUBLIC_ROBINHOOD_MAINNET_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/YOUR_KEY

# Server-only Mayor Scrapy AI. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Wallet identity. Generate a long random value for production.
WALLET_SESSION_SECRET=

# SCRAPY governance token on Robinhood Chain Testnet.
# Required for balance snapshots and vote power.
SCRAPY_TOKEN_ADDRESS=
ROBINHOOD_TESTNET_RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/YOUR_KEY

# Public treasury address shown in the read-only treasury view.
NEXT_PUBLIC_TREASURY_ADDRESS=

# Shared Town Chat persistence. Service-role remains server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin used for absolute social metadata.
NEXT_PUBLIC_SITE_URL=https://your-landville-domain.vercel.app

# Wallet network: Robinhood mainnet, chain 4663. Public RPC is rate-limited.
# NEXT_PUBLIC_ values are visible in the browser; never put a secret provider key here.
NEXT_PUBLIC_ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Server-only Mayor Scrapy AI. Never prefix this key with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Wallet identity. Generate a long random value for production.
WALLET_SESSION_SECRET=

# SCRAPY ERC-20 contract deployed on Robinhood MAINNET (4663), not a testnet address.
# Required for voting/build snapshots, NOT for wallet sign-in or Town Chat.
SCRAPY_TOKEN_ADDRESS=
# Server-only provider endpoint. Use a dedicated mainnet provider URL for production.
ROBINHOOD_MAINNET_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Public treasury address shown in the read-only treasury view.
NEXT_PUBLIC_TREASURY_ADDRESS=

# Shared Town Chat persistence. Service-role remains server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
